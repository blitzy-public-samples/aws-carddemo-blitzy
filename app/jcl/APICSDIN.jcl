//*********************************************************************
//*  Define and install the CardDemo REST/JSON API CICS resources.
//*  CSD source: app/csd/CARDDEMOAPI.CSD (GROUP CDEMOAPI).
//*  DEFGRP  : DFHCSDUP DEFINEs the CDEMOAPI group into the CSD.
//*  INSTALL : CEDA INSTALL GROUP(CDEMOAPI) activates it online.
//*  Modeled on app/jcl/CBADMCDJ.jcl. Additive / read-only.
//*********************************************************************
//   SET HLQ=AWS.M2.CARDDEMO
//*********************************************************************
//*  STEP 1 - DFHCSDUP: DEFINE the CDEMOAPI group into the CSD
//*********************************************************************
//DEFGRP  EXEC PGM=DFHCSDUP,REGION=0M,
//         PARM='CSD(READWRITE),PAGESIZE(60),NOCOMPAT'
//STEPLIB  DD DSN=OEM.CICSTS.V05R06M0.CICS.SDFHLOAD,DISP=SHR
//DFHCSD   DD UNIT=SYSDA,DISP=SHR,DSN=OEM.CICSTS.DFHCSD
//OUTDD    DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *,SYMBOLS=JCLONLY
*/********************************************************************/
*/* CARDDEMO REST/JSON API - CICS RESOURCE GROUP CDEMOAPI            */
*/* Base CICS Web Support and read-only VSAM resource references.    */
*/********************************************************************/
* TO RE-RUN CLEANLY, UNCOMMENT THE NEXT LINE TO DROP THE OLD GROUP:
* DELETE GROUP(CDEMOAPI)
 DEFINE TCPIPSERVICE(CDAPISVC) GROUP(CDEMOAPI)
 DESCRIPTION(CARDDEMO REST/JSON API HTTP LISTENER - CWS)
        PORTNUMBER(3001) STATUS(OPEN) PROTOCOL(HTTP)
        TRANSACTION(CWXN) URM(NO) BACKLOG(5)
        IPADDRESS(ANY) SOCKETCLOSE(NO) MAXDATALEN(32)
        SSL(NO) AUTHENTICATE(NO)
 DEFINE URIMAP(CDAPIURI) GROUP(CDEMOAPI)
 DESCRIPTION(INBOUND ROUTE /carddemo/api/v1/* TO COAPIRTR)
        STATUS(ENABLED) USAGE(SERVER) SCHEME(HTTP)
        HOST(*) PATH(/carddemo/api/v1/*)
        TCPIPSERVICE(CDAPISVC) TRANSACTION(CAPI)
        PROGRAM(COAPIRTR) ANALYZER(NO) REDIRECTTYPE(NONE)
 DEFINE TRANSACTION(CAPI) GROUP(CDEMOAPI)
 DESCRIPTION(CARDDEMO REST/JSON API ALIAS TRANSACTION)
        PROGRAM(COAPIRTR) TWASIZE(0) PROFILE(DFHCICST)
        STATUS(ENABLED) TASKDATALOC(ANY) TASKDATAKEY(USER)
        STORAGECLEAR(NO) RUNAWAY(SYSTEM) SHUTDOWN(DISABLED)
        ISOLATE(YES) DYNAMIC(NO) ROUTABLE(NO) PRIORITY(1)
        TRANCLASS(DFHTCL00) DTIMOUT(NO) RESTART(NO) SPURGE(YES)
        TPURGE(YES) DUMP(YES) TRACE(YES) CONFDATA(NO)
        OTSTIMEOUT(NO) ACTION(BACKOUT) WAIT(YES) WAITTIME(0,0,0)
        RESSEC(NO) CMDSEC(NO)
 DEFINE PROGRAM(COAPIRTR) GROUP(CDEMOAPI)
 DESCRIPTION(REST API ROUTER / FRONT DOOR)
        LANGUAGE(COBOL) RELOAD(NO) RESIDENT(NO) USAGE(NORMAL)
        USELPACOPY(NO) STATUS(ENABLED) CEDF(YES) DATALOCATION(ANY)
        EXECKEY(USER) CONCURRENCY(QUASIRENT) API(CICSAPI) DYNAMIC(NO)
        EXECUTIONSET(FULLAPI) JVM(NO)
 DEFINE PROGRAM(COAPISEC) GROUP(CDEMOAPI)
 DESCRIPTION(REST API AUTH / TOKEN SERVICE)
        LANGUAGE(COBOL) RELOAD(NO) RESIDENT(NO) USAGE(NORMAL)
        USELPACOPY(NO) STATUS(ENABLED) CEDF(YES) DATALOCATION(ANY)
        EXECKEY(USER) CONCURRENCY(QUASIRENT) API(CICSAPI) DYNAMIC(NO)
        EXECUTIONSET(FULLAPI) JVM(NO)
 DEFINE PROGRAM(COACSVCC) GROUP(CDEMOAPI)
 DESCRIPTION(REST API ACCOUNT INQUIRY SERVICE)
        LANGUAGE(COBOL) RELOAD(NO) RESIDENT(NO) USAGE(NORMAL)
        USELPACOPY(NO) STATUS(ENABLED) CEDF(YES) DATALOCATION(ANY)
        EXECKEY(USER) CONCURRENCY(QUASIRENT) API(CICSAPI) DYNAMIC(NO)
        EXECUTIONSET(FULLAPI) JVM(NO)
 DEFINE PROGRAM(COCUSVCC) GROUP(CDEMOAPI)
 DESCRIPTION(REST API CUSTOMER INQUIRY SERVICE)
        LANGUAGE(COBOL) RELOAD(NO) RESIDENT(NO) USAGE(NORMAL)
        USELPACOPY(NO) STATUS(ENABLED) CEDF(YES) DATALOCATION(ANY)
        EXECKEY(USER) CONCURRENCY(QUASIRENT) API(CICSAPI) DYNAMIC(NO)
        EXECUTIONSET(FULLAPI) JVM(NO)
 DEFINE PROGRAM(COCRSVCC) GROUP(CDEMOAPI)
 DESCRIPTION(REST API CARD INQUIRY SERVICE)
        LANGUAGE(COBOL) RELOAD(NO) RESIDENT(NO) USAGE(NORMAL)
        USELPACOPY(NO) STATUS(ENABLED) CEDF(YES) DATALOCATION(ANY)
        EXECKEY(USER) CONCURRENCY(QUASIRENT) API(CICSAPI) DYNAMIC(NO)
        EXECUTIONSET(FULLAPI) JVM(NO)
 DEFINE PROGRAM(COXRSVCC) GROUP(CDEMOAPI)
 DESCRIPTION(REST API CARD XREF SERVICE)
        LANGUAGE(COBOL) RELOAD(NO) RESIDENT(NO) USAGE(NORMAL)
        USELPACOPY(NO) STATUS(ENABLED) CEDF(YES) DATALOCATION(ANY)
        EXECKEY(USER) CONCURRENCY(QUASIRENT) API(CICSAPI) DYNAMIC(NO)
        EXECUTIONSET(FULLAPI) JVM(NO)
 DEFINE PROGRAM(COTRSVCC) GROUP(CDEMOAPI)
 DESCRIPTION(REST API TRANSACTION SERVICE)
        LANGUAGE(COBOL) RELOAD(NO) RESIDENT(NO) USAGE(NORMAL)
        USELPACOPY(NO) STATUS(ENABLED) CEDF(YES) DATALOCATION(ANY)
        EXECKEY(USER) CONCURRENCY(QUASIRENT) API(CICSAPI) DYNAMIC(NO)
        EXECUTIONSET(FULLAPI) JVM(NO)
 DEFINE PROGRAM(COJSONUC) GROUP(CDEMOAPI)
 DESCRIPTION(REST API JSON SERIALIZER SUBPROGRAM)
        LANGUAGE(COBOL) RELOAD(NO) RESIDENT(NO) USAGE(NORMAL)
        USELPACOPY(NO) STATUS(ENABLED) CEDF(YES) DATALOCATION(ANY)
        EXECKEY(USER) CONCURRENCY(QUASIRENT) API(CICSAPI) DYNAMIC(NO)
        EXECUTIONSET(FULLAPI) JVM(NO)
 DEFINE FILE(ACCTDAT) GROUP(CDEMOAPI)
 DESCRIPTION(API READ-ONLY REF - ACCOUNT MASTER)
        DSNAME(AWS.M2.CARDDEMO.ACCTDATA.VSAM.KSDS) RLSACCESS(NO)
        LSRPOOLNUM(1) READINTEG(UNCOMMITTED) DSNSHARING(ALLREQS)
        STRINGS(1) STATUS(ENABLED) OPENTIME(FIRSTREF)
        DISPOSITION(SHARE) DATABUFFERS(2) INDEXBUFFERS(1) TABLE(NO)
        MAXNUMRECS(NOLIMIT) UPDATEMODEL(LOCKING) LOAD(NO)
        RECORDFORMAT(V) ADD(NO) BROWSE(YES) DELETE(NO) READ(YES)
        UPDATE(NO) JOURNAL(NO) RECOVERY(NONE) BACKUPTYPE(STATIC)
 DEFINE FILE(CARDAIX) GROUP(CDEMOAPI)
 DESCRIPTION(API READ-ONLY REF - CARD AIX BY ACCOUNT)
        DSNAME(AWS.M2.CARDDEMO.CARDDATA.VSAM.AIX.PATH) RLSACCESS(NO)
        LSRPOOLNUM(1) READINTEG(UNCOMMITTED) DSNSHARING(ALLREQS)
        STRINGS(1) STATUS(ENABLED) OPENTIME(FIRSTREF)
        DISPOSITION(SHARE) DATABUFFERS(2) INDEXBUFFERS(1) TABLE(NO)
        MAXNUMRECS(NOLIMIT) UPDATEMODEL(LOCKING) LOAD(NO)
        RECORDFORMAT(V) ADD(NO) BROWSE(YES) DELETE(NO) READ(YES)
        UPDATE(NO) JOURNAL(NO) RECOVERY(NONE) BACKUPTYPE(STATIC)
 DEFINE FILE(CARDDAT) GROUP(CDEMOAPI)
 DESCRIPTION(API READ-ONLY REF - CARD MASTER)
        DSNAME(AWS.M2.CARDDEMO.CARDDATA.VSAM.KSDS) RLSACCESS(NO)
        LSRPOOLNUM(1) READINTEG(UNCOMMITTED) DSNSHARING(ALLREQS)
        STRINGS(1) STATUS(ENABLED) OPENTIME(FIRSTREF)
        DISPOSITION(SHARE) DATABUFFERS(2) INDEXBUFFERS(1) TABLE(NO)
        MAXNUMRECS(NOLIMIT) UPDATEMODEL(LOCKING) LOAD(NO)
        RECORDFORMAT(V) ADD(NO) BROWSE(YES) DELETE(NO) READ(YES)
        UPDATE(NO) JOURNAL(NO) RECOVERY(NONE) BACKUPTYPE(STATIC)
 DEFINE FILE(CCXREF) GROUP(CDEMOAPI)
 DESCRIPTION(API READ-ONLY REF - CARD-ACCOUNT XREF)
        DSNAME(AWS.M2.CARDDEMO.CARDXREF.VSAM.KSDS) RLSACCESS(NO)
        LSRPOOLNUM(1) READINTEG(UNCOMMITTED) DSNSHARING(ALLREQS)
        STRINGS(1) STATUS(ENABLED) OPENTIME(FIRSTREF)
        DISPOSITION(SHARE) DATABUFFERS(2) INDEXBUFFERS(1) TABLE(NO)
        MAXNUMRECS(NOLIMIT) UPDATEMODEL(LOCKING) LOAD(NO)
        RECORDFORMAT(V) ADD(NO) BROWSE(YES) DELETE(NO) READ(YES)
        UPDATE(NO) JOURNAL(NO) RECOVERY(NONE) BACKUPTYPE(STATIC)
 DEFINE FILE(CUSTDAT) GROUP(CDEMOAPI)
 DESCRIPTION(API READ-ONLY REF - CUSTOMER MASTER)
        DSNAME(AWS.M2.CARDDEMO.CUSTDATA.VSAM.KSDS) RLSACCESS(NO)
        LSRPOOLNUM(1) READINTEG(UNCOMMITTED) DSNSHARING(ALLREQS)
        STRINGS(1) STATUS(ENABLED) OPENTIME(FIRSTREF)
        DISPOSITION(SHARE) DATABUFFERS(2) INDEXBUFFERS(1) TABLE(NO)
        MAXNUMRECS(NOLIMIT) UPDATEMODEL(LOCKING) LOAD(NO)
        RECORDFORMAT(V) ADD(NO) BROWSE(YES) DELETE(NO) READ(YES)
        UPDATE(NO) JOURNAL(NO) RECOVERY(NONE) BACKUPTYPE(STATIC)
 DEFINE FILE(CXACAIX) GROUP(CDEMOAPI)
 DESCRIPTION(API READ-ONLY REF - XREF AIX BY ACCOUNT)
        DSNAME(AWS.M2.CARDDEMO.CARDXREF.VSAM.AIX.PATH) RLSACCESS(NO)
        LSRPOOLNUM(1) READINTEG(UNCOMMITTED) DSNSHARING(ALLREQS)
        STRINGS(1) STATUS(ENABLED) OPENTIME(FIRSTREF)
        DISPOSITION(SHARE) DATABUFFERS(2) INDEXBUFFERS(1) TABLE(NO)
        MAXNUMRECS(NOLIMIT) UPDATEMODEL(LOCKING) LOAD(NO)
        RECORDFORMAT(V) ADD(NO) BROWSE(YES) DELETE(NO) READ(YES)
        UPDATE(NO) JOURNAL(NO) RECOVERY(NONE) BACKUPTYPE(STATIC)
 DEFINE FILE(TRANSACT) GROUP(CDEMOAPI)
 DESCRIPTION(API READ-ONLY REF - TRANSACTION MASTER)
        DSNAME(AWS.M2.CARDDEMO.TRANSACT.VSAM.KSDS) RLSACCESS(NO)
        LSRPOOLNUM(1) READINTEG(UNCOMMITTED) DSNSHARING(ALLREQS)
        STRINGS(1) STATUS(ENABLED) OPENTIME(FIRSTREF)
        DISPOSITION(SHARE) DATABUFFERS(2) INDEXBUFFERS(1) TABLE(NO)
        MAXNUMRECS(NOLIMIT) UPDATEMODEL(LOCKING) LOAD(NO)
        RECORDFORMAT(V) ADD(NO) BROWSE(YES) DELETE(NO) READ(YES)
        UPDATE(NO) JOURNAL(NO) RECOVERY(NONE) BACKUPTYPE(STATIC)
 DEFINE FILE(USRSEC) GROUP(CDEMOAPI)
 DESCRIPTION(API READ-ONLY REF - SECURITY USER)
        DSNAME(AWS.M2.CARDDEMO.USRSEC.VSAM.KSDS) RLSACCESS(NO)
        LSRPOOLNUM(1) READINTEG(UNCOMMITTED) DSNSHARING(ALLREQS)
        STRINGS(1) STATUS(ENABLED) OPENTIME(FIRSTREF)
        DISPOSITION(SHARE) DATABUFFERS(2) INDEXBUFFERS(1) TABLE(NO)
        MAXNUMRECS(NOLIMIT) UPDATEMODEL(LOCKING) LOAD(NO)
        RECORDFORMAT(V) ADD(NO) BROWSE(YES) DELETE(NO) READ(YES)
        UPDATE(NO) JOURNAL(NO) RECOVERY(NONE) BACKUPTYPE(STATIC)
 LIST GROUP(CDEMOAPI)
/*
//*********************************************************************
//*  STEP 2 - CEDA INSTALL the group into the running region.
//*  DFHCSDUP has no INSTALL verb, so activate via SDSF batch /MODIFY.
//*  Alternative: add CDEMOAPI to GRPLIST for the next CICS startup.
//*********************************************************************
//INSTALL EXEC PGM=SDSF,COND=(4,LT)
//ISFOUT DD SYSOUT=*
//CMDOUT DD SYSOUT=*
//ISFIN  DD *
 /MODIFY CICSAWSA,'CEDA INSTALL GROUP(CDEMOAPI)'
/*
