<?xml version="1.0" encoding="UTF-8"?>
<!-- Rationale for every version, exclusion, and deviation: card-platform/docs/decision-log.md -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- The parent supplies the group identifier, the version, dependency management,
       and plugin management. The path climbs two directory levels: libs/ holds no
       pom.xml of its own. -->
  <parent>
    <groupId>com.carddemo</groupId>
    <artifactId>card-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>cobol-compat</artifactId>
  <packaging>jar</packaging>

  <name>CardDemo COBOL Compatibility Library</name>
  <description>
    Shared helpers that reproduce the arithmetic, parsing, and validation rules of the
    CardDemo COBOL programs. Holds fixed-point decimal helpers, Picture-clause scale
    constants, a tolerant numeric parser, a date validator, and a Primary Account Number
    masker. Also holds three United States reference lists read from CSLKPCDY.cpy:
    telephone area codes, state codes, and state-plus-zip-prefix combinations. Every
    arithmetic helper truncates toward zero. All six services and the equivalence tests
    read these rules from here.
  </description>

  <!-- Language level. The framework parent defaults the compiler release to 17; these
       two properties set 25. Character encoding comes from the parent. -->
  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <!-- Test framework only. The compile classpath carries nothing beyond the Java
       Development Kit. The version comes from the dependency bill of materials the
       parent imports, which resolves junit-jupiter to 6.0.3. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
