# syntax=docker/dockerfile:1
# =============================================================================
# observability/Dockerfile.grafana
#
# CardDemo Grafana image: the upstream image with the two bundled datasource
# plugins this stack does not use removed.
#
# Why this image exists
# ---------------------
# A vulnerability scan of grafana/grafana reports its fixable HIGH findings
# against three files, and twelve of the fourteen are inside plugin binaries
# CardDemo never loads:
#   * data/plugins-bundled/zipkin/gpx_grafana-zipkin-datasource_linux_amd64   (9)
#   * data/plugins-bundled/elasticsearch/gpx_..._datasource_linux_amd64       (3)
# The dashboards in observability/grafana-dashboard.json query the Prometheus
# datasource, and traces are explored through the Jaeger datasource; both are
# CORE datasources compiled into the server, not bundled plugins. Deleting the two
# plugin directories therefore removes the findings without removing a capability
# this deployment has.
#
# The remaining two findings live in the server binary itself
# (data/plugins-bundled is gone but bin/grafana links a vulnerable
# github.com/grafana/tempo revision). No published Grafana image is free of them -
# 13.1.2, 13.1.3 and :latest were all scanned - so they are risk-accepted in
# .trivyignore with the exposure analysis and the remediation trigger recorded
# there and in docs/decision-log.md, rather than being hidden.
# =============================================================================

# Digest-pinned, and the newest published release (13.1.3).
FROM grafana/grafana:13.1.3@sha256:ab5cb380e3ff3172d6c8bd2e7cfd31cce977d2881b260e1f5bc089bf0b759b43

# The upstream image runs as uid 472; the delete needs root, and the runtime user
# is restored immediately afterwards.
USER root
RUN set -eux; \
    rm -rf /usr/share/grafana/data/plugins-bundled/zipkin \
           /usr/share/grafana/data/plugins-bundled/elasticsearch; \
    ! test -e /usr/share/grafana/data/plugins-bundled/zipkin; \
    ! test -e /usr/share/grafana/data/plugins-bundled/elasticsearch
USER 472

ARG CARDDEMO_IMAGE_VERSION=1.0.0
ARG CARDDEMO_IMAGE_REVISION=unspecified
ARG CARDDEMO_IMAGE_CREATED=unspecified
LABEL org.opencontainers.image.title="carddemo-grafana" \
      org.opencontainers.image.description="CardDemo Grafana image with unused bundled datasource plugins removed" \
      org.opencontainers.image.vendor="CardDemo" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${CARDDEMO_IMAGE_VERSION}" \
      org.opencontainers.image.revision="${CARDDEMO_IMAGE_REVISION}" \
      org.opencontainers.image.created="${CARDDEMO_IMAGE_CREATED}" \
      org.opencontainers.image.source="https://github.com/aws-samples/aws-mainframe-modernization-carddemo" \
      org.opencontainers.image.base.name="grafana/grafana:13.1.3" \
      org.opencontainers.image.base.digest="sha256:ab5cb380e3ff3172d6c8bd2e7cfd31cce977d2881b260e1f5bc089bf0b759b43"
