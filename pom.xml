<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent supplies dependency and plugin management for the whole build. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.carddemo</groupId>
    <artifactId>carddemo-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>CardDemo Modernization Parent</name>
    <description>Aggregator and parent BOM for the modernized AWS CardDemo application: a multi-module Spring Boot microservices build migrated from the legacy IBM z/OS COBOL/CICS/VSAM stack to Java 21 and PostgreSQL.</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--
          Spring Cloud release-train version consumed exclusively by the
          api-gateway module, which imports the spring-cloud-dependencies BOM
          in its OWN POM. The BOM is intentionally NOT imported here so that
          Spring Cloud managed versions do not leak into the other services
          (see docs/decision-log.md, "Platform & Build").
        -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <!--
          Security override: pin patched versions of two libraries managed by
          the Spring Boot 4.1.0 BOM to remediate known, fixed CVEs. The Boot
          BOM otherwise resolves pgJDBC 42.7.11 and Tomcat 11.0.22. These
          property names are the exact keys the Spring Boot dependency
          management uses, so setting them here upgrades every module that
          pulls the driver or the embedded container.
        -->
        <postgresql.version>42.7.13</postgresql.version>
        <tomcat.version>11.0.24</tomcat.version>
    </properties>

    <modules>
        <module>carddemo-common</module>
        <module>auth-service</module>
        <module>user-service</module>
        <module>account-service</module>
        <module>card-service</module>
        <module>transaction-service</module>
        <module>billpay-service</module>
        <module>reporting-service</module>
        <module>batch-service</module>
        <module>api-gateway</module>
    </modules>

    <!--
      NOTE: The Spring Cloud BOM (spring-cloud-dependencies) is deliberately
      NOT imported in this parent's <dependencyManagement>. It is imported
      only by the api-gateway module (the sole consumer of Spring Cloud
      Gateway), using the inherited ${spring-cloud.version} property. Importing
      it globally here would leak Spring Cloud managed versions into every
      service and contradicts the approved gateway-only scoping recorded in
      docs/decision-log.md. All other managed versions come from the inherited
      Spring Boot parent BOM.
    -->

    <build>
        <pluginManagement>
            <plugins>
                <!-- Version inherited from the Spring Boot parent; service modules bind the repackage goal in their own POMs. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>

                <!--
                  A deterministic, NON-PRODUCTION AES-256 key is supplied to every forked test JVM
                  (unit and integration) so the carddemo-common PII key validation, which now runs
                  EAGERLY at context startup for any service that declares a DataSource, is
                  satisfiable in tests. Production and deployed environments MUST still supply the
                  real key through the CARDDEMO_PII_KEY environment variable (docker-compose.yml and
                  k8s/secret.yaml do); a service started without it fails fast rather than reporting
                  UP and then failing every request that touches an encrypted column. The value
                  below is an obviously-fake fixture ("carddemo-test-pii-key-32bytes!!!") used only
                  by the test phases - see docs/decision-log.md. Plugin versions are inherited from
                  the Spring Boot parent BOM.
                  A deterministic, NON-PRODUCTION AES-256 key is supplied to every forked
                  test JVM so the carddemo-common CryptoConverter can initialize and
                  round-trip the encrypted PII columns (customer SSN, government-issued id,
                  EFT account id, card CVV) wherever a test boots a context that reads
                  them. CryptoConverter and the startup PII-encryption pass both fail fast
                  when no key is configured, so a production deployment MUST still provide
                  the real key through the CARDDEMO_PII_KEY environment variable (see
                  docs/decision-log.md). This value is an obviously-fake, test-only fixture
                  and is never used outside the test phases. Declared here for surefire AND
                  failsafe so unit tests and Testcontainers integration tests behave
                  identically; a module that declares its own systemPropertyVariables must
                  repeat it. Plugin versions are inherited from the Spring Boot parent.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <carddemo.pii.key>Y2FyZGRlbW8tdGVzdC1waWkta2V5LTMyYnl0ZXMhISE=</carddemo.pii.key>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <carddemo.pii.key>Y2FyZGRlbW8tdGVzdC1waWkta2V5LTMyYnl0ZXMhISE=</carddemo.pii.key>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              Integration-test execution is a BUILD-WIDE guarantee, not a per-module
              opt-in. The Spring Boot parent's pluginManagement already binds the
              maven-failsafe-plugin integration-test and verify goals (and points the
              plugin at the module's own output directory), so declaring the plugin
              once here activates it for every module: any class matching Failsafe's
              default patterns (**/IT*.java, **/*IT.java, **/*ITCase.java) runs during
              `mvn verify` in whichever module it lives. Surefire keeps the fast
              unit-test phase and never re-runs an IT, so each integration test executes
              exactly once per build. Version and executions are inherited; modules that
              need extra Failsafe configuration (for example a forked-JVM system
              property) refine it in their own POM.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
