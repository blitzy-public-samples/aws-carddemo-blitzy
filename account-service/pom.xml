<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.aws.carddemo</groupId>
    <artifactId>account-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>account-service</name>
    <description>CardDemo Account Management microservice (Feature F-003) - account inquiry and update</description>

    <properties>
        <java.version>17</java.version>
        <springdoc.version>2.8.17</springdoc.version>

        <!--
          Security dependency overrides (centrally managed).
          These properties override the versions the spring-boot-starter-parent:3.5.16
          BOM would otherwise resolve, pinning each affected library to a fixed-or-newer
          release that remediates known published vulnerabilities. They are parent-
          compatible patch/minor bumps within the same line, so they do not change any
          API used by the module. Reviewed and bumped as a set; revisit on each Boot/BOM
          upgrade so the overrides never silently mask a newer managed fix.
            * tomcat.version        10.1.55 -> 10.1.57  (embedded Tomcat, via spring-boot-starter-web)
            * jackson-bom.version   2.21.4  -> 2.21.5   (whole Jackson BOM incl. jackson-databind)
            * postgresql.version    42.7.11 -> 42.7.12  (pgJDBC driver)
            * commons-lang3.version 3.17.0  -> 3.18.0   (transitive via spring-core/tomcat)
            * logback.version       1.5.36  -> 1.5.38   (logback-core + logback-classic; CVE-2026-13006)
          The test-scope commons-compress override is applied via <dependencyManagement>
          below because it is NOT a spring-boot-starter-parent managed property.
        -->
        <tomcat.version>10.1.57</tomcat.version>
        <jackson-bom.version>2.21.5</jackson-bom.version>
        <postgresql.version>42.7.12</postgresql.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <logback.version>1.5.38</logback.version>
    </properties>

    <!--
      Centrally managed version overrides for transitive dependencies that are NOT
      exposed as spring-boot-starter-parent properties. Declaring them here forces the
      chosen version everywhere they appear in the graph, regardless of scope.

      commons-compress: Testcontainers (test scope) pulls in commons-compress 1.24.0,
      which is affected by CVE-2024-25710 and CVE-2024-26308 (archive-processing
      denial-of-service). Apache fixes these in 1.26.0; we pin 1.27.1 (the current
      stable line, >= the 1.26.0 fix) which remains API-compatible with Testcontainers
      1.21.4's archive handling.

      swagger-ui: springdoc-openapi-starter-webmvc-ui 2.8.17 transitively bundles the
      org.webjars:swagger-ui 5.32.2 front-end, which embeds DOMPurify 3.3.2. That
      DOMPurify build is inside the vulnerable range 3.0.1-3.3.3 (CVE-2026-41238 /
      CVE-2026-41239 / CVE-2026-41240 - prototype-pollution / template-sanitizer
      bypass XSS; CWE-79 / CWE-1321) and is served on the unauthenticated Swagger UI
      surface. We pin swagger-ui 5.32.8 (the first 5.32.x patch that bundles DOMPurify
      >= 3.4.0 - specifically 3.4.11 - remediating all three CVEs). 5.32.8 is the same
      minor line as 2.8.17's default 5.32.2, so it is a drop-in, API-compatible patch
      that keeps springdoc pinned at the AAP-mandated 2.8.17 (§0.5.1: the 2.x line for
      Spring Boot 3.x) while removing the vulnerable component from the runtime jar.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.27.1</version>
            </dependency>
            <dependency>
                <groupId>org.webjars</groupId>
                <artifactId>swagger-ui</artifactId>
                <version>5.32.8</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Surefire runs the FAST tests during `mvn test`: plain unit tests and
              @WebMvcTest slices. It EXCLUDES *IntegrationTest so the Testcontainers-backed
              @SpringBootTest integration test (which requires a Docker daemon) does NOT run
              in the ordinary `test` phase. Surefire's default include (**/*Test.java) would
              otherwise pick up AccountApiIntegrationTest and force every `mvn test` (and
              every `mvn package`) to require Docker. Version is managed by
              spring-boot-starter-parent.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
              Failsafe runs the SLOW integration tests during `mvn verify` (integration-test
              then verify goals). It INCLUDES *IntegrationTest (the AAP-named convention,
              AAP section 0.3.1), which Failsafe's default *IT / IT* / *ITCase patterns do
              NOT match, so `mvn verify` executes the Surefire suite PLUS
              AccountApiIntegrationTest against a real PostgreSQL provisioned by Testcontainers.
              The bound `verify` goal fails the build if any integration test failed. Version
              is managed by spring-boot-starter-parent.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IntegrationTest.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
