<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      ============================================================================================
      AWS CardDemo - Spring Boot 3.2.x modernization of the legacy COBOL/CICS/VSAM mainframe app.
      ============================================================================================
      This is the single-module Maven build manifest (Java 17 LTS) for the net-new Spring Boot
      monolith that re-implements the AWS CardDemo sample application with 100% functional parity.

      Version policy (AAP 0.5.2):
        * Spring-managed artifacts are declared WITHOUT an explicit <version>; the Spring Boot
          starter parent BOM (3.2.12) governs them. This guarantees a consistent, tested stack
          (Hibernate, Jackson, Tomcat, Spring Security 6, Spring Batch 5, Flyway 9.x, H2,
          PostgreSQL driver, JUnit 5, Mockito, AssertJ, etc.).
        * Only dependencies that are NOT Boot-managed carry an explicit version: the JJWT trio
          (0.12.6) and springdoc-openapi (2.6.0).
        * Only the JaCoCo build plugin (0.8.12) is pinned by policy to enforce the >=80% coverage
          gate via `mvn verify`.
        * Three BOM-managed versions are bumped via property overrides for security remediation
          (spring-framework 6.1.21, spring-security 6.3.10, tomcat 10.1.55) - see the detailed
          per-property CVE rationale in the <properties> block below. Spring Boot itself stays on
          3.2.12, so Flyway stays on the 9.x line and the rest of the stack remains BOM-aligned.
        * No placeholder versions (latest, RELEASE, 1.0.0 for deps) are used anywhere.

      The system MUST remain a single monolithic module (AAP 0.2.2 - no microservice split) and
      MUST NOT introduce cloud/MQ/Kafka/Db2 libraries (explicitly out of scope).
      ============================================================================================
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <!-- Empty relativePath forces resolution from the repository, not a local parent. -->
        <relativePath/>
    </parent>

    <groupId>com.carddemo</groupId>
    <artifactId>carddemo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>AWS CardDemo - Spring Boot Modernization</name>
    <description>Spring Boot 3.2.x / Java 17 modernization of the legacy AWS CardDemo COBOL/CICS/VSAM mainframe application</description>

    <properties>
        <!-- Spring Boot parent maps java.version to maven.compiler.release=17. -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versions for artifacts that are NOT managed by the Spring Boot parent BOM. -->
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.6.0</springdoc.version>

        <!-- Build plugin pinned by policy to enforce the coverage gate. -->
        <jacoco.version>0.8.12</jacoco.version>

        <!-- ====================================================================================
             SECURITY-DRIVEN MANAGED-VERSION OVERRIDES (final-checkpoint dependency remediation).

             These three properties override versions that are otherwise governed by the Spring
             Boot 3.2.12 parent BOM. Overriding the BOM's version *properties* (rather than adding
             explicit <version> tags on individual dependencies) is the Spring-Boot-sanctioned
             mechanism for consuming a patched maintenance release while keeping the rest of the
             stack BOM-aligned. Spring Boot itself stays on 3.2.12, so Flyway remains on the 9.x
             line (flyway-core only; the flyway-database-postgresql module is NOT required until
             Flyway 10 / Boot 3.3+) - preserving the AAP 0.5 dependency mandate.

             Each override is the latest OSS patch available on Maven Central for the line that is
             compatible with Spring Boot 3.2.x (verified against repo1.maven.org):

               * spring-framework 6.1.15 -> 6.1.21
                   Fixes CVE-2025-22233 (DataBinder disallowedFields bypass, fixed in 6.1.20) plus
                   CVE-2025-41234. 6.1.21 is the LAST OSS release of the 6.1.x generation and is
                   the maximum patch available for the Framework line Spring Boot 3.2.x builds on.
               * spring-security 6.2.8 -> 6.3.10
                   Fixes CVE-2025-22228 (BCryptPasswordEncoder did not cap password length, fixed
                   in 6.3.8). The OSS 6.2.x line ends at the still-affected 6.2.8 (6.2.9+ are
                   commercial-only), so the smallest OSS upgrade that clears the CVE is the 6.3.x
                   line; 6.3.10 is its latest patch. Spring Security 6.3.x targets Spring Framework
                   6.1.x, so it pairs correctly with the 6.1.21 override above. (6.4.x targets
                   Framework 6.2.x and is therefore intentionally NOT used here.)
               * tomcat 10.1.33 -> 10.1.55
                   Latest secure Apache Tomcat 10.1.x (10.1.54+ addresses the April 2026 advisories
                   CVE-2026-29146 / CVE-2026-34486 / CVE-2026-34500). Same Servlet 6.0 / Jakarta
                   EE 10 spec level as the BOM default, so it is a drop-in patch bump.
             ==================================================================================== -->
        <spring-framework.version>6.1.21</spring-framework.version>
        <spring-security.version>6.3.10</spring-security.version>
        <tomcat.version>10.1.55</tomcat.version>
    </properties>

    <dependencies>
        <!-- ==========================================================================
             Spring Boot starters (BOM-managed - declared WITHOUT an explicit version).
             ========================================================================== -->

        <!-- REST controllers, embedded Tomcat, Jackson JSON (replaces BMS 3270 screens). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Hibernate/JPA persistence (replaces VSAM KSDS access). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
          Authentication/authorization (replaces RACF + CICS COMMAREA session handoff).
          Transitively provides spring-security-crypto for BCrypt (strength 12) password hashing.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Batch 5 chunk-oriented jobs (replaces JCL-scheduled COBOL batch programs). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>

        <!-- Bean Validation (Jakarta) for request/response DTO constraints. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Health and metrics endpoints. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==========================================================================
             Database drivers and schema migration (BOM-managed - no explicit version).
             ========================================================================== -->

        <!-- Production JDBC driver (prod profile -> PostgreSQL 15.x). Runtime only. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- In-memory database for the dev/test profiles. Runtime only. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Flyway schema + seed migrations (V1-V4) executed on startup before JPA validation.
          Spring Boot 3.2.x manages Flyway 9.x, which supports PostgreSQL through flyway-core
          ALONE. The separate flyway-database-postgresql module is only required under Flyway 10
          (Spring Boot 3.3+); adding it here would break under the 9.x line. Declared WITHOUT an
          explicit version so the parent BOM governs it.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- ==========================================================================
             JWT (stateless auth replacing the COMMAREA handoff) - JJWT 0.12.6.
             HS256 with a >=256-bit secret. NOT Boot-managed, so an explicit version is required.
             ========================================================================== -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ==========================================================================
             OpenAPI / Swagger schema documentation - springdoc 2.x (NOT Boot-managed).
             ========================================================================== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ==========================================================================
             Test dependencies (BOM-managed - no explicit version). Test scope only.
             ========================================================================== -->

        <!-- JUnit 5, Mockito 5.x, AssertJ, MockMvc, JSONassert. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- @SpringBatchTest harness for batch job integration tests. -->
        <dependency>
            <groupId>org.springframework.batch</groupId>
            <artifactId>spring-batch-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Security-context test support (@WithMockUser, etc.). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Spring Boot Maven plugin - produces the executable (fat) JAR via the default
              `repackage` goal. BOM-managed, so no explicit version.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              JaCoCo coverage instrumentation. Enforces the >=80% line-coverage gate (AAP 0.7.2)
              during `mvn verify`:
                * prepare-agent - wires the coverage agent before tests run.
                * report        - generates the HTML/XML coverage report after the test phase.
                * check         - fails the build in the verify phase when bundle LINE coverage
                                  drops below 0.80.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <!-- AAP §0.7.2 coverage gate: enforce >=80% for BOTH line
                                             and instruction coverage so `mvn verify` cannot pass with
                                             instruction coverage below the mandated threshold. -->
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
