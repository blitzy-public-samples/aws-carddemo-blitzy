<?xml version="1.0" encoding="UTF-8"?>
<!--
  api-gateway structured-logging configuration (Observability rule, AAP 0.7.5).

  * JSON logging to stdout (Spring Boot built-in StructuredLogEncoder,
    logstash format) under the docker / k8s / prod profiles - one JSON
    object per line, ready for Promtail/Loki/ELK ingestion.
  * Human-readable console logging for local development (no profile).
  * Every line carries the MDC correlation id plus the Micrometer trace
    and span ids. The correlationId MDC key matches
    com.carddemo.common.config.CorrelationIdContext.CORRELATION_ID_KEY.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="api-gateway"/>

    <!-- Structured JSON to stdout (containerized profiles). -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>logstash</format>
            <charset>${CONSOLE_LOG_CHARSET:-UTF-8}</charset>
        </encoder>
    </appender>

    <!-- Human-readable console for local development. Correlation/trace/span
         ids are rendered explicitly from the MDC. -->
    <appender name="TEXT_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>${CONSOLE_LOG_CHARSET:-UTF-8}</charset>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [${appName}] [correlationId=%X{correlationId:-},traceId=%X{traceId:-},spanId=%X{spanId:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <springProfile name="docker,k8s,prod">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!docker &amp; !k8s &amp; !prod">
        <root level="INFO">
            <appender-ref ref="TEXT_CONSOLE"/>
        </root>
    </springProfile>

    <logger name="com.carddemo" level="INFO"/>
</configuration>
