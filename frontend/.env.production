# Production Environment Configuration for CardDemo Frontend
# This file contains environment-specific variables for production deployment
# All variables must be prefixed with VITE_ to be exposed to the React application

# API Base URL - Relative path for production deployment
# Uses relative path to work with Kubernetes ingress routing
# Backend API endpoints will be accessed via reverse proxy at /api
VITE_API_BASE_URL=/api

# Application Name
VITE_APP_NAME=CardDemo

# Environment Identifier
VITE_ENV=production

# Debug Mode - Disabled in production for performance and security
VITE_DEBUG_MODE=false

# Production Optimizations
# The following settings are used by the build process and runtime:
# - Minification: Enabled by default in production builds
# - Source maps: Disabled for security (no .map files generated)
# - Console logs: Filtered (only errors and warnings)
# - React DevTools: Disabled in production builds
