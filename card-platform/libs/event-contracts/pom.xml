<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared module holding the JSON Schema documents the six services read. No service
  declares an event shape of its own.

  src/main/resources/schemas holds one versioned document per event:
    transaction-authorized-v1, transaction-declined-v1, transaction-posted-v1
    and fraud-flagged-v1 for the authorization, ledger and fraud events;
    account-state-changed-v1 and card-state-changed-v1 for the two mutation
    events the supporting services publish.
  Every document is JSON Schema Draft 2020-12, keeps additionalProperties true
  so evolution stays additive, and names the account identifier as the single
  source of the Kafka message key.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The aggregator sits two levels up. libs/ holds no pom.xml of its own. -->
  <parent>
    <groupId>com.carddemo</groupId>
    <artifactId>card-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!-- groupId and version come from the parent. -->
  <artifactId>event-contracts</artifactId>
  <packaging>jar</packaging>

  <name>event-contracts</name>
  <description>Six versioned JSON Schema documents, one per event: four for the authorization, ledger and fraud events, and two for the account and card mutation events. Every document is Draft 2020-12 and keeps additionalProperties true so evolution stays additive.</description>

  <!-- Compiles this module at Java 25. -->
  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <!-- Versions come from the aggregator. Declare none here. -->
  <dependencies>
    <!-- JSON binding. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Validates payloads against JSON Schema Draft 2020-12. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>

    <!-- kafka-clients supplies the Serializer and Deserializer interfaces. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
    </dependency>

    <!-- Runs the event-contract tests under src/test/java/com/carddemo/events. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Assertion and test utility surface. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
