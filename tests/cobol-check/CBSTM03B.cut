      *  '000000001' and LK-M03B-KEY-LN = +9 to drive the production
      *  reference-modification at line 189 to a valid 9-byte slice
      *  matching FD-CUST-ID's PIC X(09) layout.  READ CUST-FILE INTO
      *  LK-M03B-FLDT (line 190) is stripped to CONTINUE.
      *
      *  Source of expected value
      *    '00' -- the MOVE input from this prelude.
      ******************************************************************
       TESTCASE 'CBSTM03B 3000-CUSTFILE-PROC READ-K ok RC 00'
            MOVE 'CUSTFILE'  TO LK-M03B-DD
            MOVE 'K'         TO LK-M03B-OPER
            MOVE '000000001' TO LK-M03B-KEY (1:9)
            MOVE +9          TO LK-M03B-KEY-LN
            MOVE '00'        TO CUSTFILE-STATUS
            PERFORM 0000-START
            EXPECT LK-M03B-RC TO BE '00'

