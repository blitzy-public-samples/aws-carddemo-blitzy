<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The aggregator Project Object Model (POM) sits two directory levels up.
       The services directory holds no POM of its own. -->
  <parent>
    <groupId>com.carddemo</groupId>
    <artifactId>card-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>ledger-posting-service</artifactId>
  <packaging>jar</packaging>

  <name>CardDemo Platform :: Ledger Posting Service</name>
  <description>Spring Boot application module for the CardDemo ledger posting service, whose
    posting arithmetic comes from app/cbl/CBTRN02C.cbl. Declares the web, persistence,
    messaging and observability dependencies the service needs.</description>

  <!-- Java Development Kit (JDK) release level for compilation and packaging. -->
  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <dependencies>

    <!-- Shared platform libraries: the event schemas and the fixed-point decimal
         helpers. -->
    <dependency>
      <groupId>com.carddemo</groupId>
      <artifactId>event-contracts</artifactId>
    </dependency>
    <dependency>
      <groupId>com.carddemo</groupId>
      <artifactId>cobol-compat</artifactId>
    </dependency>
    <!-- The com.carddemo list ends there. The enforcer fails the build on a
         dependency from one service module onto another. -->

    <!-- Every dependency below takes its version from the aggregator's bill of
         materials (BOM). Declare none here. -->

    <!-- Representational State Transfer (REST) surface and bean constraints. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Persistence and schema migration for the private ledger schema. The two
         starters carry the auto-configuration; flyway-core alone carries none. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Messaging. The starter carries the auto-configuration; spring-kafka
         carries the listener container and the producer template. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- Observability. Actuator exposes health and metrics, and the Prometheus
         registry publishes them. Structured log output comes from the Spring Boot
         logging starter through the logging.structured.format.console property in
         application.yml. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Request authentication and authorization. config/SecurityConfig declares two
         filter chains: one over the actuator surface, leaving health open for a probe
         and requiring ROLE_MONITORING for metrics and the Prometheus scrape, and one
         over the API, denying by default and scoping each route to the identity that
         owns the identifier it names. The starter also installs the response headers
         that keep a financial or personal-data answer out of every cache, and the
         delegating password encoder that reads the algorithm prefix of a configured
         password, so no plaintext password is stored or compared. The version comes
         from the Spring Boot bill of materials imported by the parent. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Test scope. Testcontainers 2.x module artifact identifiers carry a
         testcontainers- prefix. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <!-- The repackage goal builds the executable Java archive (JAR) that the
           Dockerfile copies. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
