<?xml version="1.0" encoding="UTF-8"?>
<!-- Module descriptor for card-service, whose behaviour comes from COCRDLIC,
     COCRDSLC and COCRDUPC. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The parent sits two levels up. The services directory holds no POM of its own. -->
  <parent>
    <groupId>com.carddemo</groupId>
    <artifactId>card-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!-- groupId and version come from the parent. -->
  <artifactId>card-service</artifactId>
  <packaging>jar</packaging>

  <name>card-service</name>
  <description>
    Card list, card detail and card update over Representational State Transfer
    (REST). Publishes one CardUpdated event on mutation, against the shared
    versioned contract card-updated-v1.json that com.carddemo:event-contracts
    ships, and checks the event type against its topic, the account identity
    against the message key, and the payload against that contract before the
    event reaches the broker. Consumes no event.
  </description>

  <properties>
    <!-- Language level. The Spring Boot parent defaults maven.compiler.release
         to 17, and a module that omits this property compiles at release 17. -->
    <java.version>25</java.version>
  </properties>

  <dependencies>

    <!-- Platform libraries. This module depends on these two and on no other
         module under services. Versions come from the aggregator. -->
    <dependency>
      <groupId>com.carddemo</groupId>
      <artifactId>event-contracts</artifactId>
    </dependency>
    <dependency>
      <groupId>com.carddemo</groupId>
      <artifactId>cobol-compat</artifactId>
    </dependency>

    <!-- Web surface, plus the bean constraints translated from the validation
         paragraphs of COCRDUPC. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Persistence. Flyway owns every schema object and JPA validates
         against it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Registers the Flyway auto-configuration, which runs the migrations at
         startup. Spring Boot 4 splits auto-configuration into one module per
         technology, so flyway-core below registers none of its own. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Dialect module. The current Flyway line ships PostgreSQL support separately. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Messaging. Producer for the CardUpdated event published on a card update.
         Registers the Kafka auto-configuration, which supplies the KafkaTemplate
         bean and binds every spring.kafka property. The spring-kafka artifact
         below registers none of its own. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <!-- KafkaEventPublisher reads the envelope of an already-serialized payload,
         so this artifact is declared here rather than reached through
         event-contracts. The aggregator supplies its version. Schema validation
         runs through com.carddemo.events.serde.EventContracts, which
         event-contracts owns, so no validator artifact is declared here. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Observability. Health and metrics endpoints, counters and timers. Log
         output in JavaScript Object Notation comes from the Spring Boot logging
         starter through the logging.structured.format.console property in
         application.yml. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Request authentication and authorization. config/SecurityConfig declares two
         filter chains: one over the actuator surface, leaving health open for a probe
         and requiring ROLE_MONITORING for metrics and the Prometheus scrape, and one
         over the API, denying by default and scoping each route to the identity that
         owns the identifier it names. The starter also installs the response headers
         that keep a financial or personal-data answer out of every cache, and the
         delegating password encoder that reads the algorithm prefix of a configured
         password, so no plaintext password is stored or compared. The version comes
         from the Spring Boot bill of materials imported by the parent. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Test scope. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers 2.x artifact identifiers carry a testcontainers- prefix,
         and the three declarations below use it. At 2.0.5 the un-prefixed
         postgresql, kafka and junit-jupiter identifiers do not exist. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Waits for an asynchronous publish to land in a consumer test. -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <!-- Executable-archive packaging. The aggregator pins the version. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Runs the container-backed repository checks in src/test/java named *IT. Surefire selects
           *Test and leaves those alone, so without this declaration CardRepositoryIT is compiled and
           never executed. The parent supplies the version, the execution and the classesDirectory in
           pluginManagement; a module activates it by naming it here, which is how
           fraud-detection-service and equivalence-tests activate the same plugin. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
