<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Inherits dependency and plugin management from the root parent BOM. -->
    <parent>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>carddemo-common</artifactId>
    <packaging>jar</packaging>

    <name>CardDemo Common</name>
    <description>Shared library for the modernized CardDemo application: JPA domain entities, DTOs,
        date utility, message/lookup constants, and cross-cutting observability and exception types
        consumed by every CardDemo microservice and the API gateway.</description>

    <!--
      Dependency-scope policy (see docs/decision-log.md, "Platform & Build").

      carddemo-common is a SHARED CONTRACT / DOMAIN library, not an executable
      application. Every runtime-infrastructure dependency below is declared
      <optional>true</optional> so it is present on this module's own compile
      classpath (the JPA, validation, observability, Jackson and crypto
      annotations it references) yet is NOT propagated transitively to the
      services and the API gateway that depend on this jar. Each executable
      module explicitly declares the starters/providers it actually needs at
      runtime. This prevents JPA/Hikari/Hibernate, Actuator, Prometheus,
      tracing, Redis and Spring Session from leaking into modules (notably the
      gateway) that must NOT start a datasource or a JPA context.
    -->
    <dependencies>

        <!-- Persistence: JPA/Jakarta Persistence annotations for the domain entities. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jakarta Bean Validation annotations for request/response DTOs and entities. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Actuator types referenced by the shared ObservabilityConfig. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Prometheus metrics registry (Micrometer). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Distributed tracing via the OpenTelemetry bridge. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Redis connectivity backing externalized session (provider-side only). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Session (Redis) for the externalized SessionContext. -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jackson 3 databind for the strict, allowlisted Spring Session Redis JSON
             serializer (SessionRedisConfig, QA CR-17). spring-data-redis marks its
             Jackson dependency optional, so it is declared here for compilation; the
             web/json starters provide it on every service's runtime classpath. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jackson annotations for the frozen JSON contract on SessionContext/DTOs. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Password-encoding primitives for the shared DelegatingPasswordEncoder factory. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Web MVC / Servlet API for the shared exception types and correlation filter. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          Servlet API for the shared CorrelationIdFilter (a OncePerRequestFilter
          subclass). Declared <scope>provided</scope>: it is on this module's
          compile classpath but is NOT propagated to dependents, and at runtime
          the embedded Tomcat of each web service supplies it. Non-web modules
          (batch-service) never load the filter because WebObservabilityConfig is
          gated by @ConditionalOnWebApplication. Version is managed by the
          Spring Boot parent BOM (jakarta-servlet.version = 6.1.0).
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test stack: JUnit 5 (Jupiter), AssertJ, Mockito. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers for repository integration tests against real PostgreSQL. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
