<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build root for the CardDemo card platform.

  Declares the nine modules, imports the Spring Boot dependency bill of
  materials, pins the language level, fixes plugin versions, and enforces the
  module dependency direction.

  Dependency direction:
    libs/*             no dependency on another module of this build
    services/*         the two libraries only, never another service
    equivalence-tests  every module, at test scope

  Rationale for the choices in this file: card-platform/docs/decision-log.md (planned)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.carddemo</groupId>
  <artifactId>card-platform</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>CardDemo Card Platform</name>
  <description>
    Event-driven card platform for CardDemo. Contains two shared libraries, six
    services, and one equivalence test suite that compares service behaviour
    against the documented COBOL business rules.
  </description>

  <!-- Modules build in dependency order. The equivalence test suite builds last. -->
  <modules>
    <module>libs/event-contracts</module>
    <module>libs/cobol-compat</module>
    <module>services/authorization-service</module>
    <module>services/ledger-posting-service</module>
    <module>services/fraud-detection-service</module>
    <module>services/notification-service</module>
    <module>services/account-service</module>
    <module>services/card-service</module>
    <module>equivalence-tests</module>
  </modules>

  <properties>
    <!-- Language level. Every module compiles at release 25. The enforcer checks
         the running JDK, and every module descriptor repeats java.version. -->
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Dependency versions. Every other version comes from the imported bill of materials. -->
    <spring-boot.version>4.1.0</spring-boot.version>
    <json-schema-validator.version>3.0.6</json-schema-validator.version>
    <logstash-logback-encoder.version>9.0</logstash-logback-encoder.version>

    <!--
      Security floors. Each version below is higher than the version
      spring-boot-dependencies:4.1.0 manages, and the dependencyManagement block
      re-declares every affected artifact. A property alone changes nothing here,
      because a bill of materials imported with scope import ignores the importing
      project's properties.
        tomcat.version    4.1.0 resolves 11.0.22
        postgresql        4.1.0 resolves 42.7.11
        jackson-databind  4.1.0 resolves 3.1.4
        lz4-java          kafka-clients:4.2.1 resolves 1.10.1
      Remove an entry once the bill of materials manages that version or higher.
    -->
    <tomcat.version>11.0.24</tomcat.version>
    <postgresql.version>42.7.13</postgresql.version>
    <jackson.version>3.1.5</jackson.version>
    <lz4-java.version>1.11.1</lz4-java.version>

    <!-- Plugin versions. -->
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot bill of materials. Modules declare managed artifacts with no version element. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!--
        The two artifacts the bill of materials does not manage, so each carries a
        version here and no module repeats one. json-schema-validator reads JSON
        Schema Draft 2020-12 in event-contracts. logstash-logback-encoder is pinned
        and available to any module that declares it; the six services take their
        structured log output from the Spring Boot logging starter instead, through
        the logging.structured.format.console property of application.yml, and none
        of them ships a Logback configuration file.
      -->
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
      <dependency>
        <groupId>net.logstash.logback</groupId>
        <artifactId>logstash-logback-encoder</artifactId>
        <version>${logstash-logback-encoder.version}</version>
      </dependency>

      <!--
        Embedded servlet container. spring-boot-starter-web pulls these three
        artifacts, and every service module declares that starter. The three
        entries below raise all three from the version the bill of materials
        manages to ${tomcat.version}.
      -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${tomcat.version}</version>
      </dependency>

      <!-- Database driver. Every service module declares it at runtime scope. -->
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>

      <!--
        JSON binding. GHSA-5gvw-p9qm-jgwh, recorded as CVE-2026-59889, affects
        jackson-databind 3.1.4, the version the bill of materials manages, and is
        fixed in 3.1.5. This platform serializes every event through
        libs/event-contracts, whose records use @JsonUnwrapped, one half of the
        affected combination, so the floor is raised rather than argued away.
        Both entries move together: jackson-core and jackson-databind ship as one
        release train, and a mixed pair is unsupported.
      -->
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>${jackson.version}</version>
      </dependency>

      <!--
        Native LZ4 codec, reached only through org.apache.kafka:kafka-clients.
        GHSA-xx22-p4ch-683r, recorded as CVE-2026-7053, is an out-of-bounds read
        in the native XXHash routine of lz4-java 1.10.1, fixed in 1.11.1. Kafka
        calls XXHashFactory.fastestInstance() on every compressed frame it reads,
        so the library sits on a broker input path and the floor is raised even
        though Kafka supplies bounded offsets. The declaration below is the only
        place the version appears; kafka-clients keeps the version it resolves for
        every other transitive artifact.
      -->
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>${lz4-java.version}</version>
      </dependency>

      <!-- Shared libraries of this build, available to modules with no version element. -->
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>event-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>cobol-compat</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Executable jar packaging. The six service modules declare this plugin
             in their own build section.

             attach false leaves the executable archive at target/<artifactId>-<version>.jar,
             which the Dockerfiles read, and points each module's Maven artifact at the plain
             archive this plugin writes as target/<artifactId>-<version>.jar.original, which
             equivalence-tests reads. -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <executions>
            <execution>
              <id>repackage</id>
              <goals>
                <goal>repackage</goal>
              </goals>
              <configuration>
                <attach>false</attach>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <!-- Compilation at the pinned language level, with method parameter
             names kept in the class files. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>

        <!-- Unit tests. The default patterns cover the Test suffix. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>

        <!-- Integration and equivalence tests, bound to integration-test and
             verify. Tests run against the classes directory. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
          </configuration>
          <executions>
            <execution>
              <id>integration-test</id>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- Toolchain and dependency direction checks. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        Checks that run in every module at the validate phase and break the build on failure. The
        two executions carry different scopes. enforce-toolchain-and-prohibited applies to every
        module with no exception. enforce-service-independence applies to every module except
        equivalence-tests, which unbinds that one execution and keeps the other.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-toolchain-and-prohibited</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <fail>true</fail>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.16,4.0.0)</version>
                  <message>This build runs on Apache Maven 3.9.16 or a later 3.9 release.</message>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>This build runs on JDK 25 or later. Every module compiles at release 25.</message>
                </requireJavaVersion>
                <bannedDependencies>
                  <!-- Checked against the dependencies a module declares, not
                       against the transitive graph. -->
                  <searchTransitive>false</searchTransitive>
                  <message>This artifact is excluded from every module of this build. Services use Java records with explicit mapper classes, a hand written openapi.yaml, and PostgreSQL tables for state.</message>
                  <excludes>
                    <exclude>org.projectlombok:lombok</exclude>
                    <exclude>org.mapstruct:*</exclude>
                    <exclude>org.immutables:*</exclude>
                    <exclude>org.springdoc:*</exclude>
                    <exclude>io.springfox:*</exclude>
                    <exclude>io.swagger:*</exclude>
                    <exclude>io.swagger.core.v3:*</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-data-redis</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-data-redis-reactive</exclude>
                    <exclude>redis.clients:*</exclude>
                    <exclude>io.lettuce:*</exclude>
                    <exclude>com.github.ben-manes.caffeine:*</exclude>
                    <exclude>org.ehcache:*</exclude>
                    <exclude>net.sf.ehcache:*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-service-independence</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <fail>true</fail>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <message>A service module must not depend on another service module. A service depends on libs/event-contracts and libs/cobol-compat only, and reaches other services through Kafka events. The equivalence-tests module is the single exception, and it unbinds this execution in its own module descriptor.</message>
                  <excludes>
                    <exclude>com.carddemo:authorization-service</exclude>
                    <exclude>com.carddemo:ledger-posting-service</exclude>
                    <exclude>com.carddemo:fraud-detection-service</exclude>
                    <exclude>com.carddemo:notification-service</exclude>
                    <exclude>com.carddemo:account-service</exclude>
                    <exclude>com.carddemo:card-service</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
