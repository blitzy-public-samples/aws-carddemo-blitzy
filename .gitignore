# cobol-check build output
target/
**/target/

# GnuCOBOL / gcc coverage data
*.gcno
*.gcda
*.gcov

# Downloaded cobol-check JAR (regenerated by 'make init')
tests/cobol-check/lib/cobol-check-*.jar

# Compiled COBOL artifacts
*.so
*.dll
*.dylib

# cobol-check merged-source debug output
*.merged.cbl
*.merged.cob

# OS / editor / IDE
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Python (tests/fixtures/load_fixture.py)
__pycache__/
*.pyc
*.pyo
