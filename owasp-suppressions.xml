<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==========================================================================
  OWASP dependency-check suppression file.
  ==========================================================================
  This file suppresses ONLY vulnerabilities for which no patched release is
  reachable in the dependency graph (no-fix-available security debt). Every
  vulnerability that DOES have a fixed release is remediated by forward-pinning
  the version in pom.xml (<properties> / <dependencyManagement>), never here.

  Each <suppress> block:
    * is scoped to an exact artifact (packageUrl) AND an exact CVE, so it can
      never silently mask a different or future vulnerability;
    * carries an `until` date so the suppression EXPIRES and forces a scheduled
      re-review (has a patched release appeared yet?) - an expired suppression
      no longer applies and the build fails again by design;
    * has a matching rationale, owner, and review date in docs/decision-log.md
      (decision D49).

  Reviewed: 2026-07-20. Next review: 2026-10-19 (see `until` below).
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
      kotlin-stdlib - CVE-2026-53914.
      Path: opentelemetry-exporter-otlp (Observability tracing exporter) -> okhttp
            -> org.jetbrains.kotlin:kotlin-stdlib (runtime scope).
      There is NO stable patched release: the CVE is fixed only in kotlin-stdlib
      2.4.20, which upstream has published exclusively as a pre-release
      (2.4.20-Beta1); the latest STABLE Kotlin release remains below the fixed
      line and is still affected. Forward-pinning to a beta would violate the
      "no unverified/pre-release dependency" discipline, and swapping the OTLP
      transport away from okhttp risks regressing the (rule-mandated) tracing
      pipeline. The artifact is a transitive runtime dependency of an optional
      exporter; it carries no attacker-reachable entry point in this application.
      Suppress this single CVE until a stable fixed Kotlin release is available.
    -->
    <suppress until="2026-10-19Z">
        <notes><![CDATA[
            No stable fixed release (fix only in kotlin-stdlib 2.4.20-Beta1, a
            pre-release). Transitive/runtime via opentelemetry-exporter-otlp -> okhttp.
            Tracked in docs/decision-log.md D49; re-review on expiry of `until`.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-stdlib(-jdk[78]|-common)?@.*$</packageUrl>
        <cve>CVE-2026-53914</cve>
    </suppress>

    <!--
      httpcore5 5.0.2 (SHADED) - CVE-2026-54399, CVE-2026-54428.
      This is NOT a first-class graph node: version 5.0.2 is relocated/bundled
      INSIDE com.github.docker-java:docker-java-transport-zerodep:3.4.2, which
      Testcontainers pulls in at TEST scope only. Because the classes are shaded
      into the zerodep uber-jar, a <dependencyManagement> forward-pin cannot
      rewrite them (they are not resolved as an external coordinate). The artifact
      is confined to the test/integration harness (Testcontainers Docker client)
      and is ABSENT from the production application fat jar - it never ships and
      is not reachable at runtime. Suppress both CVEs on the exact shaded version
      until Testcontainers/docker-java ship a zerodep build embedding a patched
      httpcore5.
    -->
    <suppress until="2026-10-19Z">
        <notes><![CDATA[
            Shaded inside docker-java-transport-zerodep-3.4.2 (Testcontainers, TEST
            scope); not an external coordinate, so dependencyManagement cannot bump it,
            and it is absent from the production fat jar. Tracked in docs/decision-log.md
            D49; re-review on expiry of `until`.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents\.core5/httpcore5(-h2)?@5\.0\.2$</packageUrl>
        <cve>CVE-2026-54399</cve>
        <cve>CVE-2026-54428</cve>
    </suppress>

    <!--
      flyway-database-postgresql : CPE FALSE POSITIVE (org.flywaydb:flyway-database-postgresql
      matched to cpe:2.3:a:postgresql:postgresql, the PostgreSQL DATABASE SERVER product).
      This artifact is the Flyway PostgreSQL dialect adapter (a small Java library that teaches
      Flyway how to emit PostgreSQL-flavoured migration SQL). It is NOT the PostgreSQL server, the
      psql client, or the Windows installer, so none of the server/distribution advisories that
      dependency-check's NVD CPE matcher attaches to it are reachable here:
        * CVE-2020-25695 (8.8), CVE-2020-25694 (8.1), CVE-2020-25696 (7.5), CVE-2020-14350 (7.3),
          CVE-2020-10733 (7.3), CVE-2020-14349 (7.1) are all "PostgreSQL versions before 13.1/12.5"
          server flaws (SQL injection via extensions, the psql interactive terminal, the Windows
          installer's uncontrolled search path). The application connects to a separately provisioned
          PostgreSQL 16 server (well above every fixed line); the running server's version, not this
          build-time Java adapter, is what those CVEs are scored against.
        * CVE-2021-3393 (4.3) is a server-side information leak in "postgresql before 13.2/12.6"; same
          server versus adapter mismatch (sub-threshold, listed here so the whole false-positive CPE is
          cleared in one place rather than leaving a stray informational hit).
      This is a classic vendor:product CPE collision driven by the "postgresql" token in the Maven
      coordinate; it is data-dependent (it fires against some NVD CPE-dictionary snapshots and not
      others), so it is suppressed by CPE, scoped to the exact flyway-database-postgresql packageUrl,
      to make the CVSS>=7 gate deterministic across NVD snapshots (see docs/decision-log.md D49).
      Server-patch currency for the deployed PostgreSQL instance is owned by the H-1 provisioning task.
    -->
    <suppress until="2026-10-19Z">
        <notes><![CDATA[
            CPE false positive: org.flywaydb:flyway-database-postgresql (Flyway PostgreSQL dialect
            adapter, a build-time Java library) matched to cpe:2.3:a:postgresql:postgresql (the
            PostgreSQL database SERVER). The advisories are server/psql/installer flaws, not reachable
            from this adapter; the deployed PostgreSQL server's patch level is governed by H-1. Suppressed
            by CPE, scoped to the exact packageUrl, dated for re-review. Tracked in docs/decision-log.md D49.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.flywaydb/flyway-database-postgresql@.*$</packageUrl>
        <cve>CVE-2020-25695</cve>
        <cve>CVE-2020-25694</cve>
        <cve>CVE-2020-25696</cve>
        <cve>CVE-2020-14350</cve>
        <cve>CVE-2020-10733</cve>
        <cve>CVE-2020-14349</cve>
        <cve>CVE-2021-3393</cve>
    </suppress>

</suppressions>
