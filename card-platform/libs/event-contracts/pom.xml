<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared module holding the JSON Schema documents the six services read.

  src/main/resources/schemas holds nine versioned documents:
    transaction-authorized-v1, transaction-declined-v1, transaction-posted-v1,
    fraud-flagged-v1 and fraud-cleared-v1 for the authorization, ledger and
    fraud events; transaction-declined-v2 for the one decline whose account the
    card cross-reference could not resolve, which carries no account identifier
    and is keyed on its transaction identifier; account-state-changed-v1 and
    card-updated-v1 for the two mutation events the supporting services publish;
    and dead-letter-v1 for the one shape every dead-letter topic carries.
  Every document is JSON Schema Draft 2020-12 and names the account identifier
  as the single source of the Kafka message key. Every document also closes its
  top-level property set and declares a maxProperties ceiling, so an undeclared
  field is refused rather than carried inside a known event type, and offers one
  bounded extensions object, so a later version adds a value without breaking a
  consumer already validating against this one.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The aggregator sits two levels up. libs/ holds no pom.xml of its own. -->
  <parent>
    <groupId>com.carddemo</groupId>
    <artifactId>card-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!-- groupId and version come from the parent. -->
  <artifactId>event-contracts</artifactId>
  <packaging>jar</packaging>

  <name>event-contracts</name>
  <description>Nine versioned JSON Schema documents: six for the authorization, ledger and fraud events, two for the account and card mutation events, and one for the dead-letter envelope. Every document is Draft 2020-12 and closes its top-level property set and carries one bounded extensions object, so an undeclared field is refused while evolution stays additive.</description>

  <!-- Compiles this module at Java 25. -->
  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <!-- Versions come from the aggregator. Declare none here. -->
  <dependencies>
    <!-- JSON binding. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Validates payloads against JSON Schema Draft 2020-12. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>

    <!-- kafka-clients supplies the Serializer and Deserializer interfaces. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
    </dependency>

    <!-- Runs the event-contract tests under src/test/java/com/carddemo/events. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Assertion and test utility surface. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
