# =============================================================================
# CardDemo — local Docker Compose environment template.
#
# Copy this file to `.env` and replace EVERY value with a strong, unique secret
# before running `docker compose up`. `.env` is listed in .gitignore and MUST
# NEVER be committed.
#
# docker-compose.yml references each of these as ${VAR:?...}, so `docker compose`
# fails fast if any value is unset — there is deliberately NO insecure built-in
# default (QA CR-11). Generate strong values, for example:
#     openssl rand -base64 24
# =============================================================================

# --- PostgreSQL bootstrap owner role + database ------------------------------
# The owner role owns the schema and runs the Flyway migrations. Each service
# then connects as its OWN least-privilege role, both locally and on Kubernetes;
# see docs/decision-log.md.
POSTGRES_DB=carddemo
POSTGRES_USER=carddemo_owner
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# --- Per-service PostgreSQL roles --------------------------------------------
# db/init/01-create-service-roles.sh creates one role per service on the
# database's FIRST boot using exactly these values, and docker-compose.yml hands
# each service only its own credential, so a compromised service cannot act as
# another. Nothing is defaulted: a missing value aborts initialisation rather
# than creating a role with a guessable password. Use a distinct strong value
# per role, for example `openssl rand -base64 24`.
# NOTE: these are read only while the data volume is being initialised. To
# change one afterwards, either ALTER ROLE ... PASSWORD in the running database
# or discard the volume and re-initialise.
CARDDEMO_AUTH_DB_PASSWORD=replace-with-strong-auth-role-password
CARDDEMO_USER_DB_PASSWORD=replace-with-strong-user-role-password
CARDDEMO_ACCOUNT_DB_PASSWORD=replace-with-strong-account-role-password
CARDDEMO_CARD_DB_PASSWORD=replace-with-strong-card-role-password
CARDDEMO_TRANSACTION_DB_PASSWORD=replace-with-strong-transaction-role-password
CARDDEMO_BILLPAY_DB_PASSWORD=replace-with-strong-billpay-role-password
CARDDEMO_REPORTING_DB_PASSWORD=replace-with-strong-reporting-role-password
CARDDEMO_BATCH_DB_PASSWORD=replace-with-strong-batch-role-password

# --- Redis (externalized Spring Session / cache store; AUTH is required) -----
REDIS_PASSWORD=replace-with-strong-redis-password

# --- Grafana admin (observability dashboard) ---------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password

# --- Prometheus authenticated scrape principal -------------------------------
# Password Prometheus presents when scraping each service's protected
# /actuator/prometheus endpoint (the matching service-side "monitoring"
# principal is provisioned with the bootable services; see docs/decision-log.md).
MONITORING_PASSWORD=replace-with-strong-monitoring-scrape-password

# --- PII encryption key (AES-256-GCM, at-rest field encryption) ---------------
# Consumed by carddemo-common's CryptoConverter (CARDDEMO_PII_KEY env var, or
# the carddemo.pii.key system property) to encrypt/decrypt the sensitive
# customer and card attributes at rest (SSN, government id, EFT account id,
# CVV). The converter throws IllegalStateException when no key is configured,
# so this value is REQUIRED by every service that reads or writes those fields.
# Must be a Base64-encoded 256-bit (32-byte) key, for example:
#     openssl rand -base64 32
CARDDEMO_PII_KEY=replace-with-base64-encoded-32-byte-aes-key
