      ******************************************************************
      *  TC29 -- 3000-SEND-MAP umbrella runs all sub-paragraphs
      *
      *  Drives 3000-SEND-MAP (production lines 2649-2662).  The
      *  umbrella PERFORMs 3100-SCREEN-INIT, 3200-SETUP-SCREEN-VARS,
      *  3250-SETUP-INFOMSG, 3300-SETUP-SCREEN-ATTRS, 3390-SETUP-
      *  INFOMSG-ATTRS, 3400-SEND-SCREEN.  Each sub-paragraph
      *  contributes coverage; this test exercises the orchestrator's
      *  full PERFORM chain.  Asserts the eventual MOVE side effects
      *  from 3400-SEND-SCREEN to verify the chain reached completion.
      ******************************************************************
       TESTCASE 'COACTUPC 3000-SEND-MAP performs all sub paragraphs'
            SET WS-NO-INFO-MESSAGE TO TRUE
            SET CDEMO-PGM-ENTER    TO TRUE
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3000-SEND-MAP THRU 3000-SEND-MAP-EXIT
            EXPECT CCARD-NEXT-MAP TO BE 'CACTUPA'
            EXPECT CCARD-NEXT-MAPSET TO BE 'COACTUP'
            EXPECT TRNNAMEO OF CACTUPAO TO BE 'CAUP'
            EXPECT PGMNAMEO OF CACTUPAO TO BE 'COACTUPC'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC30 -- 3202-SHOW-ORIGINAL-VALUES propagates ACCT data
      *
      *  Drives 3202-SHOW-ORIGINAL-VALUES (production lines 2787-
      *  2865) along the FOUND-ACCT-IN-MASTER+FOUND-CUST-IN-MASTER
      *  path.  Pre-loads ACUP-OLD-ACTIVE-STATUS with 'A' and
      *  ACUP-OLD-GROUP-ID with 'PREMIUM   ', sets both 88-levels
      *  TRUE, and asserts the production paragraph copied them to
      *  the CACTUPAO output map.  PROMPT-FOR-CHANGES side effect
      *  on WS-INFO-MSG (line 2791) is also asserted.
      ******************************************************************
       TESTCASE 'COACTUPC 3202-SHOW-ORIGINAL-VALUES copies ACCT data'
            SET FOUND-ACCT-IN-MASTER  TO TRUE
            SET FOUND-CUST-IN-MASTER  TO TRUE
            MOVE 'A'              TO ACUP-OLD-ACTIVE-STATUS
            MOVE 'PREMIUM   '     TO ACUP-OLD-GROUP-ID
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3202-SHOW-ORIGINAL-VALUES
                THRU 3202-SHOW-ORIGINAL-VALUES-EXIT
            EXPECT ACSTTUSO OF CACTUPAO TO BE 'A'
            EXPECT AADDGRPO OF CACTUPAO TO BE 'PREMIUM   '
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC31 -- 3202-SHOW-ORIGINAL-VALUES propagates CUST data
      *
      *  Drives 3202-SHOW-ORIGINAL-VALUES along the FOUND-CUST-IN-
      *  MASTER path (lines 2827-2864).  Pre-loads ACUP-OLD-CUST-
      *  ADDR-STATE-CD with 'NY' and ACUP-OLD-CUST-PRI-HOLDER-IND
      *  with 'Y'; asserts the production paragraph copied them
      *  to the CACTUPAO output fields.
      ******************************************************************
       TESTCASE 'COACTUPC 3202-SHOW-ORIGINAL-VALUES copies CUST data'
            SET FOUND-CUST-IN-MASTER  TO TRUE
            MOVE 'NY'             TO ACUP-OLD-CUST-ADDR-STATE-CD
            MOVE 'Y'              TO ACUP-OLD-CUST-PRI-HOLDER-IND
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3202-SHOW-ORIGINAL-VALUES
                THRU 3202-SHOW-ORIGINAL-VALUES-EXIT
            EXPECT ACSSTTEO OF CACTUPAO TO BE 'NY'
            EXPECT ACSPFLGO OF CACTUPAO TO BE 'Y'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC33 -- 3203-SHOW-UPDATED-VALUES with ISVALID flags ON
      *
      *  Drives 3203-SHOW-UPDATED-VALUES (production lines 2870-
      *  2949) along ALL FIVE FLG-*-ISVALID-TRUE branches.  Pre-
      *  loads ACUP-NEW-ACTIVE-STATUS='B' and ACUP-NEW-CREDIT-
      *  LIMIT-N=1000.00 et al; sets all five 88-levels TRUE.
      *  The production code edits each currency value via
      *  WS-EDIT-CURRENCY-9-2-F and stores the formatted alpha
      *  into the output map fields.  Asserts ACSTTUSO is moved
      *  unchanged (line 2872).
      ******************************************************************
       TESTCASE 'COACTUPC 3203-SHOW-UPDATED-VALUES isvalid branches'
            MOVE 'B'              TO ACUP-NEW-ACTIVE-STATUS
            MOVE 1000.00          TO ACUP-NEW-CREDIT-LIMIT-N
            MOVE 500.00           TO ACUP-NEW-CASH-CREDIT-LIMIT-N
            MOVE 50.00            TO ACUP-NEW-CURR-BAL-N
            MOVE 100.00           TO ACUP-NEW-CURR-CYC-CREDIT-N
            MOVE 200.00           TO ACUP-NEW-CURR-CYC-DEBIT-N
            SET FLG-CRED-LIMIT-ISVALID         TO TRUE
            SET FLG-CASH-CREDIT-LIMIT-ISVALID  TO TRUE
            SET FLG-CURR-BAL-ISVALID           TO TRUE
            SET FLG-CURR-CYC-CREDIT-ISVALID    TO TRUE
            SET FLG-CURR-CYC-DEBIT-ISVALID     TO TRUE
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3203-SHOW-UPDATED-VALUES
                THRU 3203-SHOW-UPDATED-VALUES-EXIT
            EXPECT ACSTTUSO OF CACTUPAO TO BE 'B'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC34 -- 3203-SHOW-UPDATED-VALUES with ISVALID flags OFF
      *
      *  Drives 3203-SHOW-UPDATED-VALUES along ALL FIVE FLG-*-
      *  ISVALID-FALSE (ELSE) branches.  Pre-loads ACUP-NEW-
      *  CREDIT-LIMIT-X as raw alpha string, leaves all flags at
      *  their default LOW-VALUES.  Production code copies the
      *  alpha-X variants to the output map untouched.  Asserts
      *  ACUP-NEW-CREDIT-LIMIT-X passes through to ACRDLIMO.
      ******************************************************************
       TESTCASE 'COACTUPC 3203-SHOW-UPDATED-VALUES else branches'
            MOVE 'C'              TO ACUP-NEW-ACTIVE-STATUS
            MOVE '1234567890.12 ' TO ACUP-NEW-CREDIT-LIMIT-X
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3203-SHOW-UPDATED-VALUES
                THRU 3203-SHOW-UPDATED-VALUES-EXIT
            EXPECT ACSTTUSO OF CACTUPAO TO BE 'C'
            EXPECT ACRDLIMO OF CACTUPAO TO BE '1234567890.12 '
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC36 -- 3250-SETUP-INFOMSG ACUP-SHOW-DETAILS arm
      *
      *  Drives 3250-SETUP-INFOMSG WHEN ACUP-SHOW-DETAILS arm.
      *  Sets ACUP-CHANGE-ACTION='S' so ACUP-SHOW-DETAILS true.
      *  Asserts WS-INFO-MSG = PROMPT-FOR-CHANGES literal.
      ******************************************************************
       TESTCASE 'COACTUPC 3250-SETUP-INFOMSG show-details arm'
            SET CDEMO-PGM-REENTER  TO TRUE
