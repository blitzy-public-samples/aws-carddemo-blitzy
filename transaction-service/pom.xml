<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Inherits dependency and plugin management from the root parent BOM. -->
    <parent>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>transaction-service</artifactId>
    <packaging>jar</packaging>

    <name>CardDemo Transaction Service</name>
    <description>Online transaction inquiry/add (COTRN00C / COTRN01C / COTRN02C) and the Spring Batch
        transaction-posting job (CBTRN02C / POSTTRAN.jcl) for the modernized CardDemo application.</description>

    <dependencies>

        <!-- REST controllers for the online transaction endpoints (list CT00, view CT01, add CT02). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistence (VSAM -> PostgreSQL): transactions, daily_transactions, and lookup access
             to card_xref / accounts / transaction_category_balance. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Batch for the transaction-posting job (reader / processor / writer + reject writer). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation for request DTOs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Authorization boundary for every route in this service. Without a
            SecurityFilterChain the service accepted session-less calls and served
            data to an unauthenticated caller; the principal is rebuilt from the
            shared Redis session by SessionContextAuthenticationFilter.
          Spring Security. Every service enforces authentication itself
          (defence in depth): the api-gateway is not a trust boundary, so a
          request that reaches this service over the internal network still has
          to present the shared, Redis-backed session principal. It also
          protects the Actuator telemetry endpoints with the dedicated
          monitoring principal (carddemo-common ManagementSecurityConfig).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Actuator health/readiness/liveness and metrics endpoints. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Redis connectivity backing externalized session. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Spring Session (Redis) for the externalized SessionContext (COMMAREA replacement). -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <!--
          Spring Boot 4 modularized auto-configuration: SessionAutoConfiguration and
          SessionDataRedisAutoConfiguration live in the spring-boot-session-data-redis module
          (they are NOT bundled with org.springframework.session:spring-session-data-redis).
          Without it the `spring.session.*` properties are inert, SessionRepositoryFilter is
          never registered, and HttpSession silently falls back to in-memory servlet-container
          storage instead of Redis, defeating the externalized COMMAREA session.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-session-data-redis</artifactId>
        </dependency>

        <!-- Prometheus metrics registry. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!--
          Distributed tracing (AAP 0.7.5). The Boot OpenTelemetry starter brings the
          Micrometer Tracing OTel bridge TOGETHER WITH the tracing/OTel
          auto-configuration and the OTLP span exporter. The bridge alone leaves
          no Tracer in the context, so no trace context is created and every
          traceId/spanId stays empty.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <!--
          Spring Boot 4 extracted tracing auto-configuration out of spring-boot-actuator into
          dedicated modules. Without BOTH of the modules below the bridge above is completely
          inert: no io.micrometer.tracing.Tracer bean is created, no spans are produced, the
          management.tracing.sampling.probability setting is ignored, and the traceId/spanId
          fields of the logback-spring.xml pattern stay permanently empty.
            * spring-boot-micrometer-tracing               -> MicrometerTracingAutoConfiguration
                                                              (span-producing observation handlers)
            * spring-boot-micrometer-tracing-opentelemetry -> OpenTelemetryTracingAutoConfiguration
                                                              (SdkTracerProvider + OtelTracer +
                                                               W3C context propagators)
          No OTLP/Zipkin exporter artifact is declared, so spans are created and correlated into
          the MDC but not shipped off-box; adding an exporter is a deployment-time choice.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>

        <!--
          Flyway: the shared CardDemo migration set ships in carddemo-common
          (classpath:db/migration) and is applied in production by the single migration
          owner (batch-service). This service keeps the migration library so its
          Testcontainers integration tests can provision the identical production schema
          (business tables plus the Spring Batch metadata the posting job needs).
        -->
        <!-- Flyway schema/seed migrations under src/main/resources/db/migration/. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
          Spring Boot 4 modularized auto-configuration: FlywayAutoConfiguration lives in the
          spring-boot-flyway module (it is NOT bundled with flyway-core). Without it, the shared
          carddemo-common migrations never run and Hibernate `validate` fails on the missing
          business tables. It is gated by `spring.flyway.enabled`.
          spring-boot-flyway module (it is NOT bundled with flyway-core). Without it,
          `spring.flyway.*` is inert - no flywayInitializer bean is registered and no
          migration ever runs, however the properties are set. It is gated by
          `spring.flyway.enabled`, so it stays inert in production, where this service does
          not own the schema.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Shared library: JPA entities, DTOs, DateUtil, constants, observability, exceptions. -->
        <dependency>
            <groupId>com.carddemo</groupId>
            <artifactId>carddemo-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          Shared test-support utilities from carddemo-common (test-jar), above all
          com.carddemo.common.testsupport.CardDemoSchemaMigrations: it applies the real
          committed Flyway migrations of every owning module to the throwaway test
          database so integration tests run against the deployed schema instead of DDL
          fabricated inside the test.
        -->
        <dependency>
            <groupId>com.carddemo</groupId>
            <artifactId>carddemo-common</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- Test stack: JUnit 5 (Jupiter), AssertJ, Mockito. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Spring MVC web-slice test support (@WebMvcTest). Spring Boot 4 split the
          spring-boot-test-autoconfigure module into per-technology modules surfaced
          through their own starters; @WebMvcTest is no longer transitively provided by
          spring-boot-starter-test. Backs TransactionControllerTest. Version managed by
          the Spring Boot BOM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Batch testing utilities (JobLauncherTestUtils) for the posting-job tests. -->
        <dependency>
            <groupId>org.springframework.batch</groupId>
            <artifactId>spring-batch-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security testing utilities for role-gated endpoint tests. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers for integration tests against real PostgreSQL. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
              A deterministic, NON-PRODUCTION AES-256 key is supplied to the forked test JVM so
              the carddemo-common CryptoConverter can encrypt the sensitive columns the tests
              persist (card CVV, customer identifiers). CryptoConverter fails fast when no key is
              configured, so production deployments MUST still provide the real key via the
              CARDDEMO_PII_KEY environment variable (see docs/decision-log.md). The value is an
              obviously-fake, test-only fixture and is never used outside the test phases; it is
              declared for BOTH forks because Surefire and Failsafe run in separate JVMs.
              Plugin version inherited from the Spring Boot parent plugin management.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <carddemo.pii.key>Y2FyZGRlbW8tdGVzdC1waWkta2V5LTMyYnl0ZXMhISE=</carddemo.pii.key>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Repackage into an executable Spring Boot jar (repackage goal inherited from the parent). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Failsafe binds the integration-test (*IT) suite to the integration-test/verify
              phases so the application context-load integration test
              (TransactionServiceApplicationIT) runs against a real Testcontainers PostgreSQL
              under `mvn verify`, separate from the fast Surefire unit tests in the `test`
              phase. Plugin version inherited from the parent BOM.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <carddemo.pii.key>Y2FyZGRlbW8tdGVzdC1waWkta2V5LTMyYnl0ZXMhISE=</carddemo.pii.key>
                    </systemPropertyVariables>
                </configuration>
</plugin>
        </plugins>
    </build>

</project>
