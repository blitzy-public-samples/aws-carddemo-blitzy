# ============================================================================
# OCR Processing Application - Backend API Environment Configuration
# ============================================================================
# This is a template file. Copy this to .env and fill in actual values.
# NEVER commit the actual .env file with real credentials to version control.
# 
# For production deployment:
# - Generate secure random strings for all secrets (min 32 characters)
# - Use secret management systems (AWS Secrets Manager, Google Secret Manager)
# - Enable TLS for all database connections
# - Use strong passwords with mixed case, numbers, and symbols
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------------------------------------
# Environment: development, staging, production
NODE_ENV=development

# Port for the API server to listen on
PORT=3000

# API URL prefix (e.g., /api/v1/documents)
API_PREFIX=api/v1

# API version for backward compatibility tracking
API_VERSION=v1

# Base URL for the application (used for OAuth callbacks)
BASE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION - PostgreSQL
# ----------------------------------------------------------------------------
# Primary relational database for structured data
# Production: Use connection pooling, SSL mode, and read replicas
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ocr_dev
DB_PASSWORD=change_me_to_secure_password
DB_NAME=ocr_db

# Enable SQL query logging in development (set to false in production)
DB_LOGGING=true

# Connection pool settings
DB_POOL_MIN=5
DB_POOL_MAX=20

# SSL mode: disable (dev), require (prod)
DB_SSL_MODE=disable

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION - MongoDB
# ----------------------------------------------------------------------------
# Document database for storing full extracted document data
# Production: Use replica set with at least 3 nodes
MONGODB_URI=mongodb://ocr_dev:change_me_to_secure_password@localhost:27017/ocr_documents

# MongoDB options
MONGODB_AUTH_SOURCE=admin
MONGODB_REPLICA_SET=

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION - Redis
# ----------------------------------------------------------------------------
# In-memory cache for sessions, rate limiting, and job tracking
# Production: Use Redis Cluster or managed service (ElastiCache, Memorystore)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_to_secure_password
REDIS_DB=0

# Redis connection options
REDIS_TLS_ENABLED=false
REDIS_CONNECTION_TIMEOUT=10000

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION - ElasticSearch
# ----------------------------------------------------------------------------
# Full-text search engine for document content
# Production: Use managed service (AWS OpenSearch, Elastic Cloud)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change_me_to_secure_password

# ElasticSearch options
ELASTICSEARCH_INDEX_PREFIX=ocr_
ELASTICSEARCH_REQUEST_TIMEOUT=30000

# ----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY - JWT Configuration
# ----------------------------------------------------------------------------
# Generate secure random strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Use different secrets for access and refresh tokens

# JWT Access Token (short-lived, 15 minutes)
JWT_ACCESS_SECRET=change_me_to_random_string_min_32_chars_use_crypto_randomBytes
JWT_ACCESS_EXPIRY=15m

# JWT Refresh Token (long-lived, 7 days)
JWT_REFRESH_SECRET=change_me_to_different_random_string_min_32_chars
JWT_REFRESH_EXPIRY=7d

# Bcrypt password hashing rounds (10-12 recommended, higher = slower but more secure)
BCRYPT_ROUNDS=10

# ----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY - OAuth 2.0 Providers
# ----------------------------------------------------------------------------
# Google OAuth 2.0 Configuration
# Setup: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Microsoft OAuth 2.0 Configuration
# Setup: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/v1/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

# ----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY - SAML 2.0 (Enterprise SSO)
# ----------------------------------------------------------------------------
# SAML configuration is per-account, stored in database
# These are defaults for testing
SAML_ENABLED=false
SAML_ENTRY_POINT=
SAML_ISSUER=ocr-processing-app
SAML_CALLBACK_URL=http://localhost:3000/api/v1/auth/saml/acs

# ----------------------------------------------------------------------------
# CLOUD STORAGE - AWS S3
# ----------------------------------------------------------------------------
# Document storage configuration
# Production: Use IAM roles instead of access keys where possible
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# S3 bucket names (use different buckets per environment)
AWS_S3_BUCKET_NAME=ocr-documents-dev
AWS_S3_PROCESSED_BUCKET=ocr-processed-dev
AWS_S3_EXPORTS_BUCKET=ocr-exports-dev

# S3 configuration
AWS_S3_REGION=us-east-1
AWS_S3_PRESIGNED_URL_EXPIRY=900

# ----------------------------------------------------------------------------
# OCR PROCESSING SERVICE
# ----------------------------------------------------------------------------
# Python FastAPI service for OCR and NLP processing
OCR_SERVICE_URL=http://localhost:8000

# Timeout for OCR requests (milliseconds) - single page typically <30s
OCR_SERVICE_TIMEOUT=60000

# Retry configuration for failed OCR requests
OCR_SERVICE_MAX_RETRIES=3
OCR_SERVICE_RETRY_DELAY=5000

# ----------------------------------------------------------------------------
# MESSAGE QUEUE - RabbitMQ
# ----------------------------------------------------------------------------
# Asynchronous job processing queue
# Production: Use clustered RabbitMQ or managed service (AWS MQ, CloudAMQP)
RABBITMQ_URL=amqp://ocr_dev:change_me_to_secure_password@localhost:5672

# Queue configuration
RABBITMQ_EXCHANGE=document_processing_exchange
RABBITMQ_QUEUE=ocr_processing_queue
RABBITMQ_DLQ=ocr_processing_dlq
RABBITMQ_NOTIFICATION_QUEUE=notification_queue

# Worker configuration
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_RECONNECT_TIMEOUT=10000

# Alternative: AWS SQS (uncomment to use SQS instead of RabbitMQ)
# USE_SQS=false
# AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/ocr-processing
# AWS_SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789/ocr-processing-dlq

# ----------------------------------------------------------------------------
# EMAIL SERVICE
# ----------------------------------------------------------------------------
# Provider: sendgrid or aws_ses
EMAIL_PROVIDER=sendgrid

# SendGrid Configuration
# Setup: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key

# AWS SES Configuration (alternative to SendGrid)
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY_ID=your_ses_access_key
# AWS_SES_SECRET_ACCESS_KEY=your_ses_secret_key

# Email settings
EMAIL_FROM=noreply@ocr-app.com
EMAIL_FROM_NAME=OCR Processing App
EMAIL_REPLY_TO=support@ocr-app.com

# Email templates directory
EMAIL_TEMPLATES_DIR=./templates/email

# ----------------------------------------------------------------------------
# INTEGRATIONS - QuickBooks
# ----------------------------------------------------------------------------
# QuickBooks Online API integration
# Setup: https://developer.intuit.com/app/developer/qbo/docs/get-started
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/v1/integrations/quickbooks/callback

# ----------------------------------------------------------------------------
# INTEGRATIONS - Salesforce
# ----------------------------------------------------------------------------
# Salesforce API integration
# Setup: https://developer.salesforce.com/docs/atlas.en-us.api_rest.meta/api_rest/
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
SALESFORCE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/salesforce/callback
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# ----------------------------------------------------------------------------
# INTEGRATIONS - NetSuite
# ----------------------------------------------------------------------------
# NetSuite Token-Based Authentication (TBA)
# Setup: https://system.netsuite.com/app/setup/integrationslist.nl
NETSUITE_ACCOUNT_ID=your_netsuite_account_id
NETSUITE_CONSUMER_KEY=your_netsuite_consumer_key
NETSUITE_CONSUMER_SECRET=your_netsuite_consumer_secret
NETSUITE_TOKEN_ID=your_netsuite_token_id
NETSUITE_TOKEN_SECRET=your_netsuite_token_secret
NETSUITE_REST_API_URL=https://{account_id}.suitetalk.api.netsuite.com

# ----------------------------------------------------------------------------
# INTEGRATIONS - SharePoint (Future)
# ----------------------------------------------------------------------------
# SHAREPOINT_TENANT_ID=your_sharepoint_tenant_id
# SHAREPOINT_CLIENT_ID=your_sharepoint_client_id
# SHAREPOINT_CLIENT_SECRET=your_sharepoint_client_secret
# SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/yoursite

# ----------------------------------------------------------------------------
# INTEGRATIONS - Dropbox (Future)
# ----------------------------------------------------------------------------
# DROPBOX_APP_KEY=your_dropbox_app_key
# DROPBOX_APP_SECRET=your_dropbox_app_secret
# DROPBOX_REDIRECT_URI=http://localhost:3000/api/v1/integrations/dropbox/callback

# ----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY - Sentry
# ----------------------------------------------------------------------------
# Error tracking and performance monitoring
# Setup: https://sentry.io/settings/
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0

# ----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY - DataDog
# ----------------------------------------------------------------------------
# Application performance monitoring
# Setup: https://app.datadoghq.com/organization-settings/api-keys
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key
DATADOG_SITE=datadoghq.com
DATADOG_SERVICE_NAME=ocr-backend-api
DATADOG_ENABLED=false

# ----------------------------------------------------------------------------
# API RATE LIMITING
# ----------------------------------------------------------------------------
# Rate limit configuration per account
# Window in milliseconds (3600000 = 1 hour)
RATE_LIMIT_WINDOW=3600000

# Maximum requests per window per account
RATE_LIMIT_MAX_REQUESTS=1000

# Rate limit for public endpoints (no auth)
RATE_LIMIT_PUBLIC_MAX_REQUESTS=100

# ----------------------------------------------------------------------------
# CORS CONFIGURATION
# ----------------------------------------------------------------------------
# Cross-Origin Resource Sharing settings
# Production: Set to your frontend domain(s)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# ----------------------------------------------------------------------------
# SECURITY - Virus Scanning
# ----------------------------------------------------------------------------
# ClamAV virus scanning for uploaded documents
VIRUS_SCAN_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Skip virus scanning for development (NOT RECOMMENDED for production)
SKIP_VIRUS_SCAN_IN_DEV=true

# ----------------------------------------------------------------------------
# FILE UPLOAD CONFIGURATION
# ----------------------------------------------------------------------------
# Maximum file size in bytes (100MB default)
MAX_FILE_SIZE=104857600

# Allowed file types (MIME types)
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/jpg,image/png,image/tiff

# Maximum files per batch upload
MAX_BATCH_SIZE=100

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------
# Toggle features on/off without code deployment
FEATURE_BATCH_PROCESSING=true
FEATURE_TEMPLATE_BUILDER=true
FEATURE_INTEGRATIONS=true
FEATURE_WEBHOOKS=true
FEATURE_ANALYTICS=true
FEATURE_MFA=false
FEATURE_SAML_SSO=false

# ----------------------------------------------------------------------------
# PERFORMANCE TUNING
# ----------------------------------------------------------------------------
# Worker pool size for parallel processing
WORKER_POOL_SIZE=5

# Cache TTL in seconds
CACHE_TTL=3600

# Session expiry in seconds (7 days)
SESSION_EXPIRY=604800

# ----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------------------------
# Log level: error, warn, info, debug, verbose
LOG_LEVEL=debug

# Log format: json or pretty
LOG_FORMAT=pretty

# Log file path (leave empty to disable file logging)
LOG_FILE_PATH=

# Log to console
LOG_CONSOLE_ENABLED=true

# ----------------------------------------------------------------------------
# SWAGGER/OPENAPI DOCUMENTATION
# ----------------------------------------------------------------------------
# Enable Swagger UI in development (disable in production for security)
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# ----------------------------------------------------------------------------
# DATA RETENTION & COMPLIANCE
# ----------------------------------------------------------------------------
# Document retention period in days (default 7 years)
DATA_RETENTION_DAYS=2555

# Automatic deletion of old documents
AUTO_DELETE_EXPIRED_DOCUMENTS=false

# GDPR compliance: Enable right to be forgotten
GDPR_ENABLED=true

# ----------------------------------------------------------------------------
# TIMEZONE
# ----------------------------------------------------------------------------
# Default timezone for the application (all times stored as UTC in database)
TZ=UTC

# ----------------------------------------------------------------------------
# WEBHOOK CONFIGURATION
# ----------------------------------------------------------------------------
# Webhook delivery settings
WEBHOOK_TIMEOUT=30000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAYS=5000,25000,125000

# Webhook signature algorithm
WEBHOOK_SIGNATURE_ALGORITHM=sha256

# ----------------------------------------------------------------------------
# TESTING & DEVELOPMENT
# ----------------------------------------------------------------------------
# Seed database with test data on startup (development only)
SEED_TEST_DATA=false

# Enable debug mode with additional logging
DEBUG_MODE=false

# Skip authentication in development (NEVER use in production)
SKIP_AUTH_IN_DEV=false

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
# 
# NEXT STEPS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in all placeholder values with real credentials
# 3. Generate secure secrets for JWT_ACCESS_SECRET and JWT_REFRESH_SECRET
# 4. Ensure .env is in .gitignore (NEVER commit secrets!)
# 5. For production, use secret management systems instead of .env files
# 
# SECURITY REMINDERS:
# - Rotate secrets regularly (every 90 days minimum)
# - Use different credentials for each environment (dev, staging, prod)
# - Grant minimum necessary permissions for service accounts
# - Enable audit logging for all credential usage
# - Monitor for unusual access patterns
# 
# DOCUMENTATION:
# - Architecture: docs/ARCHITECTURE.md
# - API Documentation: docs/API.md
# - Deployment: docs/DEPLOYMENT.md
# - Development Setup: docs/DEVELOPMENT.md
# ============================================================================
