<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Inherits dependency and plugin management from the root parent BOM. -->
    <parent>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>billpay-service</artifactId>
    <packaging>jar</packaging>

    <name>CardDemo Bill Payment Service</name>
    <description>Executable Spring Boot microservice for online bill payment, migrated from the legacy
        CICS program COBIL00C (transaction CB00). Exposes POST /billpay over the shared carddemo
        database and externalized Redis session, and packages as an executable Spring Boot fat jar.</description>

    <dependencies>

        <!-- Shared library: JPA entities, DTOs, SessionContext, constants, DateUtil, observability. -->
        <dependency>
            <groupId>com.carddemo</groupId>
            <artifactId>carddemo-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          Shared test-support utilities from carddemo-common (test-jar), above all
          com.carddemo.common.testsupport.MigratedSchemaContainer / CardDemoSchemaMigrations:
          they provide a PostgreSQL container whose schema is produced by the owning modules'
          real committed Flyway migrations, so integration tests validate against the deployed
          schema instead of one generated from the entities.
        -->
        <dependency>
            <groupId>com.carddemo</groupId>
            <artifactId>carddemo-common</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- REST controller (POST /billpay); embedded Tomcat, Jackson, HTTP server metrics. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistence: Spring Data JPA over Account/Transaction/CardXref (VSAM -> PostgreSQL). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation for the request DTO. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Authorization boundary for every route in this service. Without a
            SecurityFilterChain the service accepted session-less calls and served
            data to an unauthenticated caller; the principal is rebuilt from the
            shared Redis session by SessionContextAuthenticationFilter.
          Spring Security. Every service enforces authentication itself
          (defence in depth): the api-gateway is not a trust boundary, so a
          request that reaches this service over the internal network still has
          to present the shared, Redis-backed session principal. It also
          protects the Actuator telemetry endpoints with the dedicated
          monitoring principal (carddemo-common ManagementSecurityConfig).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Actuator health/readiness/liveness and metrics endpoints. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Redis connectivity (Lettuce) backing externalized session. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Spring Session (Redis): COMMAREA pseudo-conversational state -> server-side SessionContext. -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <!--
          Spring Boot 4 modularized auto-configuration: SessionAutoConfiguration and
          SessionDataRedisAutoConfiguration live in the spring-boot-session-data-redis module
          (they are NOT bundled with org.springframework.session:spring-session-data-redis).
          Without it the `spring.session.*` properties are inert, SessionRepositoryFilter is
          never registered, and HttpSession silently falls back to in-memory servlet-container
          storage instead of Redis, defeating the externalized COMMAREA session.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-session-data-redis</artifactId>
        </dependency>

        <!-- Prometheus metrics registry (exposes /actuator/prometheus). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!--
          Distributed tracing (AAP 0.7.5). The Boot OpenTelemetry starter brings the
          Micrometer Tracing OTel bridge TOGETHER WITH the tracing/OTel
          auto-configuration and the OTLP span exporter. The bridge alone leaves
          no Tracer in the context, so no trace context is created and every
          traceId/spanId stays empty (QA F28).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <!--
          Tracing auto-configuration. Spring Boot 4 ships auto-configuration in
          dedicated modules, so the bridge above is inert on its own: without these
          two modules no Tracer or ObservationRegistry tracing handler is created and
          no traceId/spanId ever reaches the SLF4J MDC, leaving the structured log
          lines uncorrelatable across service boundaries (AAP 0.7.5).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver (runtime only). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway migration engine and PostgreSQL support (kept for standalone operability). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
          Spring Boot 4 modularized auto-configuration: FlywayAutoConfiguration lives in the
          spring-boot-flyway module (it is NOT bundled with flyway-core). Without it, the shared
          carddemo-common migrations never run and Hibernate `validate` fails on the missing
          business tables (QA Issue 1(a)). It is gated by `spring.flyway.enabled`.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- Test stack: JUnit 5 (Jupiter), AssertJ, Mockito, Spring Test/MockMvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Spring MVC test slice (@WebMvcTest, MockMvc auto-configuration). As of
          Spring Boot 4.0 the Web MVC test slice was extracted from the catch-all
          spring-boot-test-autoconfigure module into its own spring-boot-webmvc-test
          module, surfaced through this starter; it is no longer transitively provided
          by spring-boot-starter-test. The version is managed by the Spring Boot BOM
          (no explicit pin).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers for integration tests against real PostgreSQL. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
              A deterministic, NON-PRODUCTION AES-256 key is supplied to the forked test JVM so
              the carddemo-common CryptoConverter can encrypt the sensitive columns the tests
              persist (card CVV, customer identifiers). CryptoConverter fails fast when no key is
              configured, so production deployments MUST still provide the real key via the
              CARDDEMO_PII_KEY environment variable (see docs/decision-log.md). The value is an
              obviously-fake, test-only fixture and is never used outside the test phases; it is
              declared for BOTH forks because Surefire and Failsafe run in separate JVMs.
              Plugin version inherited from the Spring Boot parent plugin management.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <carddemo.pii.key>Y2FyZGRlbW8tdGVzdC1waWkta2V5LTMyYnl0ZXMhISE=</carddemo.pii.key>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
              Failsafe runs the *IT integration tests in the integration-test/verify phases,
              matching every other service module: without the binding the *IT classes compile
              but never execute, so the security contract they freeze (an unauthenticated
              POST /billpay must never reach the payment service) would not be enforced by the
              build. The forked JVM is also handed the non-production PII key. Plugin version
              inherited from the parent BOM.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <carddemo.pii.key>Y2FyZGRlbW8tdGVzdC1waWkta2V5LTMyYnl0ZXMhISE=</carddemo.pii.key>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Executable fat jar: bind the repackage goal (version from the parent's plugin management). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
