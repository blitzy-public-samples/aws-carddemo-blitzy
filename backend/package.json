{
  "name": "backend",
  "version": "1.0.0",
  "description": "NestJS backend API service for OCR Processing Application",
  "private": true,
  "license": "Apache-2.0",
  "author": "OCR Processing Team",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:generate": "typeorm migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm migration:revert -d src/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/core": "10.4.20",
    "@nestjs/common": "10.4.20",
    "@nestjs/platform-express": "10.4.20",
    "@nestjs/typeorm": "10.0.2",
    "@nestjs/passport": "10.0.3",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/swagger": "8.0.7",
    "@nestjs/config": "3.3.0",
    "@nestjs/schedule": "4.1.1",
    "@nestjs/websockets": "10.4.20",
    "@nestjs/platform-socket.io": "10.4.20",
    "typeorm": "0.3.27",
    "pg": "8.13.1",
    "mongodb": "6.12.0",
    "redis": "4.7.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-google-oauth20": "2.0.0",
    "@node-saml/passport-saml": "5.1.0",
    "bcrypt": "5.1.1",
    "class-validator": "0.14.1",
    "class-transformer": "0.5.1",
    "@elastic/elasticsearch": "8.17.0",
    "amqplib": "0.10.5",
    "@aws-sdk/client-s3": "3.713.0",
    "@aws-sdk/client-sqs": "3.713.0",
    "@google-cloud/storage": "7.14.0",
    "winston": "3.17.0",
    "winston-daily-rotate-file": "5.0.0",
    "helmet": "8.0.0",
    "compression": "1.8.1",
    "express-rate-limit": "7.5.0",
    "@apigrate/quickbooks": "4.4.0",
    "jsforce": "3.10.8",
    "netsuite-rest": "1.1.0",
    "@pnp/sp": "4.9.0",
    "dropbox": "10.34.0",
    "googleapis": "144.0.0",
    "@sentry/node": "8.55.0",
    "axios": "1.13.2",
    "rxjs": "7.8.1",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.1",
    "exceljs": "4.4.0",
    "xml2js": "0.6.2",
    "csv-writer": "1.6.0",
    "uuid": "11.0.3",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.20",
    "@types/node": "22.10.2",
    "@types/express": "5.0.0",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-google-oauth20": "2.0.16",
    "@types/bcrypt": "5.0.2",
    "@types/amqplib": "0.10.5",
    "@types/uuid": "10.0.0",
    "@types/compression": "1.7.5",
    "@types/xml2js": "0.4.14",
    "typescript": "5.3.3",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "jest": "29.7.0",
    "@types/jest": "29.5.14",
    "ts-jest": "29.2.5",
    "supertest": "7.0.0",
    "@types/supertest": "6.0.2",
    "eslint": "8.57.1",
    "@typescript-eslint/parser": "7.18.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "prettier": "3.4.2",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
