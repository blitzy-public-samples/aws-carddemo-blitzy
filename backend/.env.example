# CardDemo Backend — environment variable template (Ochs Rule #3: no hardcoded secrets).
# Copy to `.env` and fill in real values. `.env` is gitignored and must NEVER be committed.

# --- Database (PostgreSQL 17; VSAM replacement) ---
# Async driver for the app runtime; sync driver for Alembic migrations and batch loaders.
DATABASE_URL=postgresql+asyncpg://carddemo:carddemo@localhost:5432/carddemo
SYNC_DATABASE_URL=postgresql+psycopg2://carddemo:carddemo@localhost:5432/carddemo

# --- Security / auth (replaces CICS COMMAREA identity propagation) ---
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# bcrypt work factor (cost) for password hashing.
BCRYPT_ROUNDS=12
# Server-side session signing key (session-based auth is the confirmed baseline; JWT alternative).
SESSION_SECRET=change-me-too

# --- Application ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000
