# card-platform — environment contract for the local demo stack.
#
# ONE COMMAND does everything this file needs. From card-platform/:
#
#     scripts/start-demo.sh
#
# It packages the reactor, copies this file to .env, fills all nineteen credentials,
# builds the six images, starts the stack and reads each health endpoint. Re-running it
# is safe: a value already set here is left alone.
#
# To prepare the environment file without starting anything:
#
#     scripts/generate-env.sh
#
# BY HAND, the same work is four steps, and none of them is optional:
#
#     cp .env.example .env
#     mvn -B -ntp -DskipTests package
#     # generate the nineteen credentials, with the commands below
#     docker compose up -d --build
#
# The packaging step is not optional. Each service image copies a packaged archive out
# of its own target directory, and a fresh checkout carries none. The build needs
# OpenJDK 25 and Apache Maven 3.9.16.
#
# Every value that is not a credential is a working default. Every credential is a
# placeholder, and the stack refuses to start until the copy carries a real one. The
# generator below fills the fourteen passwords and the card-token key in one command; the
# four identity hashes are generated by the command in the section that declares them.
#
# NINETEEN values carry no default anywhere else: POSTGRES_PASSWORD, the six per-service
# database passwords, the broker administrator password, the six per-service broker
# passwords, the card-token key, and the four request-identity password hashes. Nothing in docker-compose.yml
# and nothing in a service falls back to a credential, so the stack refuses to start until
# this file supplies every one.
#
# THIS FILE IS NOT DEPLOYABLE AS IT STANDS. A value stated in a public repository is
# known to everyone who can read it, so every credential here is the literal REPLACE
# placeholder. Three refusals enforce that.
#
#     docker-compose.yml    stops the stack when a credential is unset
#     provisioning script   refuses a password still carrying REPLACE
#     each service          checks its own database password, broker credential and
#                           identity hashes as its context refreshes, and refuses to
#                           finish starting
#
# Generate all nineteen at once with the committed script, which reads the names below
# out of this file rather than keeping a second copy of them:
#
#     scripts/generate-env.sh
#
# Or generate the fourteen passwords by hand, into a .env this file has already been
# copied to:
#
#     cp .env.example .env
#     for v in POSTGRES_PASSWORD \
#              AUTHORIZATION_DB_PASSWORD LEDGER_DB_PASSWORD FRAUD_DB_PASSWORD \
#              NOTIFICATION_DB_PASSWORD ACCOUNT_DB_PASSWORD CARD_DB_PASSWORD \
#              KAFKA_ADMIN_PASSWORD \
#              AUTHORIZATION_KAFKA_PASSWORD LEDGER_KAFKA_PASSWORD FRAUD_KAFKA_PASSWORD \
#              NOTIFICATION_KAFKA_PASSWORD ACCOUNT_KAFKA_PASSWORD CARD_KAFKA_PASSWORD; do
#       sed -i "s|^$v=.*|$v=$(openssl rand -base64 24 | tr -d '/+=')|" .env
#     done
#
# The tr strips the three characters no password here may carry: the broker builds a login
# entry around its password, and a quote, a backslash or whitespace ends that entry early,
# so the broker refuses such a value. The four password hashes are generated differently,
# and the section that declares them carries the command, as does the section declaring the
# card-token key.
#
# Rationale for the choices in this file: card-platform/docs/decision-log.md
#
# Every credential here belongs to a disposable local container stack. Do not reuse one
# anywhere else. Keep your .env copy out of version control.
#
# Every published port binds to 127.0.0.1, so only this machine reaches the
# database, the broker and the management endpoints. The six service ports are
# published the same way.


# Parallel stacks (optional, no default)
# docker-compose.yml appends CLONE_INDEX to the compose project name, the
# container names and the volume names. Leave it unset for the default stack.
# Set it on the command line, with two free host ports, to run a second stack
# beside the first:
#
#     CLONE_INDEX=2 POSTGRES_PORT=5442 KAFKA_PORT=9102 docker compose up -d
#
# Give a second stack its own consumer groups as well, so the two stacks do not
# share read positions on the topics below.


# PostgreSQL instance
# One container serves all six services. Inside the compose network PostgreSQL
# always listens on 5432, and POSTGRES_PORT changes only the host mapping.

# Host name the six service containers resolve on the compose network.
POSTGRES_HOST=postgres

# Port published on 127.0.0.1 for psql and host-run tests. The mapping names the
# loopback address, so no other host on the network reaches the database.
POSTGRES_PORT=5432

# First database the container creates. The six service databases follow it.
POSTGRES_DB=carddemo

# The superuser the container creates. It provisions the six databases and the six
# service logins below. NO service signs on as this user. Each service holds its own
# login, so a compromise of one reaches one database.
POSTGRES_USER=carddemo

# Password for the superuser. REQUIRED and a placeholder. No default exists in
# docker-compose.yml or in any service, and the provisioning script refuses a value
# carrying REPLACE. The stack stops rather than creating a superuser under a published
# password.
POSTGRES_PASSWORD=REPLACE-WITH-A-GENERATED-SUPERUSER-PASSWORD


# Per-service database logins
# One login per service, each owning one database. A distinct name alone is not a
# boundary. PostgreSQL grants CONNECT on a new database to PUBLIC, so the provisioning
# script in docker-compose.yml revokes CONNECT from PUBLIC on all six and grants it to
# the owner alone. A compromised service then holds a password that opens one database.
#
# The usernames carry defaults, because a username is not a credential. The six passwords
# are placeholders, and three refusals enforce that.
#
#     docker-compose.yml    stops the stack when any one is unset
#     provisioning script   refuses one still carrying REPLACE
#     each service          refuses to finish starting with its own unset, placeholder
#                           or published
#
# Give each one a DISTINCT value. Six copies of one password are one login wearing six
# names.
AUTHORIZATION_DB_USER=carddemo_authorization_svc
AUTHORIZATION_DB_PASSWORD=REPLACE-WITH-A-GENERATED-PASSWORD-FOR-AUTHORIZATION

LEDGER_DB_USER=carddemo_ledger_svc
LEDGER_DB_PASSWORD=REPLACE-WITH-A-GENERATED-PASSWORD-FOR-LEDGER

FRAUD_DB_USER=carddemo_fraud_svc
FRAUD_DB_PASSWORD=REPLACE-WITH-A-GENERATED-PASSWORD-FOR-FRAUD

NOTIFICATION_DB_USER=carddemo_notification_svc
NOTIFICATION_DB_PASSWORD=REPLACE-WITH-A-GENERATED-PASSWORD-FOR-NOTIFICATION

ACCOUNT_DB_USER=carddemo_account_svc
ACCOUNT_DB_PASSWORD=REPLACE-WITH-A-GENERATED-PASSWORD-FOR-ACCOUNT

CARD_DB_USER=carddemo_card_svc
CARD_DB_PASSWORD=REPLACE-WITH-A-GENERATED-PASSWORD-FOR-CARD


# One private database per service
# docker-compose.yml creates these six databases on first start. Each name
# reaches exactly one service, through SPRING_DATASOURCE_URL.

AUTHORIZATION_DB_NAME=carddemo_authorization
LEDGER_DB_NAME=carddemo_ledger
FRAUD_DB_NAME=carddemo_fraud
NOTIFICATION_DB_NAME=carddemo_notification
ACCOUNT_DB_NAME=carddemo_account
CARD_DB_NAME=carddemo_card


# Schema inside each private database
# Flyway creates and migrates these schemas, and the persistence layer only
# validates against them. Each name carries a _service suffix, so none of the
# six collides with a PostgreSQL reserved word such as authorization.

AUTHORIZATION_DB_SCHEMA=authorization_service
LEDGER_DB_SCHEMA=ledger_service
FRAUD_DB_SCHEMA=fraud_service
NOTIFICATION_DB_SCHEMA=notification_service
ACCOUNT_DB_SCHEMA=account_service
CARD_DB_SCHEMA=card_service


# Authorization demo data
# Flyway locations the authorization service applies, in order.
# classpath:db/migration reproduces app/data/ASCII/acctdata.txt value for value, and the
# equivalence suite measures against it. Its 50 account expiries run from 2023-01-06 to
# 2025-12-28, and every origin timestamp in app/data/ASCII/dailytran.txt is dated 2022, so
# reason code 103 at app/cbl/CBTRN02C.cbl:L414-L420 declines none of the fixture feed.
# That rule compares raw text, so a request stamped with a later date than the expiry it
# is compared against declines: a demo call carrying today's date is later than all 50.
#
# classpath:db/demo adds one migration that extends those expiries to 2099-12-31 and
# changes nothing else, so the fan-out demo can publish TransactionAuthorized.
# Set this to classpath:db/migration alone for any run whose output is compared against
# the fixture.

AUTHORIZATION_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo

# Flyway locations the account service applies, in order, and they follow the two above
# rather than standing on their own. The account service owns the record the authorization
# service replicates, and it publishes its expiry on every state change, so extending the
# replica while leaving this record in 2025 would have the first posted transaction write a
# past expiry back over the extension and decline every later call on that account with
# reason 103. Change both keys together, or neither.

ACCOUNT_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo


# Kafka broker
# One broker node runs in Kafka Raft (KRaft) mode and advertises two listeners:
# kafka:29092 inside the compose network, and localhost:9092 on the host. Host
# tooling and services started outside Docker use the host listener.
#
# The broker creates no topic on demand. docker-compose.yml creates every topic
# below at start, so a mistyped topic name fails loudly instead of quietly
# opening a new stream.
#
# The Kubernetes path in card-platform/deploy/k8s advertises kafka:9092 instead,
# so its ConfigMap sets SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092 and overrides
# the value below. The variable below applies to the compose stack only.

# Broker address the six service containers connect to.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Port published on 127.0.0.1 for a console consumer or a test. The listener behind it
# requires one of the seven broker identities below, and binding the loopback address
# means only this machine can present one. A console consumer therefore needs a client
# properties file; the broker identities section states it.
KAFKA_PORT=9092

# Cluster identifier the broker writes into its data directory. A new value orphans that data.
KAFKA_CLUSTER_ID=cardDemoPlatformKRaft1

# Partitions the kafka container gives each topic it creates.
KAFKA_TOPIC_PARTITIONS=3

# Copies of each partition. One broker can hold one copy.
KAFKA_TOPIC_REPLICATION_FACTOR=1

# Finite retention for event and dead-letter logs, in hours. Seven days keeps the
# demo bounded; a deployment chooses its own legal and operational policy.
KAFKA_LOG_RETENTION_HOURS=168


# Broker identities and authorization
# The broker requires a Simple Authentication and Security Layer (SASL) identity on both
# client listeners and refuses every operation no access control entry allows. Seven
# identities exist: one administrator, which is the only super user and the only identity
# that creates a topic or an entry, and one per service.
#
# The entries each service holds are exactly what its own configuration needs, installed
# by the program in docker-compose.yml at broker start:
#
#     authorization   publishes transaction.authorized and transaction.declined,
#                     reads account.state-changed as authorization-account-state and
#                     card.updated as authorization-card-updated to keep the two
#                     replicas every decline rule reads current
#     ledger posting  reads transaction.authorized as ledger-posting,
#                     transaction.declined as ledger-reject and
#                     account.state-changed as ledger-account-state,
#                     publishes transaction.posted. It holds no producer entry on
#                     the declined topic: authorization is the sole writer of a decision
#     fraud detection reads transaction.authorized as fraud-detection,
#                     publishes fraud.assessed
#     notification    reads transaction.authorized as notification-authorized,
#                     transaction.posted as notification-posted, fraud.assessed as
#                     notification-fraud and customer.context-changed as
#                     notification-customer, publishes nothing
#     account         publishes account.state-changed and customer.context-changed,
#                     reads transaction.posted as account-posted
#     card            publishes card.updated, reads nothing
#
# All eleven listeners run, one consumer group each: two authorization replica
# listeners, three ledger listeners, fraud detection, four notification listeners,
# and the account posting listener. The card service registers none.
#
# Every service also holds WRITE on the dead-letter topic of each topic it reads. A
# consumer necessarily holds READ on the topic its producer writes; the boundary is that
# no service holds an entry naming another service's consumer group, or naming a topic
# its own configuration does not, so a compromised service can neither read a stream it
# does not consume nor join another service's group and take its partitions.
#
# A host console consumer needs the administrator identity in a properties file:
#
#     printf 'security.protocol=SASL_PLAINTEXT\nsasl.mechanism=PLAIN\n' > /tmp/admin.properties
#     printf 'sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule \
#     required username="%s" password="%s";\n' "$KAFKA_ADMIN_USER" "$KAFKA_ADMIN_PASSWORD" \
#       >> /tmp/admin.properties
#     kafka-console-consumer.sh --bootstrap-server localhost:9092 \
#       --consumer.config /tmp/admin.properties --topic transaction.authorized --from-beginning
#
# No password below may carry a quote, a backslash or whitespace, for the reason the
# header gives.

# Wire protocol for both client listeners. SASL_PLAINTEXT authenticates without
# encrypting, which is what this stack runs: the broker publishes on the loopback address
# alone and every service reaches it across one Docker bridge on this machine.
# card-platform/deploy/k8s/30-configmap.yaml sets SASL_SSL, because a cluster pod network
# is a shared path. This one value is what changes between the two.
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT

# The one mechanism this broker offers.
KAFKA_SASL_MECHANISM=PLAIN

# The broker administrator. It is the only super user, it answers for the broker's own
# inter-broker traffic, and it creates every topic and every access control entry. NO
# service holds it. The username carries a default; the password is a placeholder.
KAFKA_ADMIN_USER=carddemo-kafka-admin
KAFKA_ADMIN_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-ADMIN-PASSWORD

# The six service identities. Give each password a DISTINCT value: six copies of one
# password are one identity wearing six names, and the per-service entries above stop
# meaning anything.
AUTHORIZATION_KAFKA_USER=carddemo-authorization
AUTHORIZATION_KAFKA_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-PASSWORD-FOR-AUTHORIZATION

LEDGER_KAFKA_USER=carddemo-ledger
LEDGER_KAFKA_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-PASSWORD-FOR-LEDGER

FRAUD_KAFKA_USER=carddemo-fraud
FRAUD_KAFKA_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-PASSWORD-FOR-FRAUD

NOTIFICATION_KAFKA_USER=carddemo-notification
NOTIFICATION_KAFKA_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-PASSWORD-FOR-NOTIFICATION

ACCOUNT_KAFKA_USER=carddemo-account
ACCOUNT_KAFKA_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-PASSWORD-FOR-ACCOUNT

CARD_KAFKA_USER=carddemo-card
CARD_KAFKA_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-PASSWORD-FOR-CARD


# Transport Layer Security for the service ports
# Off here and on in the cluster. This stack runs every service on one Docker bridge on
# one machine and publishes each port on the loopback address alone. No network path here
# is readable by a third party. A cluster pod network is a shared path, so
# card-platform/deploy/k8s/30-configmap.yaml sets SERVER_SSL_ENABLED=true and names the
# keystore card-platform/deploy/k8s/31-secret.example.yaml templates.
#
# Switching the first value to true without the other two stops start-up, naming the
# empty keystore. That refusal lives in the SecurityConfig of each service, beside the
# credential checks.
SERVER_SSL_ENABLED=false
SERVER_SSL_KEYSTORE=
SERVER_SSL_KEYSTORE_TYPE=PKCS12
SERVER_SSL_KEYSTORE_PASSWORD=

# The management port follows the service port unless this says otherwise. It is stated
# rather than left to follow, because a monitoring credential travelling to a collector
# deserves the same protection as a cardholder identifier travelling to a client.
MANAGEMENT_SSL_ENABLED=false

# Scheme the container health check speaks. Set it to https together with
# MANAGEMENT_SSL_ENABLED, and neither on its own. A probe speaking http to an encrypted
# port reports a healthy container as unhealthy, and docker-compose.yml holds every
# dependent service back on that report.
HEALTHCHECK_SCHEME=http


# Event topics
# The Kafka container creates these seven business topics, one dead-letter topic per
# consumed source topic, and one shared fallback. The four source topics with
# dead-letter counterparts are transaction.authorized, transaction.posted,
# fraud.assessed and customer.context-changed. A published-only topic carries no
# dead-letter counterpart, since dead-letter routing carries a message a listener
# could not consume.
#
# Every message carries the account identifier as its key, which keeps one
# account's events on one partition and in order.
#
# Each name passes a gate before it reaches the broker: letters, digits, the
# period, the underscore and the hyphen only, up to 249 characters.

# Approved authorizations. Ledger posting and fraud detection read this topic,
# each under its own consumer group. Neither calls the other, and neither sits in the
# authorization response path.
TOPIC_TRANSACTION_AUTHORIZED=transaction.authorized

# Declined authorizations. transaction-declined-v1.json enumerates the reason
# codes 0100, 0101, 0102 and 0103.
TOPIC_TRANSACTION_DECLINED=transaction.declined

# Posted transactions carrying the new balance. Published by the ledger posting
# service and read by the notification service.
TOPIC_TRANSACTION_POSTED=transaction.posted

# Fraud verdicts. fraud-flagged-v1.json and fraud-cleared-v1.json are the two
# verdict contracts this repository defines. Published by the fraud detection
# service and read by the notification service.
TOPIC_FRAUD_ASSESSED=fraud.assessed

# Account mutations, published by the account service only. Its payload matches
# schemas/account-state-changed-v1.json in the event-contracts library.
TOPIC_ACCOUNT_STATE_CHANGED=account.state-changed

# Customer context mutations, published by the account service and read by the
# notification service to keep its account-keyed cardholder context current.
TOPIC_CUSTOMER_CONTEXT_CHANGED=customer.context-changed

# Card updates, published by the card service only. Current writes match
# schemas/card-updated-v2.json; the v1 document remains governed for old records.
TOPIC_CARD_UPDATED=card.updated

# The shared dead-letter topic. Two kinds of record reach it, and neither is a
# consumer failure with a source topic of its own.
#
# First, the terminal diagnostic an outbox relay publishes for a row it gave up on
# after ten delivery attempts. The authorization, ledger, account and card services
# each do this, and it is the only record of an event that will never be published.
# Second, the fallback for a recovery record whose source topic is absent.
#
# Normal consumer failures do not mix here: each routes to its source topic plus
# the suffix below.
TOPIC_DEAD_LETTER=carddemo.dead-letter

# Appended to each consumed source topic. The broker therefore creates
# transaction.authorized.DLT, transaction.posted.DLT, fraud.assessed.DLT and
# customer.context-changed.DLT. One dead-letter topic carries one source wire shape.
TOPIC_DEAD_LETTER_SUFFIX=.DLT


# Consumer groups
# TEN groups, one per active listener, so every consumer receives its own copy of every
# event. Two listeners sharing one group would split the events between them, and each
# would see half.
#
# The ten, by the topic each reads:
#
#   transaction.authorized      GROUP_LEDGER_POSTING, GROUP_FRAUD_DETECTION,
#                               GROUP_NOTIFICATION_AUTHORIZED
#   transaction.posted          GROUP_NOTIFICATION_POSTED, GROUP_ACCOUNT_POSTED
#   fraud.assessed              GROUP_NOTIFICATION_FRAUD
#   customer.context-changed    GROUP_NOTIFICATION_CUSTOMER
#   account.state-changed       GROUP_AUTHORIZATION_ACCOUNT, GROUP_LEDGER_ACCOUNT
#   card.updated                GROUP_AUTHORIZATION_CARD
#
# The three on the first topic are the fan-out AAP 0.1.1 and 0.8.3 require: one
# authorization call publishes one event and three services read it, none on behalf of
# another. The four below this block are declared with the listener they belong to,
# because the reason each needs its own group belongs beside it.
#
# The broker's access-control matrix in docker-compose.yml names all ten and nothing else.
# A group named here that the matrix does not carry is refused every delivery.
#
# A second checkout running its own stack scopes these per clone, so two stacks
# reading the same broker do not share a group and split the events.

# The two independent readers of transaction.authorized. Each consumes the one
# event an authorization call publishes, and neither knows the other exists.
GROUP_LEDGER_POSTING=ledger-posting

# Active. The fraud service reads transaction.authorized under this group.
GROUP_FRAUD_DETECTION=fraud-detection

# Consumer group the notification service joins to read transaction.authorized. This is the
# third independent consumer group on that topic, beside the ledger's and the fraud service's,
# which is the fan-out AAP 0.1.1 and 0.8.3 require. A group is what Kafka tracks offsets
# against, so all three services receive every record and none consumes on behalf of another.
GROUP_NOTIFICATION_AUTHORIZED=notification-authorized

# Consumer group the notification service joins to read transaction.posted.
GROUP_NOTIFICATION_POSTED=notification-posted

# Consumer group the notification service joins to read fraud.assessed.
GROUP_NOTIFICATION_FRAUD=notification-fraud

# Consumer group the notification service joins to read customer.context-changed.
GROUP_NOTIFICATION_CUSTOMER=notification-customer

# The authorization service's own two groups are declared further down, beside the
# listeners they belong to: GROUP_AUTHORIZATION_ACCOUNT and GROUP_AUTHORIZATION_CARD.

# The framework-level default group identifier of the authorization service, which names no
# listener: both of that service's listeners set their own group, and the two are the pair
# named just above. It is declared here because docker-compose.yml honours it when the broker
# provisioning step grants consumer access, so a name set here has to be the name granted.
# Changing it changes one access-control entry and no subscription.
GROUP_AUTHORIZATION=authorization


# Service ports
# One host port per service. Each container listens on 8080, and
# docker-compose.yml publishes it on the port below. /actuator is the surface
# every service exposes.

AUTHORIZATION_PORT=8081
LEDGER_PORT=8082
FRAUD_PORT=8083
NOTIFICATION_PORT=8084
ACCOUNT_PORT=8085
CARD_PORT=8086


# Management ports
# One management port per service, published on 127.0.0.1 only. /actuator/health
# and /actuator/metrics answer here, and nothing answers on the service port
# above. A second stack needs six free ports here as well.

# Authorization service management port.
AUTHORIZATION_MANAGEMENT_PORT=9081

# Ledger posting service management port.
LEDGER_MANAGEMENT_PORT=9082

# Fraud detection service management port.
FRAUD_MANAGEMENT_PORT=9083

# Notification service management port.
NOTIFICATION_MANAGEMENT_PORT=9084

# Account service management port.
ACCOUNT_MANAGEMENT_PORT=9085

# Card service management port.
CARD_MANAGEMENT_PORT=9086


# Supporting service addresses
# There are none. No service calls another service. The authorization service applies the
# decline rules against two tables of its own: card_xref resolves a card number to an
# account, and account_credit_snapshot supplies the credit limit, both cycle counters and
# the expiry date. Two listeners keep those current from account.state-changed and
# card.updated, so an authorization call waits on nothing outside the service and no
# consumer calls another consumer.

# Consumer groups of the two authorization replica listeners, one per stream so
# the two lag, rebalance and reset independently of each other.
GROUP_AUTHORIZATION_ACCOUNT=authorization-account-state
GROUP_AUTHORIZATION_CARD=authorization-card-updated

# Consumer group of the ledger's own account-state listener, which is a second
# reader of the same stream under a group of its own. It keeps
# account_balance_projection current: an account opened after deployment gets its
# first row here, and a closed billing cycle zeroes the two accumulators here.
# Sharing GROUP_AUTHORIZATION_ACCOUNT instead would split the partitions between
# the two services and each would see half the changes.
GROUP_LEDGER_ACCOUNT=ledger-account-state

# Consumer group of the ledger's reject listener, which reads transaction.declined
# under a group of its own. The authorization service is the sole writer of the
# decision, so the decline it published is what drives the 430-byte reject row of
# app/cbl/CBTRN02C.cbl:L446-L465 here. Without this listener the reject path has no
# production ingress at all and the row is never written, which is the one half of
# the 1500-VALIDATE-TRAN fork at app/cbl/CBTRN02C.cbl:L370-L378 that would otherwise
# be unreachable outside a test.
GROUP_LEDGER_REJECT=ledger-reject

# Consumer group of the account service's posted-transaction listener, which is a second
# reader of transaction.posted under a group of its own. It adds each posted amount to the
# account record, reproducing app/cbl/CBTRN02C.cbl:L545-L560, and the state change it
# publishes carries the two billing-cycle accumulators to the authorization replica that
# reason code 102 at app/cbl/CBTRN02C.cbl:L403-L413 reads. Without this listener those
# accumulators never move, so that rule tests one amount against the credit limit instead of
# the cycle exposure, and the account view reports the balance as it stood at deployment.
# Sharing GROUP_NOTIFICATION_POSTED instead would split the partitions between the two
# services and each would see half the postings.
GROUP_ACCOUNT_POSTED=account-posted


# Outbox relay
# docker-compose.yml passes these values to the authorization, ledger posting,
# fraud detection, account and card relays. Every relay claims due rows under its
# container hostname, publishes them in order and recovers a stranded claim after
# the timeout below.

# Milliseconds between two sweeps for unpublished outbox rows.
OUTBOX_RELAY_INTERVAL_MS=500

# Outbox rows one sweep claims.
OUTBOX_RELAY_BATCH_SIZE=100

# What a relay instance calls itself in outbox_event.claimed_by. Two relay instances that
# read the same unpublished row would publish the same event twice. The claim query takes
# the row with FOR UPDATE SKIP LOCKED, and this value records which instance won. Distinct
# per replica; unset it and the container's own hostname is used, which is distinct
# already.
OUTBOX_RELAY_INSTANCE_ID=

# How long a claim may be held before the row is treated as stranded and returned to PENDING. A
# relay that dies holding a claim would otherwise cost one event permanently: the row stays
# CLAIMED, the claim query filters on PENDING, and nothing looks at it again. ISO-8601 duration.
OUTBOX_RELAY_CLAIM_TIMEOUT=PT2M

# Milliseconds one sweep may spend waiting for broker acknowledgements before it stops and
# leaves the rest of its batch to the next sweep. This is the bound that keeps a sweep from
# running for as long as the broker is slow: the relay reads it once at the start of a pass as
# a monotonic deadline, and every send it awaits is awaited against what remains of that
# deadline rather than against a per-send timer.
#
# It has to stay above the producer's own window, which is MAX_BLOCK_MS + DELIVERY_TIMEOUT_MS
# for one send. The shipped producer settings resolve one send in at most four seconds against
# the five below, so a send always finishes or fails inside a pass instead of being abandoned
# while the broker may still complete it. Raising the producer window without raising this
# value is what a contract test in each relay-owning service refuses.
OUTBOX_RELAY_MAX_DURATION_MS=5000

# Hours a published outbox row remains for diagnosis before the retention sweep removes it.
OUTBOX_PUBLISHED_RETENTION_HOURS=168

# Hours a processed-event marker remains available to reject a redelivery. This has to outlast
# every window the record itself can come back through, and KAFKA_LOG_RETENTION_HOURS above is the
# shortest of those and the only one this platform sets. The two were equal, which left no room for
# segment cleanup lag, a restored backup carrying an older record, or an operator resetting a
# consumer group: a record still readable after its marker was swept is applied a second time, and
# for the account service that means one transaction amount reaching a balance twice. Every service
# refuses to start when this is under twice KAFKA_LOG_RETENTION_HOURS, so raise this first when
# raising that.
PROCESSED_EVENT_RETENTION_HOURS=720

# Milliseconds between two retention sweeps.
RETENTION_SWEEP_INTERVAL_MS=3600000

# Days a fraud risk verdict is kept, measured from the moment it was assessed. The fraud
# service's COMMENT ON TABLE fraud_assessment declared ninety days before any code applied it,
# so the number described an intention while the table grew by one row per authorized
# transaction. A security review found that, and domain/RetentionSweep now reads this value.
# The row is pseudonymous rather than anonymous: its account and transaction identifiers
# resolve to a named customer through the account and ledger services.
FRAUD_ASSESSMENT_RETENTION_DAYS=90

# Days a fraud velocity bucket is kept, measured from the bucket start. This one has a floor as
# well as a purpose: a bucket is still being counted into for the length of the configured
# velocity window, so a horizon shorter than that window would delete the row a live
# authorization is incrementing. The fraud service refuses to start when this does not exceed
# carddemo.fraud.risk.velocity-window-minutes.
FRAUD_VELOCITY_RETENTION_DAYS=7

# Days a ledger reject row is kept, measured from the moment the record was refused. Bounding
# the reject set is faithful rather than additive: app/jcl/DALYREJS.jcl:L24-L28 defines the
# source's reject generation group with LIMIT(5) and SCRATCH, so writing a sixth generation
# deletes the oldest. The balance and transaction tables carry no horizon and are never swept.
LEDGER_REJECTED_RETENTION_DAYS=90

# Milliseconds a locked read of the account or card update waits for a row another
# writer holds before the datastore refuses the lock and the update answers the
# documented lock-failure outcome. PostgreSQL waits forever when this is unset, so a
# contended write would hold its request open for as long as the other writer held the
# row. Applied per update transaction, so it never bounds a schema migration.
WRITE_LOCK_WAIT_MS=3000


# Request-surface controls
# Two filters every service installs, both reached through the shared environment block of
# docker-compose.yml, so the policy is the same in all six.
#
# The header below is what separates a first-party client from a browser replaying a cached
# HTTP Basic credential. A browser attaches that credential to a request a foreign page
# caused without asking the person reading the page, and the bodyless
# POST /accounts/{accountId}/cycle-close is submittable by an HTML form. An HTML form cannot
# set a header at all, and a cross-origin script call that set one would need a preflight no
# chain here grants. config/CrossSiteRequestFilter also refuses a request whose
# Sec-Fetch-Site or Origin names somewhere other than this service.
#
# The name is not a secret. Every curl example in the README files and in
# card-platform/docs/onboarding.md sets it, so change it only together with them.
API_CROSS_SITE_HEADER=X-CardDemo-Request

# Request-rate ceilings, counted over one fixed window by config/RequestRateCeilingFilter.
# It runs ahead of the security chain, because the expensive part of a guessed credential is
# the bcrypt verification and a refusal has to cost less than the attempt it refuses.
#
# Length of one window, in seconds.
API_RATE_WINDOW_SECONDS=60

# Requests one window admits. Applied twice: once keyed by source address, once by the
# identity the credential names, so one credential spread across many addresses is bounded
# too. Ten a second is generous for a demo and still a ceiling.
API_RATE_REQUESTS_PER_WINDOW=600

# The stricter ceiling on POST, PUT, PATCH and DELETE. Those are the requests that write a
# row and publish an event, so in the authorization service this is the route quota that
# bounds how fast a decision can be asked for.
API_RATE_WRITE_REQUESTS_PER_WINDOW=120

# Failed authentications from one source inside one window before that source is refused for
# the rest of it. This is the credential-guessing control. Only a request that carried a
# credential and was answered 401 counts, so a caller that simply forgot to authenticate is
# not treated as a guess.
API_RATE_AUTHENTICATION_FAILURES_PER_WINDOW=20

# Requests in flight at one moment. Past it the next request is refused rather than queued
# behind a connection pool that would then time out.
API_RATE_CONCURRENT_REQUESTS=64


# Replica freshness
# The authorization service authorizes against card_xref and account_credit_snapshot, which are
# copies kept current by state-change events. The COBOL posting program reads the datasets
# themselves at app/cbl/CBTRN02C.cbl:L382 and :L395, so it has nothing that can go stale. A copy
# does, and it goes stale quietly: a stale credit limit does not raise an error, it approves a
# transaction the current limit would have declined.
#
# How many records a replica stream may have waiting and still be authorized against. The
# measurement is consumer lag and deliberately not the age of a row: both producers publish on a
# state change and on nothing else, so a card nobody edits is a correct copy whose last observation
# recedes for ever, and an age bound refused every one of them a day after the seed load while
# readiness still reported the service up. Zero requires a consumer that is fully caught up, which
# is what a waiting AccountStateChanged deserves: it carries the credit limit and the cycle
# accumulators the credit-limit rule computes from.
#
# A delivery that could not be applied is the other half, and lag cannot see it because the offset
# advances once the record's diagnostic is away. The authorization service records that account in
# replica_gap and refuses that account alone until a later record for it applies.
REPLICA_LAG_CEILING=0


# Decision serialization and reserved exposure
# Only the authorization service reads these two. app/cbl/CBTRN02C.cbl posts each record
# before it validates the next, at :L424-L444 and :L545-L560, so the credit-limit test at
# :L403-L405 always reads accumulators carrying every earlier approval. Here the account
# service owns those accumulators and reports them back over three events, so an approval
# reserves its own amount on its account_credit_snapshot row inside the same transaction as
# the decision. Two transactions of 60.00 against a limit of 100.00 then approve once and
# decline once, as the batch program does.
#
# Milliseconds a decision waits for the account row another decision holds before the
# datastore refuses the lock and the call answers 503. Applied per decision transaction, so
# it never bounds a schema migration or a relay sweep.
DECISION_LOCK_WAIT_MS=3000

# How long a reservation holds its exposure, as an ISO-8601 duration, before the next
# decision on that account treats it as drained. The authoritative account.state-changed
# event releases a reservation as soon as it arrives, and this bound covers the approval
# whose event is dead-lettered and never arrives. Without it that exposure would be held for
# ever and available credit would shrink until every call declined. Fifteen minutes is far
# longer than the four-hop posting path takes and far shorter than a demo runs.
DECISION_RESERVATION_TTL=PT15M


# Consumer resilience
# docker-compose.yml passes these two values to the five containers that hold a listener:
# authorization, ledger posting, fraud detection, notification and account. Each listener
# retries under this policy and then routes the record to the configured dead-letter topic.
# The card service holds no listener and receives neither value.

# Delivery attempts a consumer makes before the record goes to its dead-letter
# topic.
CONSUMER_MAX_RETRY_ATTEMPTS=3

# Milliseconds a consumer waits between two attempts.
CONSUMER_RETRY_BACKOFF_MS=1000


# Notification history
# Days a statement-transaction row remains available to the history endpoint.
STATEMENT_RETENTION_DAYS=400

# Days a metadata-only notification attempt remains available.
NOTIFICATION_LOG_RETENTION_DAYS=90


# Logging and observability
# Root log level. Takes TRACE, DEBUG, INFO, WARN, ERROR or OFF.
LOG_LEVEL=INFO

# Log level for the com.carddemo packages, where the event fan-out shows. INFO by
# default: a DEBUG default retains identifiers in centralized logs. Raise it to
# DEBUG for one run when tracing a message, and lower it again afterwards.
LOG_LEVEL_CARDDEMO=INFO

# Actuator endpoints each service exposes under /actuator. They answer on the
# management port below, never on the service port, so a client of
# POST /authorizations reaches no runtime, database or broker internals. `info`
# is left out: it carries build and source-control detail no demo step reads.
#
# Listing an endpoint here does not publish it. Each service secures /actuator in
# front of these endpoints. health answers with no credential, because a container
# health check carries none. metrics and the Prometheus scrape require the MONITORING
# identity below. An anonymous caller receives 401, and an identity holding a business
# role receives 403.
MANAGEMENT_ENDPOINTS=health,metrics,prometheus

# Port each container serves /actuator on, inside the container. The management
# mappings below publish it on 127.0.0.1 only.
MANAGEMENT_PORT=9080

# Keeps /actuator/health/readiness and /actuator/health/liveness available. The
# Kubernetes probes in card-platform/deploy/k8s read one group each. A database
# outage therefore takes a Pod out of its Service and leaves the Java virtual
# machine running. Spring Boot 4.1.0 registers both groups by
# default and this pins it: set it to false and both paths answer 404. The compose
# healthcheck reads the aggregate endpoint and is unaffected.
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true

# ---------------------------------------------------------------------------
# Request identities
# ---------------------------------------------------------------------------
# Every service refuses an unauthenticated request. Each one reads the identities
# below and maps them onto Spring Security users. Start-up fails when the list is
# empty, rather than running with no identity at all.
#
# ADMIN and USER are the two outcomes of the SEC-USR-TYPE fork at
# app/cbl/COSGN00C.cbl:L232-L236. ACQUIRER and MONITORING are additive. MONITORING
# reaches the metrics and Prometheus endpoints above and no business route at all.
#
# ACQUIRER is the machine identity a point-of-sale network presents, and only the
# authorization service reads it: it is the one role besides ADMIN that reaches
# POST /authorizations. It is delivered to that service and to no other. In
# docker-compose.yml the pair below sits in the authorization-service environment block
# rather than in the shared x-service-environment anchor, and in Kubernetes the hash is a
# Secret of its own, carddemo-authorization-identity-secret, pulled by
# 40-authorization-service.yaml alone. It exists as its own identity rather than as another scope on
# the cardholder entry because that route names its card in the request body, so no
# path variable carries an identifier an ownership scope could be compared against.
# The route therefore reaches every card the platform holds, and a credential
# entitled to one account must not hold it. It owns no row, so it carries no scopes.
#
# A username is not a credential. These four are safe to keep as they are.
ADMIN_USERNAME=admin001
ACQUIRER_USERNAME=acquirer1
USER_USERNAME=user0001
MONITORING_USERNAME=monitor01

# What the ordinary identity owns, comma separated, one authority per
# entitlement. Three forms exist, one per kind of resource an owner reaches:
#
#   SCOPE_ACCOUNT_<eleven digits>       GET /accounts/{id}, GET /balances/{id},
#                                       GET /notifications/{id}, GET /cards
#   SCOPE_CUSTOMER_<nine digits>        GET /customers/{id}
#   SCOPE_CARD_<card token>             GET /notifications/{cardToken},
#                                       POST /cards/detail
#
# Write each identifier exactly as its column holds it, leading zeros included:
# SCOPE_ACCOUNT_1 grants nothing where the column holds 00000000001. The two values below
# name record 1 of app/data/ASCII/acctdata.txt and its customer in custdata.txt. Empty
# grants nothing, so an ownership-scoped route answers 403 until a value appears here.
#
# No SCOPE_CARD authority ships here, and the card token is the reason. A token is derived
# under the CARD_TOKEN_SECRET you generate below, so an authority checked into this file
# would name a card under a key no deployment uses. The administrator identity reaches every
# card route without one; the ordinary identity needs one derived for your own key, and
# appending it is a documented step rather than an edit to this line:
#
#   ./mvnw -q -pl libs/cobol-compat -am package -DskipTests
#   CARD_NUMBER="$(awk 'substr($0,17,11) == "00000000001" { print substr($0,1,16); exit }' \
#     ../app/data/ASCII/carddata.txt)"
#   CARD_TOKEN_SECRET="<the key you generated>" CARD_TOKEN_VERSION=1 \
#     jshell --class-path "$(find libs/cobol-compat/target -name 'cobol-compat-*.jar' | head -1)" \
#            -s - <<JSHELL
#   System.out.println(com.carddemo.cobol.PanMasker.cardToken(System.getenv("CARD_NUMBER")));
#   /exit
#   JSHELL
#
# Append SCOPE_CARD_<that value> to USER_SCOPES, in .env and not here.
# card-platform/deploy/k8s/30-configmap.yaml carries the same two values, so the ordinary
# identity reaches the same rows on both paths and a demo scripted on one reproduces on the
# other.
USER_SCOPES=SCOPE_ACCOUNT_00000000001,SCOPE_CUSTOMER_000000001

# ---------------------------------------------------------------------------
# Card-token key
# ---------------------------------------------------------------------------
# A card token names a card where a card number must not travel: it is the key of
# statement_transaction and notification_log, the identifier in a card history route and
# a list cursor, and the subject of a SCOPE_CARD authority. app/cpy/CVACT02Y.cpy declares
# no such field, so the whole mechanism is ADDITIVE and app/cbl/ has no ancestor for it.
#
# The token is a KEYED value: HmacSHA256 over the label, the version and the card number,
# taken under the key below. com.carddemo.cobol.PanMasker supplies NO default key, so a
# service handed none derives no token at all and says so. Why the key is required rather
# than optional: card-platform/docs/decision-log.md.
#
# This file ships NO key. A key checked in here is a key every reader of this repository
# holds, and a token derived under it names its card to any of them. Generate one for this
# deployment, and only this deployment:
#
#   openssl rand -base64 48 | tr -d '/+='
#
# Two services read it, the authorization service and the card service, and each refuses to
# start while the value is absent, blank, still a placeholder, shorter than 32 characters, or
# equal to either literal this repository has published. At least 32 characters, because a
# shorter key is padded to the hash block size rather than filling it, and a padded key
# spends key material instead of adding it.
#
# The value carries no quotes, because scripts/generate-env.sh finds a credential by the marker
# following the equals sign and writes the generated value in its place. A quoted placeholder is
# one the script does not see, so it would survive into .env and stop both services at start-up.
#
# Generating a key is all that is required. Nothing checked in has to be re-derived with it:
# the fifty card_token literals in
# card-platform/services/card-service/src/main/resources/db/migration/V2__seed.sql are
# derived under the build-scope key in card-platform/pom.xml, and CardTokenReconciler
# re-derives every one of them under this key when the card service starts. What does not
# survive a change of key is a token something already stored: a statement_transaction row,
# a notification_log row, an authorization_decision row, and any SCOPE_CARD authority
# granted above. card-platform/docs/suggested-next-tasks.md carries the rotation procedure.
CARD_TOKEN_SECRET=REPLACE-WITH-A-GENERATED-CARD-TOKEN-KEY-OF-AT-LEAST-32-CHARACTERS


# One to three digits. The version is part of the message the code covers, so raising it
# rolls every token over under the same key. Use it to stage a rollover: raise the version,
# re-derive the three artifacts above, then deploy both together.
CARD_TOKEN_VERSION=1

# Password hashes, one per identity above. Each value is an ALREADY-ENCODED
# password carrying its algorithm prefix in braces. A plaintext value
# authenticates nothing, which is how this platform declines to reproduce the
# plaintext comparison at app/cbl/COSGN00C.cbl:L223.
#
# The four values below are placeholders and NOT credentials. Each carries a real
# algorithm prefix and an unusable payload, so a stack started on them authenticates
# nobody. Every comparison fails, and the encoder logs that the stored value is not a
# hash. A working credential published in this repository would be a credential
# everyone holds.
#
# scripts/generate-env.sh generates all three, writes the plaintext it chose to
# card-platform/.demo-credentials with owner-only permissions, and honours
# CARDDEMO_ADMIN_PASSWORD, CARDDEMO_USER_PASSWORD and CARDDEMO_MONITORING_PASSWORD when
# you want to choose the passwords yourself.
#
# To generate one by hand instead, with a JDK on the path:
#
#   jshell --class-path "$(find ~/.m2 -name 'spring-security-crypto-*.jar' | head -1)":"$(find ~/.m2 -name 'commons-logging-1.3*.jar' | head -1)":"$(find ~/.m2 -name 'spring-core-7*.jar' | head -1)"
#   jshell> org.springframework.security.crypto.factory.PasswordEncoderFactories
#             .createDelegatingPasswordEncoder().encode("the password you chose")
#
# Copy the whole result between the single quotes below, the brace-delimited
# prefix included. Keep the single quotes: a bcrypt value contains `$`, and
# Compose expands `$...` in an unquoted or double-quoted dotenv value.
# Then authenticate with curl -u "$USER_USERNAME:the password you chose".
ADMIN_PASSWORD_HASH='{bcrypt}$2a$10$REPLACE-THIS-PLACEHOLDER-WITH-A-REAL-BCRYPT-HASH'
# Three of these four hashes reach all six services. This one reaches the authorization
# service alone, because it is the only service with code that verifies a password against
# it, and a digest sitting in five containers that never read it is a value an attacker who
# reaches any one of them can grind offline for the identity that authorizes every card.
ACQUIRER_PASSWORD_HASH='{bcrypt}$2a$10$REPLACE-THIS-PLACEHOLDER-WITH-A-REAL-BCRYPT-HASH'
USER_PASSWORD_HASH='{bcrypt}$2a$10$REPLACE-THIS-PLACEHOLDER-WITH-A-REAL-BCRYPT-HASH'
MONITORING_PASSWORD_HASH='{bcrypt}$2a$10$REPLACE-THIS-PLACEHOLDER-WITH-A-REAL-BCRYPT-HASH'
