    MIGRATION NOTES:
    
    This Spring Batch XML configuration migrates the following mainframe 
    batch processing components to cloud-native Java architecture:
    
    SOURCE JCL JOBS:
    - POSTTRAN.jcl (STEP15: EXEC PGM=CBTRN02C)
    - TRANFILE.jcl (VSAM file initialization and index management)
    - TRANREPT.jcl (STEP05R: SORT, STEP10R: EXEC PGM=CBTRN03C)
    
    SOURCE COBOL PROGRAMS:
    - CBTRN01C.cbl: Transaction data load with validation
    - CBTRN02C.cbl: Daily transaction posting with balance updates
    - CBTRN03C.cbl: Transaction report generation
    
    MAINFRAME FILE MAPPINGS TO SPRING BATCH RESOURCES:
    - DALYTRAN (DD DISP=SHR, Sequential) → FlatFileItemReader
    - TRANFILE (VSAM KSDS) → JPA TransactionRepository
    - XREFFILE (VSAM KSDS) → JPA CardXrefRepository  
    - ACCTFILE (VSAM KSDS) → JPA AccountRepository
    - TCATBALF (VSAM KSDS) → JPA TransactionCategoryRepository
    - DALYREJS (DD GDG+1, LRECL=430) → FlatFileItemWriter (rejects)
    
    PROCESSING WORKFLOW (3 STEPS):
    
    Step 1: loadDailyTransactionsStep
    - Reads daily transaction sequential file (LRECL=430 fixed format)
    - Validates card cross-reference (XREF lookup)
    - Validates account existence and status
    - Writes valid transactions to transaction master (PostgreSQL)
    - Writes invalid transactions to daily rejects file
    - Chunk size: 1000 records
    - Skip policy: Skip up to 100 validation errors before job failure
    
    Step 2: postTransactionsStep  
    - Processes posted transactions with account balance updates
    - Applies COMP-3 decimal precision (scale=2, RoundingMode.HALF_UP)
    - Updates transaction category balance aggregations
    - Maintains atomic transaction boundaries via @Transactional
    - Retry policy: 3 attempts with exponential backoff
    - Isolation level: READ_COMMITTED (CICS SYNCPOINT equivalent)
    
    Step 3: generateTransactionReportStep
    - Produces formatted transaction reports grouped by card number
    - Sorts by card number and date range (JCL SORT equivalent)
    - Generates report output with page breaks and totals
    - Report format: 133-character line (matching TRANREPT LRECL=133)
    
    PERFORMANCE REQUIREMENTS:
    - Batch window: < 4 hours (maintain mainframe SLA)
    - Transaction posting: < 200ms per transaction (95th percentile)
    - Checkpoint frequency: Every 1000 records (chunk size)
    - Concurrent processing: Disabled (sequential steps for data consistency)
    
    ERROR HANDLING:
    - Skip limit: 100 invalid records per step
    - Retry limit: 3 attempts for transient failures
    - Reject file: Daily rejects written with validation trailer (80 bytes)
    - Job restart: Enabled via JobRepository execution context
    
    DECIMAL PRECISION PRESERVATION:
    - COBOL COMP-3 S9(09)V99 → BigDecimal(precision=11, scale=2)
    - Rounding mode: HALF_UP (COBOL default rounding behavior)
    - All monetary calculations maintain penny precision
-->

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:batch="http://www.springframework.org/schema/batch"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           https://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/batch
           https://www.springframework.org/schema/batch/spring-batch.xsd">

    <!-- ========================================================================
         JOB DEFINITION: Daily Transaction Processing
         
         Executes three sequential steps:
         1. Load and validate daily transactions
         2. Post transactions with balance updates
         3. Generate transaction reports
         
         Job parameters:
         - transactionDate: Processing date (YYYY-MM-DD format)
         - inputFilePath: Daily transaction input file path
         - rejectFilePath: Reject output file path (default: daily-rejects-{date}.txt)
         - reportOutputPath: Report output path (default: transaction-report-{date}.txt)
    ========================================================================= -->
    
    <batch:job id="transactionProcessingJob" restartable="true">
        
        <!-- Step 1: Load Daily Transactions
             Migrates: CBTRN01C.cbl, CBTRN02C.cbl (load phase)
             Input: Daily transaction sequential file (DALYTRAN)
             Output: Transaction master (TRANSACT VSAM → PostgreSQL)
        -->
        <batch:step id="loadDailyTransactionsStep" next="postTransactionsStep">
            <batch:tasklet>
                <batch:chunk 
                    reader="dailyTransactionItemReader"
                    processor="transactionValidationProcessor"
                    writer="transactionItemWriter"
                    commit-interval="1000"
                    skip-limit="100">
                    
                    <!-- Skippable exceptions for validation failures -->
                    <batch:skippable-exception-classes>
                        <batch:include class="com.carddemo.exception.TransactionValidationException"/>
                        <batch:include class="com.carddemo.exception.CardNotFoundException"/>
                        <batch:include class="com.carddemo.exception.AccountNotFoundException"/>
                    </batch:skippable-exception-classes>
                    
                    <!-- Skip listener to write rejected records to DALYREJS file -->
                    <batch:listeners>
                        <batch:listener ref="transactionSkipListener"/>
                    </batch:listeners>
                </batch:chunk>
            </batch:tasklet>
        </batch:step>
        
        <!-- Step 2: Post Transactions with Balance Updates
             Migrates: CBTRN02C.cbl (posting phase)
             Processes: Account balance updates, category balance aggregation
             Transaction boundaries: @Transactional (CICS SYNCPOINT equivalent)
        -->
        <batch:step id="postTransactionsStep" next="generateTransactionReportStep">
            <batch:tasklet>
                <batch:chunk 
                    reader="unpostedTransactionItemReader"
                    processor="transactionPostingProcessor"
                    writer="accountBalanceUpdateWriter"
                    commit-interval="1000"
                    skip-limit="100">
                    
                    <!-- Retryable exceptions for transient database failures -->
                    <batch:retryable-exception-classes>
                        <batch:include class="org.springframework.dao.OptimisticLockingFailureException"/>
                        <batch:include class="org.springframework.dao.CannotAcquireLockException"/>
                        <batch:include class="org.springframework.dao.DeadlockLoserDataAccessException"/>
                    </batch:retryable-exception-classes>
                    
                    <!-- Retry policy: 3 attempts with exponential backoff -->
                    <batch:retry-policy>
                        <bean class="org.springframework.retry.policy.SimpleRetryPolicy">
                            <property name="maxAttempts" value="3"/>
                        </bean>
                    </batch:retry-policy>
                    
                    <batch:backoff-policy>
                        <bean class="org.springframework.retry.backoff.ExponentialBackOffPolicy">
                            <property name="initialInterval" value="1000"/>
                            <property name="multiplier" value="2.0"/>
                            <property name="maxInterval" value="10000"/>
                        </bean>
                    </batch:backoff-policy>
                    
                    <!-- Skippable exceptions for business validation failures -->
                    <batch:skippable-exception-classes>
                        <batch:include class="com.carddemo.exception.InsufficientBalanceException"/>
                        <batch:include class="com.carddemo.exception.AccountClosedException"/>
                    </batch:skippable-exception-classes>
                    
                    <batch:listeners>
                        <batch:listener ref="transactionPostingListener"/>
                    </batch:listeners>
                </batch:chunk>
            </batch:tasklet>
        </batch:step>
        
        <!-- Step 3: Generate Transaction Report
             Migrates: CBTRN03C.cbl, TRANREPT.jcl (SORT and report generation)
             Input: Posted transactions sorted by card number and date
             Output: Formatted report file (LRECL=133)
        -->
        <batch:step id="generateTransactionReportStep">
            <batch:tasklet>
                <batch:chunk 
                    reader="postedTransactionReportReader"
                    processor="transactionReportFormattingProcessor"
                    writer="transactionReportWriter"
                    commit-interval="1000">
                    
                    <batch:listeners>
                        <batch:listener ref="reportGenerationListener"/>
                    </batch:listeners>
                </batch:chunk>
            </batch:tasklet>
        </batch:step>
        
        <!-- Job execution listeners for logging and metrics -->
        <batch:listeners>
            <batch:listener ref="jobExecutionListener"/>
        </batch:listeners>
    </batch:job>

    <!-- ========================================================================
         STEP 1 COMPONENT DEFINITIONS: Load Daily Transactions
    ========================================================================= -->
    
    <!-- Daily Transaction Item Reader
         Migrates: COBOL SELECT DALYTRAN-FILE ASSIGN TO DALYTRAN
         File format: Fixed length records (LRECL=430)
         Record structure from CBTRN02C.cbl:
         - FD-TRAN-ID (16 bytes)
         - FD-CUST-DATA (334 bytes)
         - Total: 350 bytes + 80 byte validation trailer = 430 bytes
    -->
    <bean id="dailyTransactionItemReader" 
          class="org.springframework.batch.item.file.FlatFileItemReader"
          scope="step">
        <property name="resource" value="file:#{jobParameters['inputFilePath']}" />
        <property name="lineMapper">
            <bean class="org.springframework.batch.item.file.mapping.DefaultLineMapper">
                <property name="lineTokenizer">
                    <!-- Fixed-length tokenizer matching COBOL FD-TRAN-RECORD layout -->
                    <bean class="org.springframework.batch.item.file.transform.FixedLengthTokenizer">
                        <property name="names" value="transactionId,cardNumber,accountId,transactionType,
                                                     transactionCategory,transactionSource,transactionDesc,
                                                     transactionAmount,transactionDate,transactionTime,
                                                     merchantId,merchantName,merchantCity,merchantZip,
                                                     originalAmount,filler"/>
                        <property name="columns" value="1-16,17-32,33-43,44-45,46-49,50-51,52-101,
                                                       102-112,113-122,123-128,129-143,144-193,194-233,
                                                       234-242,243-253,254-350"/>
                        <property name="strict" value="false"/>
                    </bean>
                </property>
                <property name="fieldSetMapper">
                    <bean class="com.carddemo.batch.mapper.DailyTransactionFieldSetMapper"/>
                </property>
            </bean>
        </property>
        <property name="linesToSkip" value="0"/>
        <property name="strict" value="true"/>
    </bean>
    
    <!-- Transaction Validation Processor
         Migrates: CBTRN02C.cbl validation logic
         - Validates card cross-reference (XREFFILE lookup)
         - Validates account existence and status (ACCTFILE lookup)
         - Applies business rules from COBOL PROCEDURE DIVISION
         - Throws TransactionValidationException for invalid records
    -->
    <bean id="transactionValidationProcessor" 
          class="com.carddemo.batch.processor.TransactionValidationProcessor">
        <property name="cardXrefRepository" ref="cardXrefRepository"/>
        <property name="accountRepository" ref="accountRepository"/>
        <property name="validateCardXref" value="true"/>
        <property name="validateAccountStatus" value="true"/>
        <property name="strictValidation" value="true"/>
    </bean>
    
    <!-- Transaction Item Writer
         Migrates: COBOL WRITE TRANFILE (VSAM KSDS)
         Writes valid transactions to PostgreSQL transaction table
         Uses Spring Data JPA repository with transaction management
    -->
    <bean id="transactionItemWriter" 
          class="com.carddemo.batch.writer.TransactionItemWriter">
        <property name="transactionRepository" ref="transactionRepository"/>
        <property name="batchSize" value="1000"/>
    </bean>
    
    <!-- Transaction Skip Listener
         Migrates: COBOL WRITE DALYREJS-FILE
         Writes rejected transactions to daily rejects file
         Format: 350-byte transaction record + 80-byte validation trailer
    -->
    <bean id="transactionSkipListener" 
          class="com.carddemo.batch.listener.TransactionSkipListener"
          scope="step">
        <property name="rejectFileWriter">
            <bean class="org.springframework.batch.item.file.FlatFileItemWriter">
                <property name="resource" value="file:#{jobParameters['rejectFilePath']}" />
                <property name="lineAggregator">
                    <bean class="org.springframework.batch.item.file.transform.FormatterLineAggregator">
                        <property name="format" value="%-350s%-80s"/>
                        <property name="fieldExtractor">
                            <bean class="com.carddemo.batch.extractor.RejectRecordFieldExtractor"/>
                        </property>
                    </bean>
                </property>
                <property name="shouldDeleteIfExists" value="false"/>
                <property name="appendAllowed" value="true"/>
            </bean>
        </property>
        <property name="rejectionReasonFormatter" 
                  ref="validationReasonFormatter"/>
    </bean>

    <!-- ========================================================================
         STEP 2 COMPONENT DEFINITIONS: Post Transactions with Balance Updates
    ========================================================================= -->
    
    <!-- Unposted Transaction Item Reader
         Reads transactions that require posting to account balances
         Equivalent to reading TRANFILE where TRAN-POSTED-FLAG = 'N'
    -->
    <bean id="unpostedTransactionItemReader" 
          class="org.springframework.batch.item.database.JpaPagingItemReader"
          scope="step">
        <property name="entityManagerFactory" ref="entityManagerFactory"/>
        <property name="queryString" 
                  value="SELECT t FROM Transaction t 
                         WHERE t.postedFlag = false 
                         AND t.transactionDate = :transactionDate 
                         ORDER BY t.cardNumber, t.transactionId"/>
        <property name="parameterValues">
            <map>
                <entry key="transactionDate" value="#{jobParameters['transactionDate']}"/>
            </map>
        </property>
        <property name="pageSize" value="1000"/>
    </bean>
    
    <!-- Transaction Posting Processor
         Migrates: CBTRN02C.cbl transaction posting logic
         - Updates account balance with COMP-3 decimal precision
         - Updates transaction category balance (TCATBALF)
         - Applies COBOL arithmetic rules (BigDecimal scale=2, HALF_UP rounding)
         - Maintains transaction atomicity (@Transactional annotation)
    -->
    <bean id="transactionPostingProcessor" 
          class="com.carddemo.batch.processor.TransactionPostingProcessor">
        <property name="accountRepository" ref="accountRepository"/>
        <property name="transactionCategoryRepository" ref="transactionCategoryBalanceRepository"/>
        <property name="decimalScale" value="2"/>
        <property name="roundingMode" value="HALF_UP"/>
        <property name="validateBalance" value="true"/>
        <property name="createCategoryIfMissing" value="true"/>
    </bean>
    
    <!-- Account Balance Update Writer
         Writes updated account and category balances to PostgreSQL
         Equivalent to: REWRITE ACCTFILE-REC, REWRITE TRAN-CAT-BAL-RECORD
         Uses optimistic locking (@Version) to prevent lost updates
    -->
    <bean id="accountBalanceUpdateWriter" 
          class="com.carddemo.batch.writer.AccountBalanceUpdateWriter">
        <property name="accountRepository" ref="accountRepository"/>
        <property name="transactionRepository" ref="transactionRepository"/>
        <property name="transactionCategoryRepository" ref="transactionCategoryBalanceRepository"/>
        <property name="batchSize" value="1000"/>
    </bean>
    
    <!-- Transaction Posting Listener
         Logs transaction posting metrics and handles failures
         Tracks: WS-TRANSACTION-COUNT, WS-REJECT-COUNT from CBTRN02C
    -->
    <bean id="transactionPostingListener" 
          class="com.carddemo.batch.listener.TransactionPostingListener">
        <property name="metricsCollector" ref="batchMetricsCollector"/>
    </bean>

    <!-- ========================================================================
         STEP 3 COMPONENT DEFINITIONS: Generate Transaction Report
    ========================================================================= -->
    
    <!-- Posted Transaction Report Reader
         Migrates: TRANREPT.jcl SORT step and CBTRN03C.cbl sequential read
         Reads posted transactions sorted by card number and date range
         SQL ORDER BY replaces JCL SORT FIELDS=(TRAN-CARD-NUM,A)
    -->
    <bean id="postedTransactionReportReader" 
          class="org.springframework.batch.item.database.JpaPagingItemReader"
          scope="step">
        <property name="entityManagerFactory" ref="entityManagerFactory"/>
        <property name="queryString" 
                  value="SELECT t FROM Transaction t 
                         WHERE t.processedDate BETWEEN :startDate AND :endDate 
                         ORDER BY t.cardNumber ASC, t.transactionDate ASC, t.transactionId ASC"/>
        <property name="parameterValues">
            <map>
                <entry key="startDate" value="#{jobParameters['reportStartDate']}"/>
                <entry key="endDate" value="#{jobParameters['reportEndDate']}"/>
            </map>
        </property>
        <property name="pageSize" value="1000"/>
    </bean>
    
    <!-- Transaction Report Formatting Processor
         Migrates: CBTRN03C.cbl report formatting logic
         - Performs card cross-reference lookups (CARDXREF)
         - Looks up transaction type descriptions (TRANTYPE)
         - Looks up transaction category descriptions (TRANCATG)
         - Formats report lines with page breaks and totals
         - Implements control break logic for card number changes
    -->
    <bean id="transactionReportFormattingProcessor" 
          class="com.carddemo.batch.processor.TransactionReportFormattingProcessor">
        <property name="cardXrefRepository" ref="cardXrefRepository"/>
        <property name="transactionTypeRepository" ref="transactionTypeRepository"/>
        <property name="transactionCategoryRepository" ref="transactionCategoryRepository"/>
        <property name="pageSize" value="20"/>
        <property name="lineLength" value="133"/>
        <property name="calculateTotals" value="true"/>
    </bean>
    
    <!-- Transaction Report Writer
         Migrates: COBOL WRITE REPORT-FILE (LRECL=133, RECFM=FB)
         Writes formatted report to sequential file
         Output path: AWS.M2.CARDDEMO.TRANREPT(+1) → transaction-report-{date}.txt
    -->
    <bean id="transactionReportWriter" 
          class="org.springframework.batch.item.file.FlatFileItemWriter"
          scope="step">
        <property name="resource" value="file:#{jobParameters['reportOutputPath']}" />
        <property name="lineAggregator">
            <bean class="org.springframework.batch.item.file.transform.PassThroughLineAggregator"/>
        </property>
        <property name="shouldDeleteIfExists" value="true"/>
    </bean>
    
    <!-- Report Generation Listener
         Logs report generation completion and record counts
    -->
    <bean id="reportGenerationListener" 
          class="com.carddemo.batch.listener.ReportGenerationListener">
        <property name="metricsCollector" ref="batchMetricsCollector"/>
    </bean>

    <!-- ========================================================================
         SUPPORTING BEANS AND UTILITIES
    ========================================================================= -->
    
    <!-- Job Execution Listener
         Logs job start/end times, execution status, and performance metrics
         Maintains 4-hour batch window SLA monitoring
    -->
    <bean id="jobExecutionListener" 
          class="com.carddemo.batch.listener.JobExecutionListener">
        <property name="maxExecutionTimeMinutes" value="240"/>
        <property name="alertOnSlaBreach" value="true"/>
        <property name="metricsCollector" ref="batchMetricsCollector"/>
    </bean>
    
    <!-- Batch Metrics Collector
         Collects and reports batch processing metrics
         Tracks: record counts, processing time, error rates
    -->
    <bean id="batchMetricsCollector" 
          class="com.carddemo.batch.metrics.BatchMetricsCollector">
        <property name="meterRegistry" ref="meterRegistry"/>
        <property name="jobName" value="transactionProcessingJob"/>
    </bean>
    
    <!-- Validation Reason Formatter
         Formats validation failure reasons for reject file trailer
         Equivalent to WS-VALIDATION-FAIL-REASON and WS-VALIDATION-FAIL-REASON-DESC
    -->
    <bean id="validationReasonFormatter" 
          class="com.carddemo.batch.formatter.ValidationReasonFormatter">
        <property name="trailerLength" value="80"/>
        <property name="reasonCodeLength" value="4"/>
        <property name="reasonDescLength" value="76"/>
    </bean>

    <!-- ========================================================================
         REPOSITORY REFERENCES
         These beans are defined in the main application context
    ========================================================================= -->
    
    <!-- Transaction Repository (JPA) -->
    <bean id="transactionRepository" 
          class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="targetObject" ref="applicationContext"/>
        <property name="targetMethod" value="getBean"/>
        <property name="arguments">
            <list>
                <value>transactionRepository</value>
            </list>
        </property>
    </bean>
    
    <!-- Card Cross-Reference Repository (JPA) -->
    <bean id="cardXrefRepository" 
          class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="targetObject" ref="applicationContext"/>
        <property name="targetMethod" value="getBean"/>
        <property name="arguments">
            <list>
                <value>cardXrefRepository</value>
            </list>
        </property>
    </bean>
    
    <!-- Account Repository (JPA) -->
    <bean id="accountRepository" 
          class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="targetObject" ref="applicationContext"/>
        <property name="targetMethod" value="getBean"/>
        <property name="arguments">
            <list>
                <value>accountRepository</value>
            </list>
        </property>
    </bean>
    
    <!-- Transaction Category Balance Repository (JPA) -->
    <bean id="transactionCategoryBalanceRepository" 
          class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="targetObject" ref="applicationContext"/>
        <property name="targetMethod" value="getBean"/>
        <property name="arguments">
            <list>
                <value>transactionCategoryBalanceRepository</value>
            </list>
        </property>
    </bean>
    
    <!-- Transaction Type Repository (JPA) -->
    <bean id="transactionTypeRepository" 
          class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="targetObject" ref="applicationContext"/>
        <property name="targetMethod" value="getBean"/>
        <property name="arguments">
            <list>
                <value>transactionTypeRepository</value>
            </list>
        </property>
    </bean>
    
    <!-- Transaction Category Repository (JPA) -->
    <bean id="transactionCategoryRepository" 
          class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="targetObject" ref="applicationContext"/>
        <property name="targetMethod" value="getBean"/>
        <property name="arguments">
            <list>
                <value>transactionCategoryRepository</value>
            </list>
        </property>
    </bean>

</beans>
