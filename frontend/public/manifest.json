  "shortcuts": [
    {
      "name": "Upload Document",
      "short_name": "Upload",
      "description": "Quickly upload a new document for OCR processing",
      "url": "/documents/upload",
      "icons": [
        {
          "src": "/images/shortcut-upload.png",
          "sizes": "96x96",
