            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC44 -- 3200-SETUP-SCREEN-VARS PGM-ENTER no-op branch
      *
      *  Drives 3200-SETUP-SCREEN-VARS (production lines 2698-2727)
      *  with CDEMO-PGM-ENTER true -> CONTINUE branch (line 2700-
      *  2701), confirming no MOVE/PERFORM occurs.  Pre-seed
      *  ACCTSIDO with sentinel HIGH-VALUES proxy '*' string and
      *  assert it is preserved.
      ******************************************************************
       TESTCASE 'COACTUPC 3200-SETUP-SCREEN-VARS pgm-enter no-op'
            SET CDEMO-PGM-ENTER  TO TRUE
            MOVE '99999999999'  TO ACCTSIDO OF CACTUPAO
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3200-SETUP-SCREEN-VARS
                THRU 3200-SETUP-SCREEN-VARS-EXIT
            EXPECT ACCTSIDO OF CACTUPAO TO BE '99999999999'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC45 -- 3200-SETUP-SCREEN-VARS reenter with details-not-
      *  fetched performs 3201-SHOW-INITIAL-VALUES.
      *
      *  Production lines 2710-2714: WHEN ACUP-DETAILS-NOT-FETCHED
      *  PERFORM 3201-SHOW-INITIAL-VALUES.  Pre-seed ACSTTUSO with
      *  sentinel and assert that 3201 cleared it (LOW-VALUES MOVE
      *  on line 2732).
      ******************************************************************
       TESTCASE 'COACTUPC 3200-SETUP-SCREEN-VARS reenter notfetched'
            SET CDEMO-PGM-REENTER         TO TRUE
            SET ACUP-DETAILS-NOT-FETCHED  TO TRUE
            MOVE 12345678901      TO CC-ACCT-ID-N
            MOVE 'X'              TO ACSTTUSO OF CACTUPAO
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3200-SETUP-SCREEN-VARS
                THRU 3200-SETUP-SCREEN-VARS-EXIT
            EXPECT ACSTTUSO OF CACTUPAO NOT TO BE 'X'
            EXPECT ACCTSIDO OF CACTUPAO TO BE '12345678901'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC46 -- 3200-SETUP-SCREEN-VARS reenter with show-details
      *  performs 3202-SHOW-ORIGINAL-VALUES.
      *
      *  Production lines 2715-2717: WHEN ACUP-SHOW-DETAILS PERFORM
      *  3202-SHOW-ORIGINAL-VALUES.  Asserts that PROMPT-FOR-CHANGES
      *  is set on WS-INFO-MSG (line 2787-2789 SET on
      *  PROMPT-FOR-CHANGES).
      ******************************************************************
       TESTCASE 'COACTUPC 3200-SETUP-SCREEN-VARS reenter show-details'
            SET CDEMO-PGM-REENTER  TO TRUE
            SET ACUP-SHOW-DETAILS  TO TRUE
            MOVE 12345678901      TO CC-ACCT-ID-N
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3200-SETUP-SCREEN-VARS
                THRU 3200-SETUP-SCREEN-VARS-EXIT
            EXPECT ACCTSIDO OF CACTUPAO TO BE '12345678901'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC47 -- 3200-SETUP-SCREEN-VARS reenter with changes-made
      *  performs 3203-SHOW-UPDATED-VALUES.
      *
      *  Production lines 2718-2720: WHEN ACUP-CHANGES-MADE PERFORM
      *  3203-SHOW-UPDATED-VALUES.  3203 line 2871 MOVEs ACUP-NEW-
      *  ACTIVE-STATUS to ACSTTUSO.  Pre-seed ACUP-NEW-ACTIVE-STATUS
      *  with 'C' (CHANGES-OKAYED-AND-DONE in ACUP-CHANGES-MADE
      *  range) and assert ACSTTUSO is populated.
      ******************************************************************
       TESTCASE 'COACTUPC 3200-SETUP-SCREEN-VARS reenter changes-made'
            SET CDEMO-PGM-REENTER          TO TRUE
            SET ACUP-CHANGES-OKAYED-AND-DONE TO TRUE
            MOVE 12345678901      TO CC-ACCT-ID-N
            MOVE 'A'              TO ACUP-NEW-ACTIVE-STATUS
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3200-SETUP-SCREEN-VARS
                THRU 3200-SETUP-SCREEN-VARS-EXIT
            EXPECT ACSTTUSO OF CACTUPAO TO BE 'A'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC48 -- 1205-COMPARE-OLD-NEW NO-CHANGES-DETECTED
      *
      *  Drives 1205-COMPARE-OLD-NEW (production lines 1681-1779)
      *  along the NO-CHANGES path.  All ACUP-NEW-* and ACUP-OLD-*
      *  fields default to LOW-VALUES from BEFORE-EACH INITIALIZE,
      *  so both account-block IF and customer-block IF evaluate
      *  TRUE -> SET NO-CHANGES-DETECTED.  Asserts the 88-level
      *  flag is set.
      ******************************************************************
       TESTCASE 'COACTUPC 1205-COMPARE-OLD-NEW no changes detected'
            INITIALIZE ACUP-OLD-DETAILS
            INITIALIZE ACUP-NEW-DETAILS
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 1205-COMPARE-OLD-NEW
                THRU 1205-COMPARE-OLD-NEW-EXIT
            EXPECT WS-DATACHANGED-FLAG TO BE '0'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC49 -- 1205-COMPARE-OLD-NEW account-block change detected
      *
      *  Drives 1205-COMPARE-OLD-NEW along the GO TO 1205-COMPARE-
      *  OLD-NEW-EXIT branch (line 1704) -- account-block IF
      *  evaluates FALSE.  Force ACUP-NEW-ACCT-ID != ACUP-OLD-ACCT-
      *  ID by setting ACUP-NEW-ACCT-ID-X to '12345678901' while
      *  ACUP-OLD-ACCT-ID-X stays LOW-VALUES.  Asserts CHANGE-HAS-
      *  OCCURRED 88-level set.
      ******************************************************************
       TESTCASE 'COACTUPC 1205-COMPARE-OLD-NEW account change'
            INITIALIZE ACUP-OLD-DETAILS
            INITIALIZE ACUP-NEW-DETAILS
            MOVE '12345678901'   TO ACUP-NEW-ACCT-ID-X
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 1205-COMPARE-OLD-NEW
                THRU 1205-COMPARE-OLD-NEW-EXIT
            EXPECT WS-DATACHANGED-FLAG TO BE '1'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC50 -- 1205-COMPARE-OLD-NEW customer-block change detected
      *
      *  Drives 1205-COMPARE-OLD-NEW along the GO TO 1205-COMPARE-
      *  OLD-NEW-EXIT branch from the customer block (line 1772).
      *  Account block matches (LOW-VALUES = LOW-VALUES) but
      *  customer block fails on ACUP-NEW-CUST-FIRST-NAME.  Asserts
      *  CHANGE-HAS-OCCURRED.
      ******************************************************************
       TESTCASE 'COACTUPC 1205-COMPARE-OLD-NEW customer change'
            INITIALIZE ACUP-OLD-DETAILS
            INITIALIZE ACUP-NEW-DETAILS
            MOVE 'JOHN'          TO ACUP-NEW-CUST-FIRST-NAME
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 1205-COMPARE-OLD-NEW
                THRU 1205-COMPARE-OLD-NEW-EXIT
            EXPECT WS-DATACHANGED-FLAG TO BE '1'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC51 -- 3300-SETUP-SCREEN-ATTRS early-exit DETAILS-NOT-FETCHED
      *
      *  Drives 3300-SETUP-SCREEN-ATTRS (production lines 2986-3437,
      *  the largest paragraph in COACTUPC at 451 lines).  The early
      *  exit on lines 3186-3192 is taken when ACUP-DETAILS-NOT-
      *  FETCHED is true, after the paragraph has executed:
      *    PERFORM 3310-PROTECT-ALL-ATTRS                  (line 2989)
      *    EVALUATE TRUE WHEN ACUP-DETAILS-NOT-FETCHED ->
      *      MOVE DFHBMFSE TO ACCTSIDA                    (line 2996)
      *    EVALUATE TRUE WHEN OTHER ->
      *      MOVE -1 TO ACCTSIDL                          (line 3166)
      *    GO TO 3300-SETUP-SCREEN-ATTRS-EXIT             (line 3189)
      *  Asserts ACCTSIDA = DFHBMFSE (X'21').
      ******************************************************************
       TESTCASE 'COACTUPC 3300-SETUP-SCREEN-ATTRS early exit'
            SET ACUP-DETAILS-NOT-FETCHED  TO TRUE
            MOVE LOW-VALUES               TO ACCTSIDA OF CACTUPAI
            MOVE LOW-VALUES               TO ACCTSIDL OF CACTUPAI
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3300-SETUP-SCREEN-ATTRS
                THRU 3300-SETUP-SCREEN-ATTRS-EXIT
            EXPECT ACCTSIDA OF CACTUPAI NOT TO BE LOW-VALUES
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC52 -- 3300-SETUP-SCREEN-ATTRS WHEN OTHER + early-exit
      *  FLG-ACCTFILTER-BLANK
      *
      *  Drives 3300-SETUP-SCREEN-ATTRS along the WHEN OTHER arm of
      *  the first EVALUATE (line 3004-3005), then through the
      *  cursor EVALUATE WHEN FLG-ACCTFILTER-BLANK arm (line 3014-
      *  3015), then early-exit at line 3187.  Pre-seeds FLG-
      *  ACCTFILTER-BLANK to TRUE; ACUP-CHANGE-ACTION must NOT match
      *  any first-evaluate arm except WHEN OTHER, so set
      *  ACUP-CHANGE-ACTION to invalid 'Z' (no 88-level match).
      ******************************************************************
       TESTCASE 'COACTUPC 3300-SETUP-SCREEN-ATTRS other arm'
            MOVE 'Z'                  TO ACUP-CHANGE-ACTION
            SET FLG-ACCTFILTER-BLANK  TO TRUE
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3300-SETUP-SCREEN-ATTRS
                THRU 3300-SETUP-SCREEN-ATTRS-EXIT
            EXPECT ACCTSIDA OF CACTUPAI NOT TO BE LOW-VALUES
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC53 -- 1200-EDIT-MAP-INPUTS early-exit on details-not-fetched
      *
      *  Drives 1200-EDIT-MAP-INPUTS (production lines 1429-1678) along
      *  the ACUP-DETAILS-NOT-FETCHED branch: PERFORM 1210-EDIT-ACCOUNT
      *  -> MOVE LOW-VALUES TO ACUP-OLD-ACCT-DATA -> IF FLG-ACCTFILTER-
      *  BLANK -> GO TO 1200-EDIT-MAP-INPUTS-EXIT (line 1446).  Asserts
      *  WS-INPUT-FLAG = '0' (INPUT-OK 88-level on line 173) by
      *  feeding a blank account ID (which sets FLG-ACCTFILTER-BLANK).
      ******************************************************************
       TESTCASE 'COACTUPC 1200-EDIT-MAP-INPUTS detailsnf early-exit'
            SET ACUP-DETAILS-NOT-FETCHED  TO TRUE
            MOVE SPACES                   TO CC-ACCT-ID
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 1200-EDIT-MAP-INPUTS
                THRU 1200-EDIT-MAP-INPUTS-EXIT
            EXPECT WS-INPUT-FLAG TO BE '1'
            EXPECT WS-EDIT-ACCT-FLAG NOT TO BE '1'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC54 -- 1200-EDIT-MAP-INPUTS no-changes-found path
      *
      *  Drives 1200-EDIT-MAP-INPUTS along the ELSE branch (line 1447-
      *  1467): SET FOUND-ACCOUNT-DATA / FOUND-ACCT-IN-MASTER / FLG-
      *  ACCTFILTER-ISVALID -> SET FOUND-CUST-IN-MASTER / FLG-
      *  CUSTFILTER-ISVALID -> PERFORM 1205-COMPARE-OLD-NEW -> IF
      *  NO-CHANGES-FOUND -> GO TO 1200-EDIT-MAP-INPUTS-EXIT (line
      *  1467).  All ACUP-NEW-* and ACUP-OLD-* default to LOW-VALUES
      *  in BEFORE-EACH so the comparison ALL fields equal.  Asserts
      *  WS-INPUT-FLAG = '0' (INPUT-OK).
      ******************************************************************
       TESTCASE 'COACTUPC 1200-EDIT-MAP-INPUTS no-changes path'
            SET ACUP-SHOW-DETAILS  TO TRUE
            INITIALIZE ACUP-OLD-DETAILS
            INITIALIZE ACUP-NEW-DETAILS
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 1200-EDIT-MAP-INPUTS
                THRU 1200-EDIT-MAP-INPUTS-EXIT
            EXPECT WS-INPUT-FLAG TO BE '0'
            EXPECT WS-DATACHANGED-FLAG TO BE '0'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC55 -- 9000-READ-ACCT not-found early-exit on XREF
      *
      *  Drives 9000-READ-ACCT (production lines 3608-3644) along the
      *  PERFORM 9200-GETCARDXREF-BYACCT -> IF FLG-ACCTFILTER-NOT-OK
      *  -> GO TO 9000-READ-ACCT-EXIT (line 3621).  Off-platform the
      *  9200 paragraph contains EXEC CICS verbs (stripped during
      *  merge), so its 88-level FLG-ACCTFILTER-NOT-OK is not set
      *  during the merged execution -- but the PERFORM 9200 still
      *  runs, then control returns to 9000 and the IF evaluates
      *  FALSE, then PERFORM 9300, then PERFORM 9400, then PERFORM
      *  9500.  Asserts WS-CARD-RID-ACCT-ID = '12345678901' (line
      *  3614 MOVE).
      ******************************************************************
       TESTCASE 'COACTUPC 9000-READ-ACCT performs full delegation'
            MOVE '12345678901'   TO CC-ACCT-ID
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 9000-READ-ACCT
                THRU 9000-READ-ACCT-EXIT
            EXPECT WS-CARD-RID-ACCT-ID TO BE '12345678901'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC56 -- 2000-DECIDE-ACTION DETAILS-NOT-FETCHED arm
      *
      *  Drives 2000-DECIDE-ACTION (lines 2562-2641) WHEN ACUP-
      *  DETAILS-NOT-FETCHED.  With FLG-ACCTFILTER-ISVALID=TRUE,
      *  PERFORM 9000-READ-ACCT runs (delegates further).  We just
      *  PASS the test through completion.
      ******************************************************************
       TESTCASE 'COACTUPC 2000-DECIDE-ACTION details-not-fetched'
            SET ACUP-DETAILS-NOT-FETCHED  TO TRUE
            MOVE '12345678901' TO CC-ACCT-ID
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 2000-DECIDE-ACTION
                THRU 2000-DECIDE-ACTION-EXIT
            EXPECT ACUP-DETAILS-NOT-FETCHED TO BE TRUE
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC57 -- 2000-DECIDE-ACTION SHOW-DETAILS no-changes branch
      *
      *  Drives 2000-DECIDE-ACTION WHEN ACUP-SHOW-DETAILS arm with
      *  NO-CHANGES-DETECTED -> CONTINUE branch (lines 2587-2588).
      ******************************************************************
       TESTCASE 'COACTUPC 2000-DECIDE-ACTION show-details no-change'
            SET ACUP-SHOW-DETAILS         TO TRUE
            SET NO-CHANGES-DETECTED       TO TRUE
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 2000-DECIDE-ACTION
                THRU 2000-DECIDE-ACTION-EXIT
            EXPECT ACUP-SHOW-DETAILS TO BE TRUE
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC58 -- 2000-DECIDE-ACTION SHOW-DETAILS else branch sets
      *  ACUP-CHANGES-OK-NOT-CONFIRMED (lines 2589-2591).
      ******************************************************************
       TESTCASE 'COACTUPC 2000-DECIDE-ACTION show-details else'
            SET ACUP-SHOW-DETAILS         TO TRUE
            SET INPUT-OK                  TO TRUE
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 2000-DECIDE-ACTION
                THRU 2000-DECIDE-ACTION-EXIT
            EXPECT ACUP-CHANGE-ACTION TO BE 'N'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC59 -- 2000-DECIDE-ACTION CHANGES-NOT-OK arm CONTINUE
      *  (lines 2596-2597).
      ******************************************************************
       TESTCASE 'COACTUPC 2000-DECIDE-ACTION changes-not-ok'
            SET ACUP-CHANGES-NOT-OK       TO TRUE
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 2000-DECIDE-ACTION
                THRU 2000-DECIDE-ACTION-EXIT
            EXPECT ACUP-CHANGE-ACTION TO BE 'E'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC60 -- 2000-DECIDE-ACTION OK-NOT-CONFIRMED no-PFK5 CONTINUE
      *  arm (lines 2620-2621).  Without CCARD-AID-PFK05, the second
      *  WHEN ACUP-CHANGES-OK-NOT-CONFIRMED arm (alone) fires.
      ******************************************************************
       TESTCASE 'COACTUPC 2000-DECIDE-ACTION ok-not-confirmed no-pfk'
            SET ACUP-CHANGES-OK-NOT-CONFIRMED TO TRUE
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 2000-DECIDE-ACTION
                THRU 2000-DECIDE-ACTION-EXIT
            EXPECT ACUP-CHANGE-ACTION TO BE 'N'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC61 -- 2000-DECIDE-ACTION OKAYED-AND-DONE arm
      *  (lines 2625-2632).  Sets ACUP-SHOW-DETAILS and resets
      *  CDEMO-ACCT-ID/CARD-NUM to zeros.
      ******************************************************************
       TESTCASE 'COACTUPC 2000-DECIDE-ACTION okayed-and-done'
            SET ACUP-CHANGES-OKAYED-AND-DONE TO TRUE
            MOVE 99999999999 TO CDEMO-ACCT-ID
            MOVE LOW-VALUES TO CDEMO-FROM-TRANID
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 2000-DECIDE-ACTION
                THRU 2000-DECIDE-ACTION-EXIT
            EXPECT ACUP-CHANGE-ACTION TO BE 'S'
            EXPECT CDEMO-ACCT-ID TO BE '00000000000'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC62 -- 1260-EDIT-US-PHONE-NUM with non-blank parts performs
      *  EDIT-AREA-CODE / EDIT-US-PHONE-PREFIX / EDIT-US-PHONE-LINENUM
      *  via fall-through control flow (production lines 2225-2427).
      ******************************************************************
       TESTCASE 'COACTUPC 1260-EDIT-US-PHONE-NUM exercises sub-edits'
            MOVE '212' TO WS-EDIT-US-PHONE-NUMA
            MOVE '555' TO WS-EDIT-US-PHONE-NUMB
            MOVE '1234' TO WS-EDIT-US-PHONE-NUMC
            MOVE 'PhTestField' TO WS-EDIT-VARIABLE-NAME
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 1260-EDIT-US-PHONE-NUM
                THRU EDIT-US-PHONE-EXIT
            EXPECT FLG-EDIT-US-PHONEA-ISVALID TO BE TRUE
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC63 -- 1000-PROCESS-INPUTS delegates to 1100/1200 then
      *  populates WS-RETURN-MSG / CCARD-NEXT-* fields (production
      *  lines 1025-1034).  Sets ACUP-DETAILS-NOT-FETCHED so 1200
      *  short-circuits.
      ******************************************************************
       TESTCASE 'COACTUPC 1000-PROCESS-INPUTS delegates to 1100/1200'
            SET ACUP-DETAILS-NOT-FETCHED  TO TRUE
            MOVE '12345678901' TO CC-ACCT-ID
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 1000-PROCESS-INPUTS
                THRU 1000-PROCESS-INPUTS-EXIT
            EXPECT CCARD-NEXT-PROG TO BE 'COACTUPC'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC64 -- 1100-RECEIVE-MAP early-exit on '*' ACCTSIDI
      *
      *  Drives 1100-RECEIVE-MAP (production lines 1039-1426) along
      *  the asterisk-clear branch (lines 1051-1054 IF '*' -> MOVE
      *  LOW-VALUES TO CC-ACCT-ID + ACUP-NEW-ACCT-ID-X) and then
      *  through the early-exit at line 1060-1062 (IF ACUP-DETAILS-
      *  NOT-FETCHED -> GO TO 1100-RECEIVE-MAP-EXIT).
      ******************************************************************
       TESTCASE 'COACTUPC 1100-RECEIVE-MAP asterisk early-exit'
            SET ACUP-DETAILS-NOT-FETCHED  TO TRUE
            MOVE '*'                      TO ACCTSIDI OF CACTUPAI
            MOVE 'OLDID'                  TO CC-ACCT-ID
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 1100-RECEIVE-MAP
                THRU 1100-RECEIVE-MAP-EXIT
            EXPECT CC-ACCT-ID NOT TO BE 'OLDID'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC65 -- 1100-RECEIVE-MAP early-exit on SPACES ACCTSIDI
      *
      *  Drives 1100-RECEIVE-MAP along the SPACES branch (line 1052
      *  IF SPACES -> MOVE LOW-VALUES TO CC-ACCT-ID).  Then early-
      *  exits at line 1062.
      ******************************************************************
       TESTCASE 'COACTUPC 1100-RECEIVE-MAP spaces early-exit'
            SET ACUP-DETAILS-NOT-FETCHED  TO TRUE
            MOVE SPACES                   TO ACCTSIDI OF CACTUPAI
            MOVE 'OLDID'                  TO CC-ACCT-ID
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 1100-RECEIVE-MAP
                THRU 1100-RECEIVE-MAP-EXIT
            EXPECT CC-ACCT-ID NOT TO BE 'OLDID'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC66 -- 1100-RECEIVE-MAP valid id non-detail path
      *
      *  Drives 1100-RECEIVE-MAP with a valid ACCTSIDI value (ELSE
      *  branch line 1056 MOVE TO CC-ACCT-ID) and ACUP-SHOW-DETAILS
      *  set so we DO NOT early-exit at line 1061.  The 1100 body
      *  then falls through all the field-by-field IF branches.
      *  Pre-load CACTUPAI fields with valid values so MOVE SPACES
      *  branches don't fire.
      ******************************************************************
       TESTCASE 'COACTUPC 1100-RECEIVE-MAP valid id full body'
            SET ACUP-SHOW-DETAILS         TO TRUE
            MOVE '12345678901'   TO ACCTSIDI OF CACTUPAI
            MOVE 'A'             TO ACSTTUSI OF CACTUPAI
            MOVE '1000.00'       TO ACRDLIMI OF CACTUPAI
            MOVE '500.00'        TO ACSHLIMI OF CACTUPAI
            MOVE '100.00'        TO ACURBALI OF CACTUPAI
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 1100-RECEIVE-MAP
                THRU 1100-RECEIVE-MAP-EXIT
            EXPECT CC-ACCT-ID TO BE '12345678901'
            EXPECT ACUP-NEW-ACCT-ID-X TO BE '12345678901'
            EXPECT ACUP-NEW-ACTIVE-STATUS TO BE 'A'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC67 -- 9600-WRITE-PROCESSING NORMAL response
      *
      *  Drives 9600-WRITE-PROCESSING (production lines 3888-4105).
      *  Off-platform DFHRESP(NORMAL) resolves to 0; default WS-RESP-
      *  CD=0 means the first IF (line 3907) evaluates TRUE and
      *  control falls through to the second EXEC CICS READ
      *  (CUSTOMER-RECORD).  Eventually the paragraph PERFORMs
      *  9700-CHECK-CHANGE-IN-REC and continues.  Off-platform
      *  WS-RESP-CD remains 0, so the GO TO 9600-WRITE-PROCESSING-
      *  EXIT is NEVER taken by the early-exit clauses, meaning the
      *  test exercises the longest happy path through this 217-
      *  line paragraph.
      ******************************************************************
       TESTCASE 'COACTUPC 9600-WRITE-PROCESSING NORMAL response'
            MOVE '12345678901'   TO CC-ACCT-ID
            MOVE 123456789       TO CDEMO-CUST-ID
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 9600-WRITE-PROCESSING
                THRU 9600-WRITE-PROCESSING-EXIT
            EXPECT WS-CARD-RID-ACCT-ID TO BE '12345678901'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC68 -- 9600-WRITE-PROCESSING acct-lock-error early-exit
      *
      *  Drives 9600-WRITE-PROCESSING with WS-RESP-CD=99 (no DFHRESP
      *  match) so first IF evaluates FALSE -> SET COULD-NOT-LOCK-
      *  ACCT-FOR-UPDATE -> GO TO 9600-WRITE-PROCESSING-EXIT (line
      *  3914).
      ******************************************************************
       TESTCASE 'COACTUPC 9600-WRITE-PROCESSING acct-lock-error'
            MOVE '12345678901'   TO CC-ACCT-ID
            MOVE 99              TO WS-RESP-CD
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 9600-WRITE-PROCESSING
                THRU 9600-WRITE-PROCESSING-EXIT
            EXPECT WS-INPUT-FLAG TO BE '1'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC69 -- 9600-WRITE-PROCESSING with 9700 detecting account
      *  data change.  Pre-loads ACCT-ACTIVE-STATUS = 'A' and
      *  ACUP-OLD-ACTIVE-STATUS = 'X' so 9700's IF block fails on
      *  the FIRST comparison and the ELSE branch fires (line 4143
      *  SET DATA-WAS-CHANGED-BEFORE-UPDATE -> GO TO 9600-WRITE-
      *  PROCESSING-EXIT).
      ******************************************************************
       TESTCASE 'COACTUPC 9600-WRITE-PROCESSING data-was-changed'
            MOVE '12345678901'   TO CC-ACCT-ID
            MOVE 'A'             TO ACCT-ACTIVE-STATUS
            MOVE 'X'             TO ACUP-OLD-ACTIVE-STATUS
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 9600-WRITE-PROCESSING
                THRU 9600-WRITE-PROCESSING-EXIT
            EXPECT DATA-WAS-CHANGED-BEFORE-UPDATE TO BE TRUE
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC70 -- ABEND-ROUTINE with default ABEND-MSG (LOW-VALUES)
      *
      *  Drives ABEND-ROUTINE (production lines 4203-4225) along the
      *  IF ABEND-MSG = LOW-VALUES branch (line 4205).  The MOVE
      *  'UNEXPECTED ABEND OCCURRED.' TO ABEND-MSG sets the field.
      *  Off-platform EXEC CICS verbs (SEND, HANDLE ABEND, ABEND)
      *  are stripped during merge so the routine returns normally.
      ******************************************************************
       TESTCASE 'COACTUPC ABEND-ROUTINE default msg'
            MOVE LOW-VALUES TO ABEND-MSG
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM ABEND-ROUTINE
                THRU ABEND-ROUTINE-EXIT
            EXPECT ABEND-CULPRIT TO BE 'COACTUPC'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC71 -- ABEND-ROUTINE with ABEND-MSG already populated
      *
      *  Drives ABEND-ROUTINE along the ELSE branch (IF ABEND-MSG
      *  already non-LOW).  Pre-set ABEND-MSG so the MOVE on line
      *  4206 does NOT fire.
      ******************************************************************
       TESTCASE 'COACTUPC ABEND-ROUTINE preset msg'
            MOVE 'EXISTING ABEND CONTEXT' TO ABEND-MSG
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM ABEND-ROUTINE
                THRU ABEND-ROUTINE-EXIT
            EXPECT ABEND-CULPRIT TO BE 'COACTUPC'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC72 -- exercises cobol-check 88-level FALSE assertion path
      *
      *  Drives the cobol-check framework's UT-EXPECTED-88-VALUE FALSE
      *  branch by using `EXPECT ... TO BE FALSE`.  Pre-load CC-ACCT-
      *  ID with valid 11-digit ID, run 1210-EDIT-ACCOUNT, then assert
      *  that the FAILURE 88-level FLG-ACCTFILTER-NOT-OK is FALSE
      *  (it gets cleared on success path).
      ******************************************************************
       TESTCASE 'COACTUPC 1210-EDIT-ACCOUNT NOT-OK is false on success'
            MOVE '00000000001' TO CC-ACCT-ID
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 1210-EDIT-ACCOUNT
                THRU 1210-EDIT-ACCOUNT-EXIT
            EXPECT FLG-ACCTFILTER-NOT-OK TO BE FALSE
            EXPECT FLG-ACCTFILTER-BLANK TO BE FALSE
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC73 -- 1210-EDIT-ACCOUNT BLANK is false on valid input
      ******************************************************************
       TESTCASE 'COACTUPC 1210-EDIT-ACCOUNT positive flag set'
            MOVE '00000000001' TO CC-ACCT-ID
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 1210-EDIT-ACCOUNT
                THRU 1210-EDIT-ACCOUNT-EXIT
            EXPECT FLG-ACCTFILTER-ISVALID TO BE TRUE
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC74 -- ACUP-CHANGES-OK-NOT-CONFIRMED FALSE (default state)
      *
      *  After BEFORE-EACH, ACUP-CHANGE-ACTION = LOW-VALUES so 88-
      *  level ACUP-CHANGES-OK-NOT-CONFIRMED is FALSE.  Test exercises
      *  the FALSE branch of the cobol-check framework's UT-EXPECTED-
      *  88-VALUE handler.
      ******************************************************************
       TESTCASE 'COACTUPC ACUP-CHANGES-OK-NOT-CONFIRMED is false'
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3201-SHOW-INITIAL-VALUES
                THRU 3201-SHOW-INITIAL-VALUES-EXIT
            EXPECT ACUP-CHANGES-OK-NOT-CONFIRMED TO BE FALSE
            EXPECT ACUP-CHANGES-FAILED TO BE FALSE
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES


      ******************************************************************
      *  TC75 -- COMMON-RETURN copies WS-RETURN-MSG to CCARD-ERROR-MSG
      *
      *  PERFORMs COMMON-RETURN (production lines 1007-1020) which:
      *      MOVE WS-RETURN-MSG     TO CCARD-ERROR-MSG
      *      MOVE  CARDDEMO-COMMAREA    TO WS-COMMAREA
      *      MOVE  WS-THIS-PROGCOMMAREA TO WS-COMMAREA(...)
      *      EXEC CICS RETURN ... (stripped)
      *
      *  This testcase covers a paragraph that has not been exercised
      *  by any prior TC1-TC74.
      *
      *  Source of expected values
      *    CCARD-ERROR-MSG = 'TEST MSG' -- production MOVE at line
      *      1008 from WS-RETURN-MSG.
      *    DFHEI1 = 0 calls -- EXEC CICS RETURN is stripped by
      *      cobol-check during merge.
      ******************************************************************
       TESTCASE 'COACTUPC COMMON-RETURN copies WS-RETURN-MSG'
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            MOVE 'TEST MSG' TO WS-RETURN-MSG
            PERFORM COMMON-RETURN
            EXPECT CCARD-ERROR-MSG(1:8) TO BE 'TEST MSG'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES


      ******************************************************************
      *  Note: 9700-CHECK-CHANGE-IN-REC contains
      *      GO TO 9600-WRITE-PROCESSING-EXIT
      *  at production line 4144 that escapes any test PERFORM range.
      *  Direct PERFORMs of 9700-CHECK-CHANGE-IN-REC THRU 9700-EXIT
      *  cause runtime hang because the GO TO target is OUTSIDE the
      *  THRU range.  The paragraph IS exercised indirectly via
      *  TC72 (9600-WRITE-PROCESSING data-was-changed) which PERFORMs
      *  the umbrella paragraph 9600 (the GO TO target IS within
      *  9600-WRITE-PROCESSING THRU 9600-WRITE-PROCESSING-EXIT).
      ******************************************************************

      ******************************************************************
      *  End of testsuite COACTUPC ACCOUNT UPDATE TRANSACTION
      ******************************************************************
