# =============================================================================
# CardDemo Modernized Monorepo - Root .gitignore
# -----------------------------------------------------------------------------
# One root ignore file for the whole monorepo:
#   * backend/  - Python FastAPI service
#   * batch/    - Python CLI batch package
#   * frontend/ - Next.js + TypeScript SPA
# The legacy mainframe app/ tree is a TRACKED reference and is deliberately
# NOT ignored by any rule below.
#
# Ochs Rule #3 (no hardcoding secrets): real environment files (.env,
# .env.local and their variants) are ignored so credentials are never
# committed, while the committed *.example templates stay tracked via the
# explicit negation rules in the "Environment / Secrets" section.
# =============================================================================

# -----------------------------------------------------------------------------
# Python - backend/ and batch/
# -----------------------------------------------------------------------------

# Byte-compiled / optimized / DLL / cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Packaging / build artifacts
*.egg-info/
.eggs/
dist/
build/
wheels/
*.egg

# Test, coverage, and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nose2-junit.xml
coverage.xml

# Misc Python tooling
.dmypy.json
pip-log.txt

# -----------------------------------------------------------------------------
# Node.js / Next.js - frontend/
# -----------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js / bundler build output
# (build/ is already ignored in the Python section above; being non-anchored
#  it applies to the frontend too, so it is not repeated here.)
.next/
out/
.turbo/

# npm lock file — TRACKED for reproducible, locked installs (QA finding M-08).
# The lockfile pins the entire transitive dependency tree (not just the direct
# ranges in package.json), so `npm ci` reproduces an identical node_modules on
# every checkout and in every image build. It is intentionally NOT ignored; the
# frontend Dockerfile uses `npm ci` when it is present. (Previously ignored under
# a setup-time policy that left builds dependent on floating range resolution.)

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test coverage
coverage/

# TypeScript build info + Next.js generated types
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# -----------------------------------------------------------------------------
# Environment / Secrets  (Ochs Rule #3 - CRITICAL: never commit real secrets)
# -----------------------------------------------------------------------------
# Ignore every real environment file, in any directory ...
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# ... but ALWAYS keep the committed example templates tracked. These negations
# come AFTER the ignore rules so they win for the same path, and the parent
# dirs (backend/, frontend/) are never ignored, so the un-ignore takes effect.
# Covers backend/.env.example and frontend/.env.local.example.
!.env.example
!.env.*.example
!*.env.example
!backend/.env.example
!frontend/.env.local.example

# -----------------------------------------------------------------------------
# IDE / Editor / OS
# -----------------------------------------------------------------------------

# IDEs
.vscode/
.idea/
*.iml

# Operating-system cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor swap / backup files
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Docker / Logs / Misc
# -----------------------------------------------------------------------------
# NOTE: docker-compose.yml itself is TRACKED; only local overrides are ignored.
docker-compose.override.yml

# Logs
*.log
logs/

# Process id files
*.pid

# -----------------------------------------------------------------------------
# Agent / QA validation artifacts (never committed)
# -----------------------------------------------------------------------------
# Browser-validation screenshots and screen recordings produced during
# runtime/visual QA are evidence artifacts, not source; keep them out of the
# repository.
blitzy/
