# CardDemo Frontend — environment template. Copy to `.env.local` (gitignored, never committed).

# Public base URL of the backend REST API (exposed to the browser).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Internal backend URL used by Next.js server-side rewrites.
# In docker-compose this is the backend service name: http://backend:8000
BACKEND_INTERNAL_URL=http://localhost:8000
