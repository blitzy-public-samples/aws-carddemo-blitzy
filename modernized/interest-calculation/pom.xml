<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.blitzy.carddemo</groupId>
    <artifactId>interest-calculation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>CardDemo Interest Calculation (CBACT04C Java Port)</name>
    <description>
        Standalone Java 21 port of the COBOL batch program CBACT04C
        (the interest-calculation job executed by app/jcl/INTCALC.jcl).
        Depends only on the JDK and JUnit 5; no Spring, application server,
        database, ORM, messaging, or network. Entry point:
        com.blitzy.carddemo.interest.InterestCalculator.
    </description>

    <properties>
        <!-- Java 21 (LTS) pins both source and target via a single property (AAP 0.5.1). -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Single-source-of-truth version pins (all exact; no LATEST/RELEASE/ranges). -->
        <junit.version>5.13.4</junit.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    </properties>

    <dependencies>
        <!--
            JUnit 5 (Jupiter) aggregator: pulls junit-jupiter-api, -params, and
            -engine transitively. TEST scope only => the module has ZERO
            compile/runtime dependencies and the packaged jar runs on the bare JDK.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compile via maven.compiler.release=21 (no extra configuration needed). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>

            <!-- Runs the JUnit 5 (Jupiter) tests on `mvn test`; provider auto-detected. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>

            <!-- Executable jar: sets Main-Class for `java -jar ... <inputs> <outputs> <parm-date>`. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.blitzy.carddemo.interest.InterestCalculator</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
