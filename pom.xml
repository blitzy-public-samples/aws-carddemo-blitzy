<?xml version="1.0" encoding="UTF-8"?>
<!--
    CardDemo - Spring Boot 3.2 Modernization

    Migrated from the original COBOL/CICS/VSAM mainframe application.
    Functional parity preserved for CBACT04C (interest calculation),
    CBTRN02C (transaction posting), and CBSTM03A (statement generation).

    Dependency inventory follows the Agent Action Plan section 0.5.1 exactly.
    All transitive versions are resolved via spring-boot-starter-parent 3.2.12 BOM,
    sourced from Maven Central; no private package registry is used.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 3.2.12 parent (final OSS release of the 3.2 branch).
        Acts as the Bill of Materials (BOM) resolving Spring Framework 6.1.x,
        Spring Security 6.2.x, Spring Batch 5.1.x, Hibernate ORM 6.4.x,
        Tomcat 10.1.x, Jackson 2.15.x, Flyway 9.22.x, Lombok, PostgreSQL JDBC,
        and Testcontainers. The empty <relativePath/> forces lookup of the
        parent POM from the configured repositories rather than the filesystem.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.carddemo</groupId>
    <artifactId>carddemo</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>CardDemo</name>
    <description>CardDemo Spring Boot 3.2 modernization of the legacy COBOL/CICS/VSAM mainframe application. Java services preserve 100% of the original business logic with parity tests for CBACT04C (interest), CBTRN02C (transaction posting), and CBSTM03A (statement generation).</description>

    <properties>
        <!-- Java 17 is the Spring Boot 3.x baseline (Jakarta EE 10, jakarta.* namespace). -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--
            springdoc-openapi is the only dependency NOT managed by the Spring Boot
            3.2.12 BOM, so its version is pinned explicitly here.
        -->
        <springdoc-openapi.version>2.3.0</springdoc-openapi.version>
        <!--
            jjwt (io.jsonwebtoken) is NOT managed by the Spring Boot 3.2.12 BOM, so
            its version is pinned explicitly here. 0.12.6 is the latest 0.12.x release
            and provides the modern parser API (Jwts.parser().verifyWith(...).build()
            .parseSignedClaims(...)) used by JwtAuthenticationFilter to validate the
            HS256 bearer tokens that replace the CICS COMMAREA (app/cpy/COCOM01Y.cpy)
            user-identity propagation. All three jjwt artifacts MUST share one version.
        -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <!-- ===================== COMPILE-SCOPE STARTERS ===================== -->

        <!-- Web / REST controllers: embedded Tomcat 10.1.x + Spring MVC @RestController. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA + Hibernate ORM 6.4.x for the 12 repositories. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Security 6.2.x: SecurityFilterChain, BCryptPasswordEncoder, @PreAuthorize. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Batch 5.1.x: Job, Step, JobLauncher, JobRegistry for the batch jobs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation 3.0 for @Valid on request DTOs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator operational endpoints: /actuator/health, /info, /metrics. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===================== DATABASE & MIGRATION ===================== -->

        <!-- PostgreSQL 15 JDBC driver (BOM-managed 42.7.x); runtime-only. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway schema migration (BOM-managed 9.22.x; native PostgreSQL 15 support). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- ===================== API DOCUMENTATION ===================== -->

        <!-- OpenAPI 3 + Swagger UI at /swagger-ui.html (explicitly versioned; not in the BOM). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc-openapi.version}</version>
        </dependency>

        <!-- ===================== JSON WEB TOKEN (JWT) ===================== -->

        <!--
            jjwt — JSON Web Token support for the stateless REST security model.
            JwtAuthenticationFilter parses and verifies HS256 bearer tokens to
            reconstruct the user identity (sub = CDEMO-USER-ID) and authorities
            (userType 'A'/'U' -> ROLE_ADMIN/ROLE_USER) that the legacy mainframe
            carried in the CICS COMMAREA (app/cpy/COCOM01Y.cpy L19-L44); AuthService
            issues those tokens after a successful BCrypt signon (replacing the
            plaintext password compare in app/cbl/COSGN00C.cbl L211-L257).

            The split is the standard jjwt packaging:
              - jjwt-api      (compile)  — the public types referenced in source
                                           (Jwts, Claims, Keys, the JwtException
                                           hierarchy). This is the ONLY jjwt artifact
                                           on the compile classpath.
              - jjwt-impl     (runtime)  — the runtime implementation of that API;
                                           required at execution time but not compiled
                                           against directly.
              - jjwt-jackson  (runtime)  — the Jackson-based (de)serializer that jjwt
                                           uses to read/write the JSON claim set;
                                           Jackson is already present via
                                           spring-boot-starter-web.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ===================== PROVIDED (COMPILE-TIME ONLY) ===================== -->

        <!--
            Lombok: @RequiredArgsConstructor (constructor injection), @Getter/@Setter,
            @Builder. provided + optional means it is on the compile classpath only and
            is NOT propagated transitively or packaged into the runtime artifact.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- ===================== TEST ===================== -->

        <!-- JUnit 5 Jupiter, Mockito, AssertJ, Spring Test (MockMvc). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JobLauncherTestUtils / JobRepositoryTestUtils for batch parity tests. -->
        <dependency>
            <groupId>org.springframework.batch</groupId>
            <artifactId>spring-batch-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- @WithMockUser / @WithUserDetails for security slice tests. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers PostgreSQL container for integration tests (*IT.java). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 integration for Testcontainers. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Java 17 compilation with -parameters. The <parameters>true</parameters>
                flag is mandatory for Spring Framework 6.1 (Spring Boot 3.2), which no
                longer deduces parameter names by parsing bytecode; without it,
                @RequestParam / @PathVariable / @RequestHeader name resolution fails.

                Lombok is registered as an annotation processor. An explicit
                <version>${lombok.version}</version> is REQUIRED because the
                BOM-managed maven-compiler-plugin is 3.11.0, and versions earlier
                than 3.12.0 do not inherit annotationProcessorPaths versions from
                dependency management. ${lombok.version} resolves via the Spring Boot BOM.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                Executable JAR packaging via the default repackage goal (bound to the
                package phase). Lombok is excluded from the repackaged artifact because
                it is purely compile-time and must not be on the runtime classpath.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
                Surefire runs fast unit tests (*Test.java) on `mvn test`. Integration
                tests (*IT.java) are explicitly excluded so they run only under Failsafe.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
                Failsafe runs integration tests (*IT.java) in the integration-test phase
                and reports failures in the verify phase, so post-test cleanup (e.g.,
                Testcontainers shutdown) always runs before the build is failed.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
