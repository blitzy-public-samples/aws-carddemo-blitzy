# CardDemo Development Environment Configuration
# This file contains environment-specific variables for local development
# All variables must use VITE_ prefix to be exposed to the React application at build time

# API Configuration - Points to local Spring Boot backend
VITE_API_BASE_URL=http://localhost:8080/api

# Application Configuration
VITE_APP_NAME=CardDemo

# Environment Identifier
VITE_ENV=development

# Debug Mode - Enables detailed logging and debugging features in development
VITE_DEBUG_MODE=true

# Additional Development Settings
# Enables React DevTools and additional debugging information
VITE_ENABLE_DEVTOOLS=true

# Session Configuration
# Session timeout in milliseconds (30 minutes for development)
VITE_SESSION_TIMEOUT=1800000

# Pagination Configuration
# Cards per page - matches COBOL screen layout (7 cards per page)
VITE_CARDS_PER_PAGE=7

# Transactions per page - matches COBOL screen layout (10 transactions per page)
VITE_TRANSACTIONS_PER_PAGE=10

# API Timeout Configuration
# Request timeout in milliseconds (30 seconds for development)
VITE_API_TIMEOUT=30000

# Feature Flags for Development
# Enable mock data for offline development
VITE_ENABLE_MOCK_DATA=false

# Enable performance monitoring in development
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Logging Configuration
# Log level: debug, info, warn, error
VITE_LOG_LEVEL=debug

# Enable console logging in development
VITE_ENABLE_CONSOLE_LOGS=true
