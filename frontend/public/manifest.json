  "prefer_related_applications": false,
  "iarc_rating_id": "",
  "related_applications": [],
  "share_target": {
    "action": "/documents/upload",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "description",
      "files": [
        {
          "name": "document",
          "accept": ["image/jpeg", "image/png", "image/webp", "application/pdf"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+ocr",
      "url": "/documents/upload?url=%s"
    }
  ]
}
