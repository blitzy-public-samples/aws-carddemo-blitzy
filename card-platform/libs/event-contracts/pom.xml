<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared module holding the JSON Schema documents the six services read.

  src/main/resources/schemas holds nine versioned documents:
    transaction-authorized-v1  authorization approval
    transaction-declined-v1    decline with a resolved account identifier
    transaction-declined-v2    decline with no resolved account identifier,
                               keyed on the transaction identifier
    transaction-posted-v1      ledger posting
    fraud-flagged-v1           risk assessment that triggered
    fraud-cleared-v1           risk assessment that did not trigger
    account-state-changed-v1   account mutation
    card-updated-v1            card mutation
    dead-letter-v1             the shape every dead-letter topic carries

  Every document is JSON Schema Draft 2020-12. Every document names the account
  identifier as the single source of the Kafka message key, closes its top-level
  property set, declares a maxProperties ceiling and carries one bounded
  extensions object.

  Rationale for the choices in this file: card-platform/docs/decision-log.md
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The aggregator sits two levels up. libs/ holds no pom.xml of its own. -->
  <parent>
    <groupId>com.carddemo</groupId>
    <artifactId>card-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!-- groupId and version come from the parent. -->
  <artifactId>event-contracts</artifactId>
  <packaging>jar</packaging>

  <name>event-contracts</name>
  <description>Nine versioned JSON Schema documents: six for the authorization, ledger and fraud events, two for the account and card mutation events, and one for the dead-letter envelope. Every document is Draft 2020-12. Every document closes its top-level property set and carries one bounded extensions object, so an undeclared field is refused and evolution stays additive.</description>

  <!-- Language level. The build reads maven.compiler.release: the compiler plugin in
       card-platform/pom.xml configures its release from that property, and the aggregator's
       enforcer rule requires 25 in every module. java.version carries the framework's
       conventional name for the same level and no plugin resolves it, because the aggregator
       imports the Spring Boot bill of materials rather than inheriting the Spring Boot parent. -->
  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <!-- Versions come from the aggregator. Declare none here. -->
  <dependencies>
    <!-- JSON binding. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Validates payloads against JSON Schema Draft 2020-12. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>

    <!-- kafka-clients supplies the Serializer and Deserializer interfaces. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
    </dependency>

    <!-- Runs the event-contract tests under src/test/java/com/carddemo/events. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Assertion and test utility surface. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
