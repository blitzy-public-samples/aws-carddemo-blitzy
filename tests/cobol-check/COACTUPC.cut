            EXPECT PGMNAMEO OF CACTUPAO TO BE 'COACTUPC'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC22 -- 3310-PROTECT-ALL-ATTRS sets DFHBMPRF on all input flds
      *
      *  Drives 3310-PROTECT-ALL-ATTRS (production lines 3441-3495).
      *  Pure MOVE paragraph; sets DFHBMPRF (BMS protected attribute)
      *  on all 49 input fields of the CACTUPAI map.  Asserts a
      *  representative sample (ACCTSIDA, AADDGRPA, INFOMSGA) to
      *  prove the MOVE chain executed end-to-end.
      ******************************************************************
       TESTCASE 'COACTUPC 3310-PROTECT-ALL-ATTRS marks fields as PRF'
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3310-PROTECT-ALL-ATTRS
                THRU 3310-PROTECT-ALL-ATTRS-EXIT
            EXPECT ACCTSIDA OF CACTUPAI TO BE DFHBMPRF
            EXPECT AADDGRPA OF CACTUPAI TO BE DFHBMPRF
            EXPECT INFOMSGA OF CACTUPAI TO BE DFHBMPRF
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC23 -- 3320-UNPROTECT-FEW-ATTRS unprotects update fields
      *
      *  Drives 3320-UNPROTECT-FEW-ATTRS (production lines 3500-3560).
      *  Pure MOVE paragraph; sets DFHBMFSE (unprotected) on
      *  user-editable fields and DFHBMPRF on key/info fields.
      *  Asserts representative samples (ACSTTUSA = FSE; ACSTNUMA =
      *  PRF; ACSCTRYA = PRF; INFOMSGA = PRF) to prove both branches.
      ******************************************************************
       TESTCASE 'COACTUPC 3320-UNPROTECT-FEW-ATTRS toggles FSE PRF'
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3320-UNPROTECT-FEW-ATTRS
                THRU 3320-UNPROTECT-FEW-ATTRS-EXIT
            EXPECT ACSTTUSA OF CACTUPAI TO BE DFHBMFSE
            EXPECT ACSTNUMA OF CACTUPAI TO BE DFHBMPRF
            EXPECT ACSCTRYA OF CACTUPAI TO BE DFHBMPRF
            EXPECT INFOMSGA OF CACTUPAI TO BE DFHBMPRF
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC24 -- 3390-SETUP-INFOMSG-ATTRS WS-NO-INFO-MESSAGE branch
      *
      *  Drives 3390-SETUP-INFOMSG-ATTRS (production lines 3566-3582)
      *  with WS-NO-INFO-MESSAGE flag set TRUE.  Production line 3567
      *  IF WS-NO-INFO-MESSAGE THEN moves DFHBMDAR (dark) to
      *  INFOMSGA; else moves DFHBMASB (alarmed asterisks).
      *  Asserts the THEN branch side effect.
      ******************************************************************
       TESTCASE 'COACTUPC 3390-SETUP-INFOMSG-ATTRS dark when no msg'
            SET WS-NO-INFO-MESSAGE TO TRUE
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3390-SETUP-INFOMSG-ATTRS
                THRU 3390-SETUP-INFOMSG-ATTRS-EXIT
            EXPECT INFOMSGA OF CACTUPAI TO BE DFHBMDAR
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC25 -- 3400-SEND-SCREEN sets CCARD-NEXT-MAP and exits
      *
      *  Drives 3400-SEND-SCREEN (production lines 3589-3601).
      *  MOVEs LIT-THISMAPSET / LIT-THISMAP to CCARD-NEXT-MAPSET /
      *  CCARD-NEXT-MAP, then EXEC CICS SEND MAP (stripped by
      *  cobol-check).  Asserts the MOVE side effects.
      ******************************************************************
       TESTCASE 'COACTUPC 3400-SEND-SCREEN copies map name to CCARD'
            MOVE SPACES TO CCARD-NEXT-MAP
            MOVE SPACES TO CCARD-NEXT-MAPSET
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 3400-SEND-SCREEN THRU 3400-SEND-SCREEN-EXIT
            EXPECT CCARD-NEXT-MAP TO BE 'CACTUPA'
            EXPECT CCARD-NEXT-MAPSET TO BE 'COACTUP'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

      ******************************************************************
      *  TC26 -- 9300-GETACCTDATA-BYACCT exec-cics-stripped DFHRESP-fall
      *
      *  Drives 9300-GETACCTDATA-BYACCT (production lines 3701+).
      *  Single EXEC CICS READ DATASET; cobol-check strips it.
      *  WS-RESP-CD remains 0; DFHRESP() doesn't resolve off-platform
      *  so the EVALUATE WS-RESP-CD falls through.  Coverage gain on
      *  the MOVE statements before/after the EVALUATE.
      ******************************************************************
       TESTCASE 'COACTUPC 9300-GETACCTDATA-BYACCT runs without abend'
            MOCK CALL 'DFHEI1'
                 CONTINUE
            END-MOCK
            PERFORM 9300-GETACCTDATA-BYACCT
                THRU 9300-GETACCTDATA-BYACCT-EXIT
            EXPECT WS-DFHEI1-UNMOCKED-CALLED TO BE 'N'
            VERIFY CALL 'DFHEI1' HAPPENED 0 TIMES

