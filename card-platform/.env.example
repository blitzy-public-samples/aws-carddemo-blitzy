# =============================================================================
# card-platform — environment contract for the local demo stack
# =============================================================================
# Copy this file to card-platform/.env before the first start, then bring the
# stack up from the card-platform directory:
#
#     cp .env.example .env
#     docker compose up -d
#
# Every value below is a working default, so the copy needs no editing.
#
# The credentials here are demo credentials for a disposable local container
# stack. Do not reuse them anywhere else. Keep your .env copy out of version
# control.
#
# Rationale for every value: card-platform/docs/decision-log.md
# =============================================================================


# -----------------------------------------------------------------------------
# Parallel stacks (optional, no default)
# -----------------------------------------------------------------------------
# docker-compose.yml appends CLONE_INDEX to the compose project name, the
# container names and the volume names. Leave it unset for the default stack.
# Set it on the command line, with two free host ports, to run a second stack
# beside the first:
#
#     CLONE_INDEX=2 POSTGRES_PORT=5442 KAFKA_PORT=9102 docker compose up -d
#
# Give a second stack its own consumer groups as well, so the two stacks do not
# share read positions on the topics below.


# -----------------------------------------------------------------------------
# PostgreSQL instance
# -----------------------------------------------------------------------------
# One container serves all six services. Inside the compose network PostgreSQL
# always listens on 5432, and POSTGRES_PORT changes only the host mapping.

# Host name the six service containers resolve on the compose network.
POSTGRES_HOST=postgres

# Port published on the developer's machine for psql and host-run tests.
POSTGRES_PORT=5432

# First database the container creates. The six service databases follow it.
POSTGRES_DB=carddemo

# Database user the container creates. Every service signs on as this user.
POSTGRES_USER=carddemo

# Password for that user. Demo value only.
POSTGRES_PASSWORD=carddemo


# -----------------------------------------------------------------------------
# One private database per service
# -----------------------------------------------------------------------------
# docker-compose.yml creates these six databases on first start. Each service
# reads and writes exactly one of them and never reaches into another.

# Authorization service, which alone writes the authorization decision.
AUTHORIZATION_DB_NAME=carddemo_authorization

# Ledger posting service, which keeps account balances current.
LEDGER_DB_NAME=carddemo_ledger

# Fraud detection service, which stores one risk assessment per event.
FRAUD_DB_NAME=carddemo_fraud

# Notification service, which stores the card-keyed model behind each alert.
NOTIFICATION_DB_NAME=carddemo_notification

# Account service, which stores accounts, customers and reference data.
ACCOUNT_DB_NAME=carddemo_account

# Card service, which stores cards and its own cross-reference copy.
CARD_DB_NAME=carddemo_card


# -----------------------------------------------------------------------------
# Schema inside each private database
# -----------------------------------------------------------------------------
# Flyway creates and migrates these schemas, and the persistence layer only
# validates against them. PostgreSQL reserves the bare word authorization, so
# an unquoted schema by that name fails to create.

# Schema the authorization service migrates.
AUTHORIZATION_DB_SCHEMA=authorization_service

# Schema the ledger posting service migrates.
LEDGER_DB_SCHEMA=ledger_service

# Schema the fraud detection service migrates.
FRAUD_DB_SCHEMA=fraud_service

# Schema the notification service migrates.
NOTIFICATION_DB_SCHEMA=notification_service

# Schema the account service migrates.
ACCOUNT_DB_SCHEMA=account_service

# Schema the card service migrates.
CARD_DB_SCHEMA=card_service


# -----------------------------------------------------------------------------
# Kafka broker
# -----------------------------------------------------------------------------
# One broker node runs in Kafka Raft (KRaft) mode and advertises two listeners:
# kafka:29092 inside the compose network, and localhost:9092 on the host. Host
# tooling and services started outside Docker use the host listener.

# Broker address the six service containers connect to.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Port published on the developer's machine for a console consumer or a test.
KAFKA_PORT=9092

# Cluster identifier the broker writes into its data directory. A new value orphans that data.
KAFKA_CLUSTER_ID=cardDemoPlatformKRaft1

# Partitions the topic-init container gives each topic.
KAFKA_TOPIC_PARTITIONS=3

# Copies of each partition. One broker can hold one copy.
KAFKA_TOPIC_REPLICATION_FACTOR=1


# -----------------------------------------------------------------------------
# Event topics
# -----------------------------------------------------------------------------
# The topic-init container creates these topics, plus one dead-letter topic per
# consumed topic. Every message carries the account identifier as its key, which
# keeps one account's events on one partition and in order.

# Approved authorizations. Ledger posting, fraud detection and notification consume this topic.
TOPIC_TRANSACTION_AUTHORIZED=transaction.authorized

# Declined authorizations, each carrying reason code 100, 101, 102 or 103.
TOPIC_TRANSACTION_DECLINED=transaction.declined

# Posted transactions carrying the new balance. The notification service consumes this topic.
TOPIC_TRANSACTION_POSTED=transaction.posted

# Fraud verdicts, flagged and cleared. The notification service consumes this topic.
TOPIC_FRAUD_ASSESSED=fraud.assessed

# Suffix added to a topic name when a message exhausts its delivery attempts.
TOPIC_DEAD_LETTER_SUFFIX=.DLT


# -----------------------------------------------------------------------------
# Consumer groups
# -----------------------------------------------------------------------------
# Four distinct groups, so every consumer receives its own copy of every event.
# Two consumers sharing one group would split the events between them.

# Consumer group the ledger posting service joins to read transaction.authorized.
GROUP_LEDGER_POSTING=ledger-posting

# Consumer group the fraud detection service joins to read transaction.authorized.
GROUP_FRAUD_DETECTION=fraud-detection

# Consumer group the notification service joins to read transaction.posted.
GROUP_NOTIFICATION_POSTED=notification-posted

# Consumer group the notification service joins to read fraud.assessed.
GROUP_NOTIFICATION_FRAUD=notification-fraud


# -----------------------------------------------------------------------------
# Service ports
# -----------------------------------------------------------------------------
# One published port per service. POST /authorizations on the authorization
# port is the only call a client makes; every step after it travels by event.

# Authorization service. Serves POST /authorizations.
AUTHORIZATION_PORT=8081

# Ledger posting service. Serves balance queries.
LEDGER_PORT=8082

# Fraud detection service. Serves risk assessment queries.
FRAUD_PORT=8083

# Notification service. Serves alert history.
NOTIFICATION_PORT=8084

# Account service. Serves account reads, updates and cycle-close.
ACCOUNT_PORT=8085

# Card service. Serves card list, card detail and card update.
CARD_PORT=8086


# -----------------------------------------------------------------------------
# Outbox relay
# -----------------------------------------------------------------------------
# A producing service writes its domain row and its event row in one local
# transaction. The relay publishes those event rows afterwards, in a second
# transaction.

# Milliseconds between two sweeps for unpublished rows. A larger value delays events.
OUTBOX_RELAY_INTERVAL_MS=500

# Rows one sweep claims and publishes.
OUTBOX_RELAY_BATCH_SIZE=100


# -----------------------------------------------------------------------------
# Consumer resilience
# -----------------------------------------------------------------------------
# A consumer acknowledges a message only after its own writes commit. A message
# that keeps failing lands on the dead-letter topic once the attempts run out.

# Delivery attempts a consumer makes before it gives up on a message.
CONSUMER_MAX_RETRY_ATTEMPTS=3

# Milliseconds a consumer waits between two attempts.
CONSUMER_RETRY_BACKOFF_MS=1000


# -----------------------------------------------------------------------------
# Logging and observability
# -----------------------------------------------------------------------------
# Each service writes structured logs and counts events consumed, processing
# time and failures.

# Root log level. Takes TRACE, DEBUG, INFO, WARN, ERROR or OFF.
LOG_LEVEL=INFO

# Log level for the com.carddemo packages, where the event fan-out shows.
LOG_LEVEL_CARDDEMO=DEBUG

# Actuator endpoints each service exposes under /actuator.
MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus
