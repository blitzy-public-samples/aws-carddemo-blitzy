<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared module holding the JSON Schema documents the six services read.

  src/main/resources/schemas holds one versioned document per event contract, in
  these families: transaction-authorized, transaction-declined, transaction-posted,
  fraud-flagged, fraud-cleared, account-state-changed, card-updated,
  customer-context-changed, and dead-letter for the shape every dead-letter topic
  carries. A family carries a v2 document where a field was added or a key changed,
  and both versions stay readable. Read the directory for the current set rather than
  a count stated here.

  Every document is JSON Schema Draft 2020-12, closes its top-level property set,
  declares a maxProperties ceiling and carries one bounded extensions object. The
  aggregateId property is the Kafka message key of every document: it holds the
  account identifier everywhere except transaction-declined-v2, where no account has
  been resolved and the key is the transaction identifier.

  Rationale for the choices in this file, including the language level and the
  bill-of-materials import below: card-platform/docs/decision-log.md
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The aggregator sits two levels up. libs/ holds no pom.xml of its own. -->
  <parent>
    <groupId>com.carddemo</groupId>
    <artifactId>card-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!-- groupId and version come from the parent. -->
  <artifactId>event-contracts</artifactId>
  <packaging>jar</packaging>

  <name>event-contracts</name>
  <description>Versioned JSON Schema documents for the authorization, ledger, fraud, account, card and customer events, and for the dead-letter envelope. Every document is Draft 2020-12. Every document closes its top-level property set and carries one bounded extensions object, so an undeclared field is refused and evolution stays additive.</description>

  <!-- Language level. The compiler plugin in card-platform/pom.xml reads
       maven.compiler.release, and the aggregator's enforcer rule requires 25 in every module.
       java.version carries the framework's conventional name for the same level and no plugin
       resolves it. -->
  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <!-- Versions come from the aggregator. Declare none here. -->
  <dependencies>
    <!-- JSON binding. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Validates payloads against JSON Schema Draft 2020-12. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>

    <!-- kafka-clients supplies the Serializer and Deserializer interfaces, and the record header
         types com.carddemo.events.correlation writes the two correlation identifiers into. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
    </dependency>

    <!-- The Mapped Diagnostic Context com.carddemo.events.correlation.CorrelationScope writes to.
         Declared rather than inherited through kafka-clients, so the one type this module compiles
         against is named by the module that compiles against it. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- Runs the event-contract tests under src/test/java/com/carddemo/events. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Assertion and test utility surface. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
