# card-platform — environment contract for the local demo stack.
#
# Copy this file to card-platform/.env before the first start, then bring the
# stack up from the card-platform directory:
#
#     cp .env.example .env
#     docker compose up -d --build
#
# The middle command is not optional. Each service image copies a packaged
# archive out of its own target directory, and a fresh checkout carries none.
# The build needs OpenJDK 25 and Apache Maven 3.9.16.
#
# Every value that is not a credential is a working default. Every credential is a
# placeholder, and the stack refuses to start until the copy carries a real one. The
# generator below fills all seventeen in one command.
#
# The host packages the archives first. Run `mvn -f pom.xml clean package` from
# card-platform/ before `docker compose up -d --build`: every services/*/Dockerfile
# copies the archive its own module left under target/, and the build context is that
# module directory, so no compiler, no build tool and no source tree enters an image.
#
# SEVENTEEN values carry no default anywhere else: POSTGRES_PASSWORD, the six per-service
# database passwords, the broker administrator password, the six per-service broker
# passwords, and the three request-identity password hashes. Nothing in docker-compose.yml
# and nothing in a service falls back to a credential, so the stack refuses to start until
# this file supplies every one.
#
# THIS FILE IS NOT DEPLOYABLE AS IT STANDS, and that is deliberate. A value stated in a
# public repository is known to everyone who can read the repository, so every credential
# here is the literal REPLACE placeholder rather than a working password. Three separate
# refusals enforce it: docker-compose.yml stops the stack when a credential is unset, the
# provisioning program refuses a password still carrying REPLACE, and each service checks
# its own database password, broker credential and identity hashes as its context refreshes
# and refuses to finish starting. A service that started with a placeholder would answer
# every request with 401 and read as misconfigured rather than as insecure, which is the
# failure these refusals replace.
#
# Generate all seventeen at once, into a .env this file has already been copied to:
#
#     cp .env.example .env
#     for v in POSTGRES_PASSWORD \
#              AUTHORIZATION_DB_PASSWORD LEDGER_DB_PASSWORD FRAUD_DB_PASSWORD \
#              NOTIFICATION_DB_PASSWORD ACCOUNT_DB_PASSWORD CARD_DB_PASSWORD \
#              KAFKA_ADMIN_PASSWORD \
#              AUTHORIZATION_KAFKA_PASSWORD LEDGER_KAFKA_PASSWORD FRAUD_KAFKA_PASSWORD \
#              NOTIFICATION_KAFKA_PASSWORD ACCOUNT_KAFKA_PASSWORD CARD_KAFKA_PASSWORD; do
#       sed -i "s|^$v=.*|$v=$(openssl rand -base64 24 | tr -d '/+=')|" .env
#     done
#
# The tr strips three characters no password here may carry: the broker builds a login
# entry around its password, and a quote, a backslash or whitespace would end the entry
# early, so the broker refuses such a value rather than authenticating as something else.
# The three password hashes are generated differently, and the section that declares them
# carries the command.
#
# Every credential here belongs to a disposable local container stack. Do not reuse one
# anywhere else. Keep your .env copy out of version control.
#
# Every published port binds to 127.0.0.1, so only this machine reaches the
# database, the broker and the management endpoints. The six service ports are
# published the same way.


# Parallel stacks (optional, no default)
# docker-compose.yml appends CLONE_INDEX to the compose project name, the
# container names and the volume names. Leave it unset for the default stack.
# Set it on the command line, with two free host ports, to run a second stack
# beside the first:
#
#     CLONE_INDEX=2 POSTGRES_PORT=5442 KAFKA_PORT=9102 docker compose up -d
#
# Give a second stack its own consumer groups as well, so the two stacks do not
# share read positions on the topics below.


# PostgreSQL instance
# One container serves all six services. Inside the compose network PostgreSQL
# always listens on 5432, and POSTGRES_PORT changes only the host mapping.

# Host name the six service containers resolve on the compose network.
POSTGRES_HOST=postgres

# Port published on 127.0.0.1 for psql and host-run tests. The mapping names the
# loopback address, so no other host on the network reaches the database.
POSTGRES_PORT=5432

# First database the container creates. The six service databases follow it.
POSTGRES_DB=carddemo

# The superuser the container creates. It provisions the six databases and the six
# service logins below, and NO service signs on as this user any more: a single shared
# login meant a compromise of any one service could connect to and alter every other
# service's card, customer, balance, fraud and event data.
POSTGRES_USER=carddemo

# Password for the superuser. REQUIRED and a placeholder: no default exists in
# docker-compose.yml or in any service, and the provisioning program refuses a value
# carrying REPLACE, so the stack stops rather than creating a superuser under a password
# this repository publishes.
POSTGRES_PASSWORD=REPLACE-WITH-A-GENERATED-SUPERUSER-PASSWORD


# Per-service database logins
# One login per service, each owning one database. A distinct name alone is not a
# boundary: PostgreSQL grants CONNECT on a new database to PUBLIC, so the provisioning
# program in docker-compose.yml revokes CONNECT from PUBLIC on all six and grants it to
# the owner alone. A service that is compromised then holds a password that opens one
# database, and reaches no other service's data even by name.
#
# The usernames carry defaults, because a username is not a credential. The six
# passwords are placeholders: docker-compose.yml stops the stack when any one is unset,
# the provisioning program refuses one still carrying REPLACE, and each service refuses to
# finish starting with its own unset, placeholder or published. Give each one a DISTINCT
# value: six copies of one password are one login wearing six names.
AUTHORIZATION_DB_USER=carddemo_authorization_svc
AUTHORIZATION_DB_PASSWORD=REPLACE-WITH-A-GENERATED-PASSWORD-FOR-AUTHORIZATION

LEDGER_DB_USER=carddemo_ledger_svc
LEDGER_DB_PASSWORD=REPLACE-WITH-A-GENERATED-PASSWORD-FOR-LEDGER

FRAUD_DB_USER=carddemo_fraud_svc
FRAUD_DB_PASSWORD=REPLACE-WITH-A-GENERATED-PASSWORD-FOR-FRAUD

NOTIFICATION_DB_USER=carddemo_notification_svc
NOTIFICATION_DB_PASSWORD=REPLACE-WITH-A-GENERATED-PASSWORD-FOR-NOTIFICATION

ACCOUNT_DB_USER=carddemo_account_svc
ACCOUNT_DB_PASSWORD=REPLACE-WITH-A-GENERATED-PASSWORD-FOR-ACCOUNT

CARD_DB_USER=carddemo_card_svc
CARD_DB_PASSWORD=REPLACE-WITH-A-GENERATED-PASSWORD-FOR-CARD


# One private database per service
# docker-compose.yml creates these six databases on first start. Each name
# reaches exactly one service, through SPRING_DATASOURCE_URL.

AUTHORIZATION_DB_NAME=carddemo_authorization
LEDGER_DB_NAME=carddemo_ledger
FRAUD_DB_NAME=carddemo_fraud
NOTIFICATION_DB_NAME=carddemo_notification
ACCOUNT_DB_NAME=carddemo_account
CARD_DB_NAME=carddemo_card


# Schema inside each private database
# Flyway creates and migrates these schemas, and the persistence layer only
# validates against them. Each name carries a _service suffix, so none of the
# six collides with a PostgreSQL reserved word such as authorization.

AUTHORIZATION_DB_SCHEMA=authorization_service
LEDGER_DB_SCHEMA=ledger_service
FRAUD_DB_SCHEMA=fraud_service
NOTIFICATION_DB_SCHEMA=notification_service
ACCOUNT_DB_SCHEMA=account_service
CARD_DB_SCHEMA=card_service


# Authorization demo data
# Flyway locations the authorization service applies, in order.
# classpath:db/migration reproduces app/data/ASCII/acctdata.txt value for value, and the
# equivalence suite measures against it. All 50 of its account expiries fall in 2025.
# Reason code 103 at app/cbl/CBTRN02C.cbl:L414-L420 therefore declines any request
# carrying a later origin timestamp, which is every request a live demo sends.
#
# classpath:db/demo adds one migration that extends those expiries to 2099-12-31 and
# changes nothing else, so the fan-out demo can publish TransactionAuthorized.
# Set this to classpath:db/migration alone for any run whose output is compared against
# the fixture.

AUTHORIZATION_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo


# Kafka broker
# One broker node runs in Kafka Raft (KRaft) mode and advertises two listeners:
# kafka:29092 inside the compose network, and localhost:9092 on the host. Host
# tooling and services started outside Docker use the host listener.
#
# The broker creates no topic on demand. docker-compose.yml creates every topic
# below at start, so a mistyped topic name fails loudly instead of quietly
# opening a new stream.
#
# The Kubernetes path in card-platform/deploy/k8s advertises kafka:9092 instead,
# so its ConfigMap sets SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092 and overrides
# the value below. The variable below applies to the compose stack only.

# Broker address the six service containers connect to.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Port published on 127.0.0.1 for a console consumer or a test. The listener behind it
# requires one of the seven broker identities below, and binding the loopback address
# means only this machine can present one. A console consumer therefore needs a client
# properties file; the broker identities section states it.
KAFKA_PORT=9092

# Cluster identifier the broker writes into its data directory. A new value orphans that data.
KAFKA_CLUSTER_ID=cardDemoPlatformKRaft1

# Partitions the kafka container gives each topic it creates.
KAFKA_TOPIC_PARTITIONS=3

# Copies of each partition. One broker can hold one copy.
KAFKA_TOPIC_REPLICATION_FACTOR=1


# Broker identities and authorization
# The broker requires a Simple Authentication and Security Layer (SASL) identity on both
# client listeners and refuses every operation no access control entry allows. Seven
# identities exist: one administrator, which is the only super user and the only identity
# that creates a topic or an entry, and one per service.
#
# The entries each service holds are exactly what its own configuration needs, installed
# by the program in docker-compose.yml at broker start:
#
#     authorization   publishes transaction.authorized and transaction.declined
#     ledger posting  reads transaction.authorized as ledger-posting,
#                     publishes transaction.posted
#     fraud detection reads transaction.authorized as fraud-detection,
#                     publishes fraud.assessed
#     notification    reads three topics under three groups of its own, publishes nothing
#     account         publishes account.state-changed
#     card            publishes card.updated
#
# Every service also holds WRITE on the dead-letter topic of each topic it reads. No
# service holds an entry naming another service's topic or consumer group, so a
# compromised service can neither read a stream it does not consume nor join another
# service's group and take its partitions.
#
# A host console consumer needs the administrator identity in a properties file:
#
#     printf 'security.protocol=SASL_PLAINTEXT\nsasl.mechanism=PLAIN\n' > /tmp/admin.properties
#     printf 'sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule \
#     required username="%s" password="%s";\n' "$KAFKA_ADMIN_USER" "$KAFKA_ADMIN_PASSWORD" \
#       >> /tmp/admin.properties
#     kafka-console-consumer.sh --bootstrap-server localhost:9092 \
#       --consumer.config /tmp/admin.properties --topic transaction.authorized --from-beginning
#
# No password below may carry a quote, a backslash or whitespace. The broker builds a
# login entry around it, those characters would end the entry early, and the broker
# refuses such a value rather than authenticating as something else.

# Wire protocol for both client listeners. SASL_PLAINTEXT authenticates without
# encrypting, which is what this stack runs: the broker publishes on the loopback address
# alone and every service reaches it across one Docker bridge on this machine.
# card-platform/deploy/k8s/30-configmap.yaml sets SASL_SSL, because a cluster pod network
# is a shared path. This one value is what changes between the two.
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT

# The one mechanism this broker offers.
KAFKA_SASL_MECHANISM=PLAIN

# The broker administrator. It is the only super user, it answers for the broker's own
# inter-broker traffic, and it creates every topic and every access control entry. NO
# service holds it. The username carries a default; the password is a placeholder.
KAFKA_ADMIN_USER=carddemo-kafka-admin
KAFKA_ADMIN_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-ADMIN-PASSWORD

# The six service identities. Give each password a DISTINCT value: six copies of one
# password are one identity wearing six names, and the per-service entries above stop
# meaning anything.
AUTHORIZATION_KAFKA_USER=carddemo-authorization
AUTHORIZATION_KAFKA_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-PASSWORD-FOR-AUTHORIZATION

LEDGER_KAFKA_USER=carddemo-ledger
LEDGER_KAFKA_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-PASSWORD-FOR-LEDGER

FRAUD_KAFKA_USER=carddemo-fraud
FRAUD_KAFKA_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-PASSWORD-FOR-FRAUD

NOTIFICATION_KAFKA_USER=carddemo-notification
NOTIFICATION_KAFKA_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-PASSWORD-FOR-NOTIFICATION

ACCOUNT_KAFKA_USER=carddemo-account
ACCOUNT_KAFKA_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-PASSWORD-FOR-ACCOUNT

CARD_KAFKA_USER=carddemo-card
CARD_KAFKA_PASSWORD=REPLACE-WITH-A-GENERATED-BROKER-PASSWORD-FOR-CARD


# Transport Layer Security for the service ports
# Off here and on in the cluster. This stack runs every service on one Docker bridge on
# one machine and publishes each port on the loopback address alone, so there is no
# network path here for a third party to read. A cluster pod network is a shared path, so
# card-platform/deploy/k8s/30-configmap.yaml sets SERVER_SSL_ENABLED=true and names the
# keystore card-platform/deploy/k8s/31-secret.example.yaml templates.
#
# Switching the first value to true without the other two stops start-up, naming the
# empty keystore. That refusal lives in the SecurityConfig of each service, beside the
# credential checks.
SERVER_SSL_ENABLED=false
SERVER_SSL_KEYSTORE=
SERVER_SSL_KEYSTORE_TYPE=PKCS12
SERVER_SSL_KEYSTORE_PASSWORD=

# The management port follows the service port unless this says otherwise. It is stated
# rather than left to follow, because a monitoring credential travelling to a collector
# deserves the same protection as a cardholder identifier travelling to a client.
MANAGEMENT_SSL_ENABLED=false

# Scheme the container health check speaks. Set it to https together with
# MANAGEMENT_SSL_ENABLED, and neither on its own: a probe speaking http to an encrypted port
# reports a container unhealthy that is answering perfectly, and docker-compose.yml holds
# every dependent service back on that report.
HEALTHCHECK_SCHEME=http


# Event topics
# The kafka container creates these six topics, plus one dead-letter topic per
# consumed topic. The three consumed topics are transaction.authorized,
# transaction.posted and fraud.assessed. A published-only topic carries no
# dead-letter counterpart, since dead-letter routing carries a message a listener
# could not consume.
#
# Every message carries the account identifier as its key, which keeps one
# account's events on one partition and in order.
#
# Each name passes a gate before it reaches the broker: letters, digits, the
# period, the underscore and the hyphen only, up to 249 characters.

# Approved authorizations. Three services are planned as readers of this topic,
# each under its own consumer group: ledger posting, fraud detection and
# notification. None of the three calls another, and none sits in the
# authorization response path.
TOPIC_TRANSACTION_AUTHORIZED=transaction.authorized

# Declined authorizations. transaction-declined-v1.json enumerates the reason
# codes 0100, 0101, 0102 and 0103.
TOPIC_TRANSACTION_DECLINED=transaction.declined

# Posted transactions carrying the new balance. Published by the ledger posting
# service and read by the notification service.
TOPIC_TRANSACTION_POSTED=transaction.posted

# Fraud verdicts. fraud-flagged-v1.json and fraud-cleared-v1.json are the two
# verdict contracts this repository defines. Published by the fraud detection
# service and read by the notification service.
TOPIC_FRAUD_ASSESSED=fraud.assessed

# Account mutations, published by the account service only. Its payload matches
# schemas/account-state-changed-v1.json in the event-contracts library.
TOPIC_ACCOUNT_STATE_CHANGED=account.state-changed

# Card updates, published by the card service only. Its payload matches
# schemas/card-updated-v1.json in the event-contracts library.
TOPIC_CARD_UPDATED=card.updated

# One shared dead-letter topic. A record that exhausts its delivery attempts, or
# that fails schema validation inside poll, goes here with its failure detail.
# One stream rather than one per consumed topic: a dead-lettered record carries the
# envelope eventType that identifies it, so one stream finds, diagnoses and replays
# any of them.
TOPIC_DEAD_LETTER=carddemo.dead-letter


# Consumer groups
# Four distinct groups, one per planned listener, so every consumer receives its
# own copy of every event. Two listeners sharing one group would split the events
# between them.
#
# No module registers a Kafka listener yet, so these names configure nothing at
# runtime today. The first two are the group identifiers of the two planned readers
# of transaction.authorized, each an independent consumer of the one event an
# authorization call publishes.
#
# A second checkout running its own stack scopes these per clone, so two stacks
# reading the same broker do not share a group and split the events.

GROUP_LEDGER_POSTING=ledger-posting
GROUP_FRAUD_DETECTION=fraud-detection

# Consumer group the notification service is to join to read transaction.posted.
GROUP_NOTIFICATION_POSTED=notification-posted

# Consumer group the notification service joins to read fraud.assessed.
GROUP_NOTIFICATION_FRAUD=notification-fraud


# Service ports
# One host port per service. Each container listens on 8080, and
# docker-compose.yml publishes it on the port below. /actuator is the surface
# every service exposes.

AUTHORIZATION_PORT=8081
LEDGER_PORT=8082
FRAUD_PORT=8083
NOTIFICATION_PORT=8084
ACCOUNT_PORT=8085
CARD_PORT=8086


# Management ports
# One management port per service, published on 127.0.0.1 only. /actuator/health
# and /actuator/metrics answer here, and nothing answers on the service port
# above. A second stack needs six free ports here as well.

# Authorization service management port.
AUTHORIZATION_MANAGEMENT_PORT=9081

# Ledger posting service management port.
LEDGER_MANAGEMENT_PORT=9082

# Fraud detection service management port.
FRAUD_MANAGEMENT_PORT=9083

# Notification service management port.
NOTIFICATION_MANAGEMENT_PORT=9084

# Account service management port.
ACCOUNT_MANAGEMENT_PORT=9085

# Card service management port.
CARD_MANAGEMENT_PORT=9086


# Supporting service addresses
# The two services the authorization service reads while it applies the decline
# rules. The card service resolves a card number to an account, and the account
# service supplies the credit limit, both cycle counters and the expiry date.
# Both reads are synchronous and neither writes.
#
# Inside the compose network a service answers on its own name and port 8080,
# whatever host port it publishes above. A deployment outside compose replaces
# both values.
#
# These two are the only synchronous calls the design permits between services.
# No consumer calls another consumer, and no consumer calls the authorization
# service.

# Account service address the authorization service reads.
ACCOUNT_SERVICE_BASE_URL=http://account-service:8080

# Card service address the authorization service reads.
CARD_SERVICE_BASE_URL=http://card-service:8080


# Outbox relay
# docker-compose.yml passes these two values to the authorization, ledger
# posting, fraud detection, account and card services. No module runs a relay
# yet, so the two settings size the planned sweep.

# Milliseconds between two sweeps for unpublished outbox rows.
OUTBOX_RELAY_INTERVAL_MS=500

# Outbox rows one sweep claims.
OUTBOX_RELAY_BATCH_SIZE=100

# What a relay instance calls itself in outbox_event.claimed_by. Two relay instances that read
# the same unpublished row publish the same event twice, so the claim query takes the row with
# FOR UPDATE SKIP LOCKED and this value records which instance won. Distinct per replica; unset
# it and the container's own hostname is used, which is distinct per replica already.
OUTBOX_RELAY_INSTANCE_ID=

# How long a claim may be held before the row is treated as stranded and returned to PENDING. A
# relay that dies holding a claim would otherwise cost one event permanently: the row stays
# CLAIMED, the claim query filters on PENDING, and nothing looks at it again. ISO-8601 duration.
OUTBOX_RELAY_CLAIM_TIMEOUT=PT2M


# Replica freshness
# The authorization service authorizes against card_xref and account_credit_snapshot, which are
# copies kept current by state-change events. The COBOL posting program reads the datasets
# themselves at app/cbl/CBTRN02C.cbl:L382 and :L395, so it has nothing that can go stale. A copy
# does, and it goes stale quietly: a stale credit limit does not raise an error, it approves a
# transaction the current limit would have declined.
#
# How old an observation may be and still count as fresh, as an ISO-8601 duration. A whole day
# rather than minutes on purpose. This demo runs without any account or card mutation for its
# whole length, so a short window would decline every transaction after a few minutes and read as
# a broken demo rather than as the control working. Shorten it to minutes wherever real
# state-change traffic arrives.
REPLICA_MAX_STALENESS=P1D


# Consumer resilience
# docker-compose.yml passes these two values to the ledger posting, fraud
# detection and notification services. No module registers a listener yet, so
# the two settings size the planned retry.

# Delivery attempts a consumer makes before the record goes to its dead-letter
# topic.
CONSUMER_MAX_RETRY_ATTEMPTS=3

# Milliseconds a consumer waits between two attempts.
CONSUMER_RETRY_BACKOFF_MS=1000


# Logging and observability
# Root log level. Takes TRACE, DEBUG, INFO, WARN, ERROR or OFF.
LOG_LEVEL=INFO

# Log level for the com.carddemo packages, where the event fan-out shows. INFO by
# default: a DEBUG default retains identifiers in centralized logs. Raise it to
# DEBUG for one run when tracing a message, and lower it again afterwards.
LOG_LEVEL_CARDDEMO=INFO

# Actuator endpoints each service exposes under /actuator. They answer on the
# management port below, never on the service port, so a client of
# POST /authorizations reaches no runtime, database or broker internals. `info`
# is left out: it carries build and source-control detail no demo step reads.
#
# Listing an endpoint here does not publish it. Each service secures /actuator in
# front of these endpoints: health answers with no credential, because a container
# health check carries none, and metrics and the Prometheus scrape require the
# MONITORING identity below. An anonymous caller receives 401 and an identity
# holding a business role receives 403.
MANAGEMENT_ENDPOINTS=health,metrics,prometheus

# Port each container serves /actuator on, inside the container. The management
# mappings below publish it on 127.0.0.1 only.
MANAGEMENT_PORT=9080

# Keeps /actuator/health/readiness and /actuator/health/liveness available. The
# Kubernetes probes in card-platform/deploy/k8s read one group each, so a database
# outage takes a Pod out of its Service instead of restarting a Java virtual
# machine that is running correctly. Spring Boot 4.1.0 registers both groups by
# default and this pins it: set it to false and both paths answer 404. The compose
# healthcheck reads the aggregate endpoint and is unaffected.
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true

# ---------------------------------------------------------------------------
# Request identities
# ---------------------------------------------------------------------------
# Every service refuses an unauthenticated request. Each one reads the three
# identities below and maps them onto three Spring Security users, and start-up
# fails when the list is empty: a service running with no identity would either
# refuse every request or invite a default one.
#
# ADMIN and USER are the two outcomes of the SEC-USR-TYPE fork at
# app/cbl/COSGN00C.cbl:L232-L236. MONITORING is additive: it reaches the metrics
# and Prometheus endpoints above and no business route at all.
#
# A username is not a credential. These three are safe to keep as they are.
ADMIN_USERNAME=admin001
USER_USERNAME=user0001
MONITORING_USERNAME=monitor01

# What the ordinary identity owns, comma separated, one authority per
# entitlement. Three forms exist, one per kind of resource an owner reaches:
#
#   SCOPE_ACCOUNT_<eleven digits>       GET /accounts/{id}, GET /balances/{id}
#   SCOPE_CUSTOMER_<nine digits>        GET /customers/{id}
#   SCOPE_CARD_<masked card number>     GET /notifications/{maskedCardNumber}
#
# Write each identifier exactly as its column holds it, leading zeros and mask
# characters included: SCOPE_ACCOUNT_1 grants nothing where the column holds
# 00000000001. The three values below name record 1 of app/data/ASCII/acctdata.txt,
# its customer in custdata.txt and its card in carddata.txt, masked. Empty grants
# nothing, so an ownership-scoped route answers 403 until a value appears here.
USER_SCOPES=SCOPE_ACCOUNT_00000000001,SCOPE_CUSTOMER_000000001,SCOPE_CARD_************5740

# Password hashes, one per identity above. Each value is an ALREADY-ENCODED
# password carrying its algorithm prefix in braces. A plaintext value
# authenticates nothing, which is how this platform declines to reproduce the
# plaintext comparison at app/cbl/COSGN00C.cbl:L223.
#
# The three values below are placeholders and NOT credentials. Each carries a real
# algorithm prefix and an unusable payload, so a stack started on them
# authenticates nobody: every comparison fails and the encoder logs that the
# stored value is not a hash. A working credential published in this repository
# would be a credential everyone holds, so none appears here.
#
# Generate one per identity, with a JDK on the path:
#
#   jshell --class-path "$(find ~/.m2 -name 'spring-security-crypto-*.jar' | head -1)":"$(find ~/.m2 -name 'commons-logging-1.3*.jar' | head -1)":"$(find ~/.m2 -name 'spring-core-7*.jar' | head -1)"
#   jshell> org.springframework.security.crypto.factory.PasswordEncoderFactories
#             .createDelegatingPasswordEncoder().encode("the password you chose")
#
# Copy the whole result into .env, the brace-delimited prefix included. Then
# authenticate with curl -u "$USER_USERNAME:the password you chose".
ADMIN_PASSWORD_HASH={bcrypt}REPLACE-THIS-PLACEHOLDER-WITH-A-REAL-BCRYPT-HASH
USER_PASSWORD_HASH={bcrypt}REPLACE-THIS-PLACEHOLDER-WITH-A-REAL-BCRYPT-HASH
MONITORING_PASSWORD_HASH={bcrypt}REPLACE-THIS-PLACEHOLDER-WITH-A-REAL-BCRYPT-HASH
