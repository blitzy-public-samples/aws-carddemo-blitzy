<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Inherits dependency and plugin management from the root parent BOM. -->
    <parent>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>reporting-service</artifactId>
    <packaging>jar</packaging>

    <name>CardDemo Reporting Service</name>
    <description>CardDemo Reporting Service: report requests (CORPT00C) and batch statement
        generation (CBSTM03A / CBSTM03B). Executable Spring Boot application.</description>

    <dependencies>

        <!-- REST layer: report-request controller (POST /reports). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Outbound HTTP client auto-configuration for BatchJobClient, which hands the
            transaction-detail report to batch-service (the CORPT00C TDQ 'JOBS' hand-off).
            spring-boot-starter-web supplies the RestClient TYPE but not Boot's
            auto-configuration for it: in Spring Boot 4 that lives in this separate module,
            which contributes both RestClientAutoConfiguration (the managed
            RestClient.Builder bean) and RestClientObservationAutoConfiguration (the client
            instrumentation). The instrumentation is what makes the hop write a traceparent
            header, so without this module the launch crossed a service boundary with no
            trace context and batch-service opened an unrelated trace for the run, leaving
            the AAP's cross-service tracing requirement unmet (AAP 0.7.5). api-gateway
            already receives this module transitively through Spring Cloud Gateway; this
            service is the only other one that calls out over HTTP.
            Version is managed by the Spring Boot BOM (AAP 0.5.1).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>

        <!-- Persistence: read-access to shared tables via carddemo-common repositories. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Batch: statement-generation and transaction-report jobs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation for the report request DTO. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Authorization boundary for every route in this service. Without a
            SecurityFilterChain the service accepted session-less calls and served
            data to an unauthenticated caller; the principal is rebuilt from the
            shared Redis session by SessionContextAuthenticationFilter.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Actuator health/readiness/liveness and the Prometheus endpoint. -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Redis connectivity backing the externalized session. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Spring Session (Redis) for the externalized SessionContext. -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <!--
          Spring Boot 4 modularized auto-configuration: SessionAutoConfiguration and
          SessionDataRedisAutoConfiguration live in the spring-boot-session-data-redis module
          (they are NOT bundled with org.springframework.session:spring-session-data-redis).
          Without it the `spring.session.*` properties are inert, SessionRepositoryFilter is
          never registered, and HttpSession silently falls back to in-memory servlet-container
          storage instead of Redis, defeating the externalized COMMAREA session.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-session-data-redis</artifactId>
        </dependency>

        <!-- Prometheus metrics registry. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!--
          Distributed tracing (AAP 0.7.5). The Boot OpenTelemetry starter brings the
          Micrometer Tracing OTel bridge TOGETHER WITH the tracing/OTel
          auto-configuration and the OTLP span exporter. The bridge alone leaves
          no Tracer in the context, so no trace context is created and every
          traceId/spanId stays empty.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <!--
          Tracing auto-configuration. Spring Boot 4 ships auto-configuration in
          dedicated modules, so the bridge above is inert on its own: without these
          two modules no Tracer or ObservationRegistry tracing handler is created and
          no traceId/spanId ever reaches the SLF4J MDC, leaving the structured log
          lines uncorrelatable across service boundaries (AAP 0.7.5).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver (runtime only). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway (PostgreSQL migration support). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
          Spring Boot 4 modularized auto-configuration: FlywayAutoConfiguration lives in the
          spring-boot-flyway module (it is NOT bundled with flyway-core). Without it, the shared
          carddemo-common migrations never run and Hibernate `validate` fails on the missing
          business tables. It is gated by `spring.flyway.enabled`.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- Shared library: JPA entities, DTOs, DateUtil, constants, observability, exceptions. -->
        <dependency>
            <groupId>com.carddemo</groupId>
            <artifactId>carddemo-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          Shared test-support utilities from carddemo-common (test-jar), above all
          com.carddemo.common.testsupport.MigratedSchemaContainer / CardDemoSchemaMigrations:
          they provide a PostgreSQL container whose schema is produced by the owning modules'
          real committed Flyway migrations, so integration tests validate against the deployed
          schema instead of one generated from the entities.
        -->
        <dependency>
            <groupId>com.carddemo</groupId>
            <artifactId>carddemo-common</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- Test stack: JUnit 5 (Jupiter), AssertJ, Mockito. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Awaitility, for the two integration classes that must wait for an
          ASYNCHRONOUSLY launched Spring Batch execution to reach a terminal status.
          A fixed sleep either flakes on a loaded host or wastes the whole budget on a
          fast one; Awaitility polls the execution and returns as soon as it is done,
          and fails with the observed state rather than with a bare assertion.
          Version managed by the Spring Boot BOM. Rationale: docs/decision-log.md,
          section 53.4.
        -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Spring MVC test slice (MockMvc auto-configuration). As of Spring Boot 4.0 the
          Web MVC test support was extracted from the catch-all
          spring-boot-test-autoconfigure module into its own spring-boot-webmvc-test
          module, surfaced through this starter; it is no longer transitively provided by
          spring-boot-starter-test. The version is managed by the Spring Boot BOM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Batch test utilities (JobLauncherTestUtils). -->
        <dependency>
            <groupId>org.springframework.batch</groupId>
            <artifactId>spring-batch-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: JUnit 5 integration and the PostgreSQL module. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
              A deterministic, NON-PRODUCTION AES-256 key is supplied to the forked test JVM so
              the carddemo-common CryptoConverter can encrypt the sensitive columns the tests
              persist (card CVV, customer identifiers). CryptoConverter fails fast when no key is
              configured, so production deployments MUST still provide the real key via the
              CARDDEMO_PII_KEY environment variable (see docs/decision-log.md). The value is an
              obviously-fake, test-only fixture and is never used outside the test phases; it is
              declared for BOTH forks because Surefire and Failsafe run in separate JVMs.
              Plugin version inherited from the Spring Boot parent plugin management.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <carddemo.pii.key>Y2FyZGRlbW8tdGVzdC1waWkta2V5LTMyYnl0ZXMhISE=</carddemo.pii.key>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Repackage into an executable fat jar. Plugin version inherited from the parent. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Failsafe binds the integration-test (*IT) suite to the integration-test/verify
              phases so the end-to-end statement-generation job test (StatementGenerationJobIT)
              and the application integration test (ReportingServiceApplicationIT) run against a
              real Testcontainers PostgreSQL under `mvn verify`, separate from the fast Surefire
              unit tests in the `test` phase. Plugin version inherited from the parent BOM.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <carddemo.pii.key>Y2FyZGRlbW8tdGVzdC1waWkta2V5LTMyYnl0ZXMhISE=</carddemo.pii.key>
                    </systemPropertyVariables>
                </configuration>
</plugin>
        </plugins>
    </build>

</project>
