# ============================================================================
# OCR Processing Service - Environment Configuration Template
# ============================================================================
# 
# SECURITY WARNING: This file contains sensitive configuration values.
# - DO NOT commit this file with actual credentials to version control
# - Copy this file to create your local .env: cp .env.example .env
# - Add .env to .gitignore to prevent accidental commits
# - In production, use secret management systems (AWS Secrets Manager, 
#   Google Secret Manager) instead of .env files
#
# This template provides all required environment variables for the OCR
# processing service. Replace placeholder values with your actual configuration.
# ============================================================================

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
# Core application settings for the OCR processing service

# Application identity
APP_NAME=ocr-processing-service
APP_VERSION=1.0.0

# Environment: development, staging, or production
# Affects logging, error handling, and feature flags
ENVIRONMENT=development

# Debug mode: Enable detailed logging and error traces
# WARNING: MUST be false in production for security
DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Recommended: INFO for production, DEBUG for development
LOG_LEVEL=INFO

# ============================================================================
# SERVER SETTINGS
# ============================================================================
# FastAPI/Uvicorn server configuration

# Server host binding (0.0.0.0 allows external connections)
HOST=0.0.0.0

# Server port
PORT=8000

# Number of Uvicorn worker processes
# Recommended: (2 x CPU cores) + 1 for production
WORKERS=4

# Auto-reload on code changes (development only)
# WARNING: MUST be false in production
RELOAD=true

# ============================================================================
# GOOGLE CLOUD VISION API
# ============================================================================
# Google Cloud Vision API for advanced OCR capabilities
# Documentation: https://cloud.google.com/vision/docs

# Path to Google Cloud service account JSON key file
# Download from: Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Enable/disable Google Cloud Vision API
GOOGLE_VISION_ENABLED=true

# API rate limit (requests per minute)
# Default: 1800 for standard tier
GOOGLE_VISION_RATE_LIMIT=1800

# ============================================================================
# AWS TEXTRACT
# ============================================================================
# AWS Textract for document text and data extraction
# Documentation: https://aws.amazon.com/textract/

# AWS IAM credentials with Textract permissions
# Obtain from: AWS IAM Console > Users > Security Credentials
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS region for Textract service
# Available regions: us-east-1, us-west-2, eu-west-1, etc.
AWS_REGION=us-east-1

# Enable/disable AWS Textract
AWS_TEXTRACT_ENABLED=true

# Textract features: TABLES, FORMS, QUERIES
# Comma-separated list of enabled features
AWS_TEXTRACT_FEATURES=TABLES,FORMS

# ============================================================================
# TESSERACT OCR
# ============================================================================
# Open-source OCR engine configuration
# Documentation: https://github.com/tesseract-ocr/tesseract

# Path to Tesseract executable
# Linux: /usr/bin/tesseract
# macOS: /usr/local/bin/tesseract
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract

# Tesseract language data
# Multiple languages: eng+fra+deu (English + French + German)
# Download language data from: https://github.com/tesseract-ocr/tessdata
TESSERACT_LANG=eng

# OCR Engine Mode (OEM):
# 0 = Legacy engine only
# 1 = Neural nets LSTM engine only
# 2 = Legacy + LSTM engines
# 3 = Default, based on what is available (recommended)
TESSERACT_OEM=3

# Page Segmentation Mode (PSM):
# 0 = Orientation and script detection only
# 1 = Automatic page segmentation with OSD
# 3 = Fully automatic page segmentation (default, recommended)
# 6 = Assume a single uniform block of text
# 11 = Sparse text. Find as much text as possible in no particular order
TESSERACT_PSM=3

# Path to custom Tesseract training data directory (optional)
# TESSERACT_DATA_DIR=/path/to/tessdata

# ============================================================================
# OCR STRATEGY CONFIGURATION
# ============================================================================
# Hybrid OCR approach: Use Tesseract first, cloud APIs for low confidence

# Enable hybrid OCR strategy (Tesseract + Cloud APIs)
HYBRID_OCR_ENABLED=true

# Confidence threshold for switching to cloud API (0-100)
# If Tesseract confidence < threshold, use cloud API for better accuracy
# Recommended: 85 (balance between cost and accuracy)
CONFIDENCE_THRESHOLD=85

# Primary OCR engine: tesseract, google_vision, aws_textract
PRIMARY_ENGINE=tesseract

# Fallback engine when primary fails or confidence is low
# Options: google_vision, aws_textract, none
FALLBACK_ENGINE=google_vision

# Enable parallel OCR processing (multiple engines simultaneously)
PARALLEL_OCR_ENABLED=false

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Redis for caching, session storage, and temporary data
# Documentation: https://redis.io/documentation

# Redis server hostname or IP
REDIS_HOST=localhost

# Redis server port
REDIS_PORT=6379

# Redis authentication password
# Leave empty if Redis has no password (not recommended for production)
REDIS_PASSWORD=dev_password

# Redis database number (0-15)
REDIS_DB=0

# Redis connection pool settings
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Redis key prefix for namespace isolation
REDIS_KEY_PREFIX=ocr:

# Cache TTL (Time To Live) in seconds
CACHE_TTL=3600

# ============================================================================
# RABBITMQ CONFIGURATION
# ============================================================================
# RabbitMQ message queue for asynchronous job processing
# Documentation: https://www.rabbitmq.com/documentation.html

# RabbitMQ server hostname or IP
RABBITMQ_HOST=localhost

# RabbitMQ server port (default: 5672 for AMQP)
RABBITMQ_PORT=5672

# RabbitMQ authentication
RABBITMQ_USER=ocr_dev
RABBITMQ_PASSWORD=dev_password

# RabbitMQ virtual host (namespace isolation)
RABBITMQ_VHOST=/

# Primary queue name for OCR processing jobs
RABBITMQ_QUEUE_NAME=ocr_processing_queue

# Exchange name for routing messages
RABBITMQ_EXCHANGE_NAME=document_processing_exchange

# Exchange type: direct, topic, fanout, headers
RABBITMQ_EXCHANGE_TYPE=topic

# Routing key for OCR jobs
RABBITMQ_ROUTING_KEY=ocr.process

# Dead letter queue for failed messages
RABBITMQ_DLQ_NAME=ocr_processing_dlq

# Message prefetch count (messages consumed at once)
RABBITMQ_PREFETCH_COUNT=10

# Message TTL (Time To Live) in milliseconds
RABBITMQ_MESSAGE_TTL=3600000

# Connection retry settings
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=5

# ============================================================================
# IMAGE PROCESSING CONFIGURATION
# ============================================================================
# Settings for document image preprocessing and validation

# Maximum uploaded image size in megabytes
MAX_IMAGE_SIZE_MB=50

# Supported file formats (comma-separated)
# Supported: pdf, jpg, jpeg, png, tiff, bmp, webp
SUPPORTED_FORMATS=pdf,jpg,jpeg,png,tiff

# Target DPI (dots per inch) for OCR processing
# Recommended: 300 DPI for optimal OCR accuracy
IMAGE_DPI=300

# Enable image preprocessing pipeline
# Includes: deskew, denoise, contrast enhancement
ENABLE_PREPROCESSING=true

# Deskew: Correct image rotation and skew
ENABLE_DESKEW=true
DESKEW_THRESHOLD=0.5

# Denoise: Remove image noise and artifacts
ENABLE_DENOISE=true
DENOISE_STRENGTH=10

# Contrast enhancement
ENABLE_CONTRAST_ENHANCEMENT=true
CONTRAST_FACTOR=1.2

# Grayscale conversion (can improve OCR accuracy)
CONVERT_TO_GRAYSCALE=true

# Image resize strategy: none, fit, fill, stretch
IMAGE_RESIZE_STRATEGY=fit

# Maximum image dimensions (width x height) in pixels
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096

# ============================================================================
# NLP CONFIGURATION
# ============================================================================
# Natural Language Processing for entity extraction and classification

# spaCy model for NLP tasks
# Models: en_core_web_sm (small), en_core_web_md (medium), en_core_web_lg (large)
# Download: python -m spacy download en_core_web_sm
SPACY_MODEL=en_core_web_sm

# Hugging Face transformer model for document classification
# Options: distilbert-base-uncased, bert-base-uncased, roberta-base
HUGGINGFACE_MODEL=distilbert-base-uncased

# Enable entity extraction (dates, amounts, names, addresses)
ENTITY_EXTRACTION_ENABLED=true

# Entity types to extract (comma-separated)
# Options: DATE, MONEY, PERSON, ORG, GPE, EMAIL, PHONE, TAX_ID
ENTITY_TYPES=DATE,MONEY,PERSON,ORG,EMAIL,PHONE

# Document classification confidence threshold (0.0 - 1.0)
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75

# Enable custom NER (Named Entity Recognition) models
CUSTOM_NER_ENABLED=false

# Path to custom NER model directory
# CUSTOM_NER_MODEL_PATH=/path/to/custom/model

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
# Settings for optimizing processing performance and resource usage

# Maximum concurrent OCR jobs processed simultaneously
MAX_CONCURRENT_JOBS=10

# Job timeout in seconds (kill job if exceeds this time)
JOB_TIMEOUT_SECONDS=300

# Batch processing: Number of documents processed in parallel
BATCH_SIZE=5

# Enable multi-threading for image preprocessing
ENABLE_MULTITHREADING=true

# Number of threads for CPU-intensive tasks
# Recommended: Number of CPU cores
WORKER_THREADS=4

# Memory limit per job in megabytes
MEMORY_LIMIT_MB=2048

# Enable GPU acceleration for ML models (if available)
ENABLE_GPU=false

# GPU device ID (0, 1, 2, etc.)
GPU_DEVICE_ID=0

# ============================================================================
# MONITORING AND OBSERVABILITY
# ============================================================================
# Integration with monitoring and error tracking services

# Sentry error tracking
# Get DSN from: https://sentry.io/settings/projects/
SENTRY_DSN=https://your-sentry-key@o1234567.ingest.sentry.io/1234567

# Sentry environment tag
SENTRY_ENVIRONMENT=development

# Sentry traces sample rate (0.0 - 1.0)
# 1.0 = capture all transactions (use lower value in production)
SENTRY_TRACES_SAMPLE_RATE=1.0

# DataDog APM (Application Performance Monitoring)
DATADOG_ENABLED=false
DATADOG_API_KEY=your-datadog-api-key

# DataDog agent host
DATADOG_AGENT_HOST=localhost

# DataDog service name
DATADOG_SERVICE_NAME=ocr-processing-service

# Prometheus metrics endpoint
ENABLE_PROMETHEUS_METRICS=true
PROMETHEUS_METRICS_PORT=9090

# Health check endpoint configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Security settings for API authentication and data protection

# JWT secret key for token validation (when called by backend API)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# API key for internal service-to-service authentication
# Generate with: openssl rand -hex 32
API_KEY=your-internal-api-key-change-this-in-production

# Enable CORS (Cross-Origin Resource Sharing)
ENABLE_CORS=true

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Enable request rate limiting
ENABLE_RATE_LIMITING=true

# Rate limit: requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# Enable virus scanning for uploaded files
ENABLE_VIRUS_SCAN=true

# ClamAV settings (if virus scanning enabled)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ============================================================================
# FILE STORAGE CONFIGURATION
# ============================================================================
# Temporary file storage during processing

# Temporary file storage directory
TEMP_STORAGE_PATH=/tmp/ocr-service

# Maximum age of temporary files in hours (auto-cleanup)
TEMP_FILE_MAX_AGE_HOURS=24

# Enable automatic cleanup of old temporary files
ENABLE_TEMP_CLEANUP=true

# Storage backend: local, s3, gcs
STORAGE_BACKEND=local

# S3 configuration (if STORAGE_BACKEND=s3)
# S3_BUCKET_NAME=ocr-documents
# S3_REGION=us-east-1

# GCS configuration (if STORAGE_BACKEND=gcs)
# GCS_BUCKET_NAME=ocr-documents
# GCS_PROJECT_ID=your-project-id

# ============================================================================
# DATABASE CONFIGURATION (Optional)
# ============================================================================
# If OCR service needs direct database access for job tracking

# PostgreSQL connection (if needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/ocr_db

# MongoDB connection (if needed)
# MONGODB_URI=mongodb://localhost:27017/ocr_documents

# ============================================================================
# DEVELOPMENT AND DEBUGGING
# ============================================================================
# Additional settings for development environment

# Enable SQL query logging
LOG_SQL_QUERIES=false

# Enable detailed API request logging
LOG_API_REQUESTS=true

# Enable performance profiling
ENABLE_PROFILING=false

# Save processed images for debugging
SAVE_DEBUG_IMAGES=false
DEBUG_IMAGES_PATH=/tmp/ocr-debug

# Mock external APIs for testing (use fake responses)
MOCK_EXTERNAL_APIS=false

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable specific features

# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable table extraction from documents
ENABLE_TABLE_EXTRACTION=true

# Enable form field detection
ENABLE_FORM_DETECTION=true

# Enable handwriting recognition
ENABLE_HANDWRITING_RECOGNITION=false

# Enable multi-language OCR
ENABLE_MULTILANGUAGE_OCR=false

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
# 
# NEXT STEPS:
# 1. Copy this file: cp .env.example .env (or rename if this is .env)
# 2. Replace all placeholder values with your actual configuration
# 3. Ensure .env is added to .gitignore
# 4. For production: Use secret management systems instead of .env files
# 5. Verify all required services (Redis, RabbitMQ) are running
# 6. Test configuration with: python -c "from config import settings; print(settings)"
#
# For more information, see: docs/DEVELOPMENT.md
# ============================================================================
