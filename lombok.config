# ============================================================================
# Lombok configuration (repository root)
# ----------------------------------------------------------------------------
# This is the root Lombok configuration for the CardDemo Spring Boot project.
#
# config.stopBubbling = true
#   Marks this directory as the Lombok configuration root so Lombok stops
#   searching parent directories. Lombok resolves configuration by walking from
#   each source file's directory upward; pinning the root here makes the build
#   deterministic regardless of where the checkout lives on disk.
#
# lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
#   Instructs the @RequiredArgsConstructor / @AllArgsConstructor processors to
#   COPY the Spring @Qualifier annotation from a `final` field onto the matching
#   generated constructor parameter. Without this, a field-level @Qualifier is
#   silently dropped from the Lombok-generated constructor, so Spring would
#   resolve the dependency by type (and, on ambiguity, by parameter name) — NOT
#   by the requested qualifier. This setting is REQUIRED for ReportService to
#   receive the non-primary BatchConfig.ASYNC_JOB_LAUNCHER bean rather than the
#   auto-configured synchronous primary JobLauncher (QA finding F4-ASYNC-01),
#   and is the canonical Spring + Lombok constructor-injection idiom. It applies
#   only where a @Qualifier is explicitly present, so existing constructor
#   injection (no qualifiers) is unaffected.
# ============================================================================
config.stopBubbling = true
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
