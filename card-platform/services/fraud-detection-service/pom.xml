<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Design decisions for this file: card-platform/docs/decision-log.md -->

    <!-- Net new capability. No COBOL ancestor. -->

  <!-- Parent is two levels up: services/ has no POM of its own. -->
  <parent>
    <groupId>com.carddemo</groupId>
    <artifactId>card-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!-- The group and the version come from the parent. -->
  <artifactId>fraud-detection-service</artifactId>
  <packaging>jar</packaging>

  <name>CardDemo Card Platform :: Fraud Detection Service</name>
  <description>
    Spring Boot application module for the CardDemo fraud detection service, a capability
    with no COBOL ancestor. Declares the web, persistence, messaging and observability
    dependencies the service needs.
  </description>

  <!-- Language level. The build reads maven.compiler.release: the compiler plugin in
       card-platform/pom.xml configures its release from that property, and the aggregator's
       enforcer rule requires 25 in every module. java.version carries the framework's
       conventional name for the same level and no plugin resolves it, because the aggregator
       imports the Spring Boot bill of materials rather than inheriting the Spring Boot parent. -->
  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <!-- Every version below comes from the aggregator's dependency management. -->
  <dependencies>

    <!-- Platform libraries. This module depends on no other service. -->
    <dependency>
      <groupId>com.carddemo</groupId>
      <artifactId>event-contracts</artifactId>
    </dependency>
    <dependency>
      <groupId>com.carddemo</groupId>
      <artifactId>cobol-compat</artifactId>
    </dependency>

    <!-- Web surface and bean constraints. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Persistence against the private fraud schema. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Flyway owns schema creation. Only the starter carries its auto-configuration. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Dialect module. Flyway needs it separately in this line. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Messaging. Only the starter carries the Kafka auto-configuration. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- The broker client. This module imports org.apache.kafka.clients or
         org.apache.kafka.common directly. Version from the imported bill of materials.
         Decisions: card-platform/docs/decision-log.md, under "Which artifacts a module
         declares for itself, and which it reaches through a starter". -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
    </dependency>

    <!-- JSON binding. This module imports tools.jackson.databind directly. jackson-core and
         the Jackson 2 annotations arrive with it and are not declared.
         Decisions: card-platform/docs/decision-log.md, under "Which artifacts a module
         declares for itself, and which it reaches through a starter". -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Health and metrics endpoints, counters and timers. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Request authentication and authorization. config/SecurityConfig declares two
         filter chains. Over the actuator surface, health stays open for a probe and
         metrics and the Prometheus scrape require ROLE_MONITORING. Over the API, the
         default is deny, and each route is scoped to the identity that owns the
         identifier it names. The starter also installs the response headers that keep
         a financial or personal-data answer out of every cache. It installs the
         delegating password encoder too, which reads the algorithm prefix of a
         configured password, so no plaintext password is stored or compared. The
         version comes from the Spring Boot bill of materials imported by the parent. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>


    <!-- Unit and slice tests, plus an embedded broker for consumer tests. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Container-backed integration tests. Testcontainers module artifact
         identifiers carry a testcontainers- prefix in the 2.x line. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Waits for an asynchronous assertion to hold. -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Packages the executable Java archive (JAR) that the Dockerfile copies. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Runs the container-backed schema checks in src/test/java named *IT. Surefire selects
           *Test and leaves those alone, so without this declaration EntitySchemaValidationIT is
           compiled and never executed. The parent supplies the version, the execution and the
           classesDirectory in pluginManagement; a module activates it by naming it here, which is
           how the other five services and equivalence-tests activate the same plugin. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!--
      Lets the equivalence stage build this module without re-running its integration
      suite, which the service integration stage ran and whose reports it kept.

      The equivalence stage asks Maven for equivalence-tests and everything it needs, and
      this module is one of those needs. Without this profile that stage runs every
      Failsafe class here a second time, which is the whole of the service integration
      stage repeated for no new information. The profile is inert until
      -DskipServiceIntegrationTests is named, so the default build, `mvn verify` and the
      service integration stage all behave exactly as before. It sits in this module
      rather than in the parent because the parent is also the parent of
      equivalence-tests, whose Failsafe classes are the very ones that stage runs.
    -->
    <profile>
      <id>skip-service-integration-tests</id>
      <activation>
        <property>
          <name>skipServiceIntegrationTests</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <skipTests>true</skipTests>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
