# ==============================================================================
# OCR Processing Application - Frontend Environment Variables Template
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local (do NOT commit .env.local to git)
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit real secrets or API keys to version control
# 4. See docs/DEVELOPMENT.md for detailed setup instructions
#
# SECURITY WARNING:
# - .env.local is gitignored and should NEVER be committed
# - All production secrets MUST be stored in secret management systems
# - Never share credentials in chat, email, or documentation
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------

# Environment (development, staging, production)
NODE_ENV=development

# Application Name
NEXT_PUBLIC_APP_NAME="OCR Processing Application"

# Application Version
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------

# Backend API Base URL
# Local development: http://localhost:3001
# Staging: https://api-staging.yourapp.com
# Production: https://api.yourapp.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# API Version
NEXT_PUBLIC_API_VERSION=v1

# API Request Timeout (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# ------------------------------------------------------------------------------
# WebSocket Configuration
# ------------------------------------------------------------------------------

# WebSocket Server URL for real-time updates
# Local development: ws://localhost:3001
# Staging: wss://ws-staging.yourapp.com
# Production: wss://ws.yourapp.com
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# WebSocket Reconnection Settings
NEXT_PUBLIC_WS_RECONNECT_ATTEMPTS=5
NEXT_PUBLIC_WS_RECONNECT_DELAY=5000

# ------------------------------------------------------------------------------
# NextAuth.js Authentication Configuration
# ------------------------------------------------------------------------------

# NextAuth Base URL (should match your frontend URL)
# Local development: http://localhost:3000
# Staging: https://staging.yourapp.com
# Production: https://yourapp.com
NEXTAUTH_URL=http://localhost:3000

# NextAuth Secret (generate with: openssl rand -base64 32)
# CRITICAL: Use a strong, unique secret for each environment
NEXTAUTH_SECRET=your-nextauth-secret-here-replace-with-random-string

# JWT Token Expiration
NEXTAUTH_JWT_EXPIRY=15m

# Session Strategy (jwt or database)
NEXTAUTH_SESSION_STRATEGY=jwt

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Configuration
# ------------------------------------------------------------------------------

# Google OAuth Client ID
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth Callback URL
# Local: http://localhost:3000/api/auth/callback/google
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# ------------------------------------------------------------------------------
# Microsoft OAuth 2.0 Configuration
# ------------------------------------------------------------------------------

# Microsoft OAuth Client ID (Application ID)
# Obtain from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=your-microsoft-client-id

# Microsoft OAuth Client Secret
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Microsoft OAuth Tenant ID (use 'common' for multi-tenant)
MICROSOFT_TENANT_ID=common

# Microsoft OAuth Callback URL
# Local: http://localhost:3000/api/auth/callback/microsoft
MICROSOFT_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback/microsoft

# ------------------------------------------------------------------------------
# Error Tracking and Monitoring (Sentry)
# ------------------------------------------------------------------------------

# Sentry DSN for error tracking
# Obtain from: https://sentry.io/settings/projects/
# Leave empty to disable Sentry in development
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry Environment
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Sentry Release Version (auto-populated in CI/CD)
NEXT_PUBLIC_SENTRY_RELEASE=

# Sentry Sample Rate (0.0 to 1.0)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry Replay Sample Rate (0.0 to 1.0)
NEXT_PUBLIC_SENTRY_REPLAYS_SAMPLE_RATE=0.1

# ------------------------------------------------------------------------------
# Application Performance Monitoring (DataDog)
# ------------------------------------------------------------------------------

# DataDog Application ID
NEXT_PUBLIC_DATADOG_APPLICATION_ID=

# DataDog Client Token
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=

# DataDog Site (e.g., datadoghq.com, datadoghq.eu)
NEXT_PUBLIC_DATADOG_SITE=datadoghq.com

# DataDog Service Name
NEXT_PUBLIC_DATADOG_SERVICE=ocr-frontend

# DataDog Environment
NEXT_PUBLIC_DATADOG_ENV=development

# DataDog Sample Rate (0-100)
NEXT_PUBLIC_DATADOG_SAMPLE_RATE=100

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------

# Enable/disable specific features for testing or gradual rollout
# Values: true or false

# Enable batch document processing
NEXT_PUBLIC_FEATURE_BATCH_PROCESSING=true

# Enable template builder
NEXT_PUBLIC_FEATURE_TEMPLATE_BUILDER=true

# Enable advanced analytics dashboard
NEXT_PUBLIC_FEATURE_ANALYTICS=true

# Enable third-party integrations
NEXT_PUBLIC_FEATURE_INTEGRATIONS=true

# Enable document export functionality
NEXT_PUBLIC_FEATURE_EXPORT=true

# Enable real-time collaboration features
NEXT_PUBLIC_FEATURE_COLLABORATION=false

# Enable multi-factor authentication (MFA)
NEXT_PUBLIC_FEATURE_MFA=true

# Enable SAML SSO for enterprise accounts
NEXT_PUBLIC_FEATURE_SAML_SSO=false

# Enable advanced search with ElasticSearch
NEXT_PUBLIC_FEATURE_ADVANCED_SEARCH=true

# Enable document comparison tools
NEXT_PUBLIC_FEATURE_DOCUMENT_COMPARISON=false

# Enable email-to-upload feature
NEXT_PUBLIC_FEATURE_EMAIL_UPLOAD=false

# Enable mobile responsive UI
NEXT_PUBLIC_FEATURE_MOBILE_UI=true

# Enable dark mode theme
NEXT_PUBLIC_FEATURE_DARK_MODE=true

# ------------------------------------------------------------------------------
# File Upload Configuration
# ------------------------------------------------------------------------------

# Maximum file size for uploads (in bytes)
# Default: 52428800 (50MB)
NEXT_PUBLIC_MAX_FILE_SIZE=52428800

# Maximum number of files in batch upload
NEXT_PUBLIC_MAX_BATCH_FILES=100

# Allowed file types (comma-separated MIME types)
NEXT_PUBLIC_ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/jpg,image/png,image/tiff

# Enable drag-and-drop upload
NEXT_PUBLIC_ENABLE_DRAG_DROP=true

# ------------------------------------------------------------------------------
# UI/UX Configuration
# ------------------------------------------------------------------------------

# Items per page for paginated lists
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=25

# Maximum page size
NEXT_PUBLIC_MAX_PAGE_SIZE=100

# Default document view mode (list or grid)
NEXT_PUBLIC_DEFAULT_VIEW_MODE=list

# Enable auto-save for forms (milliseconds delay)
NEXT_PUBLIC_AUTO_SAVE_DELAY=3000

# Toast notification duration (milliseconds)
NEXT_PUBLIC_TOAST_DURATION=5000

# Session timeout warning (minutes before expiry)
NEXT_PUBLIC_SESSION_TIMEOUT_WARNING=5

# ------------------------------------------------------------------------------
# Document Processing Configuration
# ------------------------------------------------------------------------------

# Default confidence threshold for flagging low-confidence fields (0-100)
NEXT_PUBLIC_CONFIDENCE_THRESHOLD=85

# Polling interval for processing status (milliseconds)
NEXT_PUBLIC_PROCESSING_POLL_INTERVAL=2000

# Enable real-time processing updates via WebSocket
NEXT_PUBLIC_ENABLE_REALTIME_UPDATES=true

# Show OCR confidence scores to users
NEXT_PUBLIC_SHOW_CONFIDENCE_SCORES=true

# ------------------------------------------------------------------------------
# Search Configuration
# ------------------------------------------------------------------------------

# Search debounce delay (milliseconds)
NEXT_PUBLIC_SEARCH_DEBOUNCE=500

# Minimum search query length
NEXT_PUBLIC_SEARCH_MIN_LENGTH=3

# Maximum search results per page
NEXT_PUBLIC_SEARCH_RESULTS_LIMIT=50

# Enable search highlighting
NEXT_PUBLIC_ENABLE_SEARCH_HIGHLIGHTING=true

# ------------------------------------------------------------------------------
# Analytics and Tracking
# ------------------------------------------------------------------------------

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Enable analytics tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Enable user behavior tracking
NEXT_PUBLIC_ENABLE_USER_TRACKING=false

# ------------------------------------------------------------------------------
# CDN and Asset Configuration
# ------------------------------------------------------------------------------

# CDN Base URL for static assets
NEXT_PUBLIC_CDN_URL=

# Image optimization quality (1-100)
NEXT_PUBLIC_IMAGE_QUALITY=80

# Enable Next.js Image Optimization
NEXT_PUBLIC_ENABLE_IMAGE_OPTIMIZATION=true

# ------------------------------------------------------------------------------
# Localization and Internationalization
# ------------------------------------------------------------------------------

# Default language/locale
NEXT_PUBLIC_DEFAULT_LOCALE=en-US

# Supported locales (comma-separated)
NEXT_PUBLIC_SUPPORTED_LOCALES=en-US

# Enable i18n
NEXT_PUBLIC_ENABLE_I18N=false

# ------------------------------------------------------------------------------
# Development and Debugging
# ------------------------------------------------------------------------------

# Enable debug mode (shows detailed error messages)
NEXT_PUBLIC_DEBUG_MODE=true

# Enable React Query DevTools
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=true

# Enable Redux DevTools
NEXT_PUBLIC_ENABLE_REDUX_DEVTOOLS=false

# Log level (error, warn, info, debug)
NEXT_PUBLIC_LOG_LEVEL=debug

# Enable performance monitoring in development
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=false

# ------------------------------------------------------------------------------
# Rate Limiting (Frontend-side display)
# ------------------------------------------------------------------------------

# API rate limit (requests per hour)
NEXT_PUBLIC_API_RATE_LIMIT=1000

# Show rate limit warnings to users
NEXT_PUBLIC_SHOW_RATE_LIMIT_WARNING=true

# ------------------------------------------------------------------------------
# Documentation and Help
# ------------------------------------------------------------------------------

# Link to user documentation
NEXT_PUBLIC_DOCS_URL=https://docs.yourapp.com

# Link to API documentation
NEXT_PUBLIC_API_DOCS_URL=https://api.yourapp.com/docs

# Link to support/help center
NEXT_PUBLIC_SUPPORT_URL=https://support.yourapp.com

# Link to status page
NEXT_PUBLIC_STATUS_PAGE_URL=https://status.yourapp.com

# ------------------------------------------------------------------------------
# Legal and Compliance
# ------------------------------------------------------------------------------

# Link to Terms of Service
NEXT_PUBLIC_TERMS_URL=https://yourapp.com/terms

# Link to Privacy Policy
NEXT_PUBLIC_PRIVACY_URL=https://yourapp.com/privacy

# Link to Cookie Policy
NEXT_PUBLIC_COOKIE_URL=https://yourapp.com/cookies

# Enable cookie consent banner
NEXT_PUBLIC_ENABLE_COOKIE_CONSENT=true

# ------------------------------------------------------------------------------
# Build and Deployment Configuration
# ------------------------------------------------------------------------------

# Build ID (auto-populated during CI/CD)
NEXT_PUBLIC_BUILD_ID=

# Git commit SHA (auto-populated during CI/CD)
NEXT_PUBLIC_GIT_COMMIT_SHA=

# Deployment timestamp (auto-populated during CI/CD)
NEXT_PUBLIC_DEPLOY_TIMESTAMP=

# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================
#
# NEXT STEPS:
# 1. Copy this file: cp .env.local.example .env.local
# 2. Update values in .env.local with your actual credentials
# 3. Restart your development server: npm run dev
# 4. Verify configuration at: http://localhost:3000
#
# TROUBLESHOOTING:
# - If environment variables aren't loading, ensure they start with NEXT_PUBLIC_
# - Server-side variables (without NEXT_PUBLIC_) are only available in API routes
# - Changes to .env.local require restarting the development server
# - See docs/DEVELOPMENT.md for detailed troubleshooting steps
#
# ==============================================================================
