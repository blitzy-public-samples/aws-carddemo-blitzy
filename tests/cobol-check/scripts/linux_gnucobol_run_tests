#!/bin/sh
# =====================================================================
# CardDemo cobol-check Linux GnuCOBOL runner.
#
# Copyright Amazon.com, Inc. or its affiliates.
# All Rights Reserved.
#
# Licensed under the Apache License, Version 2.0 (the "License").
# =====================================================================
#
# cobol-check invokes this script after merging a production program
# with its `.cut` testsuite.  $1 is the path to the merged COBOL
# source file (cobol-check writes it as `CC##99.CBL` regardless of the
# program-under-test).  Any extra COBOL options come in via $COBC_OPTS
# so that `make coverage` can append profile-arcs / test-coverage
# flags.
#
# Compilation strategy
# --------------------
# Step 1.  Extract the original PROGRAM-ID from the merged source and
#          copy `CC##99.CBL` to `<PROGRAM-ID>.cbl`.  GnuCOBOL refuses
#          to use `##` in intermediate file names; renaming the input
#          gives us clean, COBOL-named .c / .gcno / .gcda files which
#          parse_gcov_summary.sh can map back to the program.
# Step 2.  Try the standard executable path: `cobc -xj` (build + run).
# Step 3.  If cobc rejects the merged program because of a USING
#          clause, fall back to module mode: `cobc -m -o <PUT>.so`
#          followed by `cobcrun <PUT>`.  cobol-check's injected test
#          driver (UT-INITIALIZE) runs first; the test author is
#          expected to MOVE values into LINKAGE fields inside
#          BEFORE-EACH so the LINKAGE parameters arriving as default
#          NULL pointers / spaces is acceptable.
#
# Stubs (CEEDAYS, CEE3ABD, DFHEI1) are pre-compiled into the merged
# program's directory so that COB_LIBRARY_PATH can resolve them at
# load time.
# =====================================================================

set -u

merged_src="$1"
shift || true

merged_dir="$(dirname "$merged_src")"

# repo_root resolution.  Supports both:
#   - Default flat layout (merged_dir = target/cobol-check/):
#     fall back to two-up traversal.
#   - Parallel-isolated layout (merged_dir = target/cobol-check/<PROG>/):
#     two-up traversal lands at target/, NOT the repo root.  When
#     the Makefile invokes us under the parallel layout it exports
#     REPO_ROOT so we use it directly.  This keeps the runner
#     compatible with both layouts without filesystem heuristics.
if [ -n "${REPO_ROOT:-}" ] && [ -d "${REPO_ROOT}/app/cbl" ]; then
    repo_root="${REPO_ROOT}"
else
    repo_root="$(cd "${merged_dir}/../.." 2>/dev/null && pwd)"
fi

cd "${merged_dir}"

# ---------------------------------------------------------------------
# Step 1 - sanitise the merged source filename so GnuCOBOL produces
# coverage files (.gcno / .gcda / .c) named after the COBOL
# PROGRAM-ID rather than a `cob<NNNN>_0` temp file.
# ---------------------------------------------------------------------
program_id="$(awk '
    BEGIN { found = 0; want_next = 0 }
    # Skip COBOL fixed-format comment / debug lines (column 7).
    /^.\{6\}[*\/D]/ { next }
    # When the previous PROGRAM-ID line had no inline name, capture
    # the next non-blank, non-comment line as the program name.  This
    # handles the production source style:
    #     IDENTIFICATION DIVISION.
    #     PROGRAM-ID.
    #         COACTUPC.
    # which the original single-line awk could not extract.
    want_next == 1 {
        s = $0
        # Strip leading whitespace, trailing period & continuation,
        # any embedded whitespace -- leaving a bare name.
        sub(/^[[:space:]]+/, "", s)
        sub(/\..*$/, "", s)
        gsub(/[[:space:]]/, "", s)
        if (length(s) > 0) {
            print s
            found = 1
            want_next = 0
            exit
        }
        next
    }
    /^[[:space:]]*PROGRAM-ID/ {
        s = $0
        # Strip everything up through "PROGRAM-ID" + optional period
        # + whitespace, leaving the inline program name (or empty).
        sub(/.*PROGRAM-ID\.?[[:space:]]+/, "", s)
        sub(/\..*$/, "", s)
        gsub(/[[:space:]]/, "", s)
        if (length(s) > 0) {
            print s
            found = 1
            exit
        } else {
            # Inline name absent -- production used multi-line style.
            # Defer extraction to the next non-blank, non-comment row.
            want_next = 1
        }
    }
    END { if (found == 0) print "" }
' "${merged_src}")"

if [ -z "$program_id" ]; then
    echo "[runner] ERROR: could not extract PROGRAM-ID from ${merged_src}" >&2
    exit 2
fi

sanitised_src="${merged_dir}/${program_id}.cbl"

# ---------------------------------------------------------------------
# Sanitise every merged-source line before compiling:
#
#  1. Truncate to 72 columns.  Standard fixed-format COBOL has Area A
#     at cols 8-11, Area B at cols 12-72, and sequence/identification
#     at cols 73-80.  The IBM Enterprise COBOL compiler used in
#     production ignores cols 73-80 by default, so they may contain
#     sequence numbers, version stamps, or other vestigial content.
#
#  2. Strip a suspicious trailing-digit pattern that cobol-check
#     0.2.16 introduces.
#
# Why step 2 is necessary
# -----------------------
# A small number of CardDemo production source lines carry sequence
# numbers in the cols 73-80 identification area:
#   app/cbl/COACTVWC.cbl line 672 has '00'      at cols 73-74
#   app/cbl/COCRDUPC.cbl line 1530 has '340000' at cols 73-78
# These are vestigial numbers the IBM compiler ignores.  cobol-check
# 0.2.16 SHIFTS the entire line LEFT by ~3 columns during merge,
# moving those digits from the sequence area (cols 73-80) into the
# program-text area (Area B, cols 12-72).  Once inside Area B,
# GnuCOBOL parses the digits as numeric literals, breaking constructs
# like:
#   MOVE
#     'Account Filter must  be a non-zero 11 digit number'      00
#                                                          ^^
#                                                          interpreted
#                                                          as numeric
#                                                          literal in
#                                                          the merged
#                                                          line; cobc
#                                                          expects TO
#                                                          but finds
#                                                          a Literal.
#
# The cobol-check changelog records this as fixed in v0.2.19
# ("Sequence numbers are handled correct in long lines").  Until
# upgrade, we apply the deterministic, framework-version-agnostic
# countermeasure below: scan each line, and if it ends with a run
# of 4+ spaces followed by 1..8 digits then trailing whitespace
# (the exact signature of a misshifted sequence number) replace
# those tail digits with spaces.  The replacement preserves total
# line length.
#
# The pattern is intentionally conservative: it requires AT LEAST
# four spaces between the last non-digit character and the trailing
# digits, ensuring we never touch a legitimate numeric literal that
# happens to land near col 72.  Real COBOL numeric literals never
# need that much intervening whitespace from preceding content.
#
# Step 3 -- Fix unescaped embedded quotes in MOCK CALL VALUE literals.
#
# cobol-check 0.2.16's MockGenerator.java emits a WORKING-STORAGE field
# describing each MOCK CALL target, e.g.:
#
#   05 UT-1-1-1-MOCK-NAME       PIC X(40)
#                   VALUE "CALL "CEEDAYS"".
#
# This is malformed COBOL: the inner double-quotes around CEEDAYS are
# not escaped (COBOL escapes embedded quotes by doubling them).
# GnuCOBOL rejects this with "syntax error, unexpected Identifier".
# The bug only triggers when a production CALL site uses the SAME
# delimiter as the COBOL string framework chose (always double-quote
# in cobol-check 0.2.16).  CSUTLDTC.cbl line 116 is the only
# CardDemo CALL site using double-quotes; every other (CALL 'CEE3ABD',
# CALL 'CSUTLDTC', CALL 'CBSTM03B') uses single quotes and is unaffected.
#
# The fix below switches the OUTER delimiter from " to ' on any line
# that matches the broken pattern.  COBOL accepts both ' and " for
# alphanumeric literals, so this is semantically equivalent and lets
# the inner double-quotes stay literal.
#
# Pattern matched (case-sensitive, anchored to "VALUE ""):
#   <ws>VALUE "CALL "<id>"".<trailing-ws>
# Replacement:
#   <ws>VALUE 'CALL "<id>"'.<trailing-ws>
#
# The replacement preserves total line length so subsequent column-
# sensitive sanitisation (truncation/digit-strip) still works.
#
# Step 5 -- Inject COPY STUB-ABEND-FLAG into the WORKING-STORAGE
# SECTION of every merged source.
#
# Why this step is necessary
# --------------------------
# AAP Section 0.5.2 declares STUB-ABEND-FLAG.cpy as the EXTERNAL
# state group exposing WS-ABEND-FLAG / WS-DFHEI1-UNMOCKED-CALLED /
# WS-DFHEI1-EIBRESP-OVERRIDE.  These fields are written by the
# CEE3ABD and DFHEI1 stubs at runtime so that testsuites can
# EXPECT/VERIFY against the fail-loudly safety net (per QA
# checkpoint Phase 5.2 expectation).
#
# However, cobol-check 0.2.16's TestSuiteParser does NOT support
# `COPY` at file scope inside .cut testsuites (the parser only
# recognises TESTSUITE / TESTCASE / MOCK / EXPECT / VERIFY /
# BEFORE-EACH / AFTER-EACH / END-* / CALL / PARA / PARAGRAPH /
# SECTION; a bare COPY at file scope is silently dropped, leaving
# WS-DFHEI1-UNMOCKED-CALLED undeclared in the merged source).
# Placing COPY STUB-ABEND-FLAG inside BEFORE-EACH causes 01-level
# data declarations to land in the procedure division, which
# GnuCOBOL rejects as `unknown statement '01'`.
#
# This sanitisation step bypasses both cobol-check parser
# limitations by injecting `COPY STUB-ABEND-FLAG.` immediately
# AFTER the cobol-check-injected UT-FIELDS group ends.  The
# insertion point is "after WORKING-STORAGE SECTION. plus the
# entire UT-FIELDS group" which is the first 01-level declaration
# in production source.  We detect this by counting the number of
# blank lines that separate UT-FIELDS from the production source's
# first 01-level: cobol-check leaves exactly one blank line between
# its injected fields and the production WORKING-STORAGE entries.
#
# Implementation strategy: rather than count blank lines (which is
# fragile), we inject the COPY directly after the WORKING-STORAGE
# SECTION header.  GnuCOBOL accepts COPY statements anywhere a
# 01-level may appear, so this position is safe.  The injected
# field group becomes the FIRST 01-level group in WORKING-STORAGE,
# preceding both UT-FIELDS (cobol-check internal) and the
# production source's own 01-levels.  This ordering is intentional:
# placing STUB-ABEND-STATE first ensures the EXTERNAL linkage
# resolves correctly across the merged binary and the linked
# CEE3ABD / DFHEI1 stubs.
#
# CICS programs only.  Batch programs (CBACT01C/02C/03C/04C, etc.)
# do not need DFHEI1-related fields, but injecting them is harmless
# (the stubs are also linked at test-run time via COB_LIBRARY_PATH
# so the EXTERNAL block is shared regardless).  Universal injection
# eliminates per-program conditional logic and keeps the runner
# simple.
#
# The injection is performed by passing a flag through to awk;
# awk's `injected` variable starts at 0 and is set to 1 on first
# occurrence so the COPY is inserted exactly once per file.
#
# Step 4 -- Repair orphan NOT INVALID KEY / END-READ / END-WRITE
# clauses left behind by incomplete READ / WRITE stripping.
#
# cobol-check 0.2.16's TestSuiteParser comments out the first three
# lines of a `READ FILE ... INVALID KEY ... NOT INVALID KEY ...
# END-READ` compound statement (the READ verb, the KEY clause, and the
# INVALID KEY arm-opener) and inserts a CONTINUE to satisfy syntax.
# However, it FAILS to comment out the NOT INVALID KEY clause and the
# END-READ terminator, leaving them as orphan tokens that GnuCOBOL
# rejects with "syntax error, unexpected NOT INVALID KEY" and
# "syntax error, unexpected END-READ".
#
# Repair strategy:
#   * `NOT INVALID KEY` (no period; mid-statement clause-opener) -->
#     comment-out by setting col 7 to `*`.  The trailing DISPLAY/
#     MOVE statements that follow remain as benign orphan statements
#     after the synthetic CONTINUE that cobol-check inserted.
#   * `INVALID KEY` (no period; rare orphan when cobol-check strips
#     differently) --> comment-out same as NOT INVALID KEY.
#   * `END-READ.`, `END-WRITE.`, `END-REWRITE.`, `END-DELETE.`,
#     `END-START.` (with terminating period; sentence terminator) -->
#     replace the keyword in-place with `CONTINUE` while preserving
#     the trailing period.  The period is essential: it terminates
#     the implicit sentence chain of the orphan DISPLAY/MOVE
#     statements that precede it, allowing the following paragraph
#     header (Area A column 8) to be recognised by the parser.
#     Substituting `CONTINUE` for `END-READ` is semantically a no-op
#     (CONTINUE is COBOL's explicit no-op verb) and preserves total
#     line length: END-READ = 8 chars, CONTINUE = 8 chars; END-WRITE
#     = 9 chars, no equal-length COBOL no-op exists, so we use
#     a 1-byte-shorter CONTINUE plus padded space, which is also
#     semantically valid.  END-REWRITE and END-DELETE are 11 and 10
#     chars respectively; CONTINUE plus spaces fits.
#   * `END-READ` / `END-WRITE` / etc. WITHOUT a trailing period
#     (rare; appears when the compound is mid-sentence) --> comment
#     out same as NOT INVALID KEY.
#
# The match is case-insensitive (toupper) and requires the token to
# be the FIRST non-whitespace token on the line so that legitimate
# inline references inside literals are not modified.
#
# The replacement preserves total line length and column positions of
# all surrounding tokens.  Affects programs that use the COBOL
# READ ... INVALID KEY ... END-READ compound (CBTRN01C, CBTRN02C,
# CBTRN03C, COACTUPC, COACTVWC, COCRDLIC, COCRDSLC, COCRDUPC, etc.).
#
# The truncated, sanitised copy is the source compiled; the original
# merged_src is preserved for debug.
# ---------------------------------------------------------------------
awk '
    BEGIN { stub_abend_injected = 0; in_data_division = 0 }
    {
        line = substr($0, 1, 72)
        # Step 5 -- inject COPY STUB-ABEND-FLAG into WORKING-STORAGE.
        # Detect the WORKING-STORAGE SECTION header line and emit a
        # synthetic COPY directive immediately after it.  The COPY
        # is emitted BEFORE printing the current line is finished
        # (we print the current line first, then conditionally emit
        # the COPY on the next-line slot).  See `print` block at end.
        ws_section_line = 0
        if (toupper(line) ~ /^[[:space:]]+WORKING-STORAGE[[:space:]]+SECTION\.[[:space:]]*$/ \
            && stub_abend_injected == 0) {
            ws_section_line = 1
        }
        # Step 6 -- track DATA DIVISION / PROCEDURE DIVISION state.
        # Used by the orphan-single-char detector below to scope the
        # comment-out fix to data sections only (Working-Storage,
        # File, Linkage, Local-Storage), where orphan single chars
        # break parsing.  In Procedure Division, orphan single chars
        # (e.g. COCRDLIC.cbl line 790 has a stray "I" that GnuCOBOL
        # tolerates as an unused identifier inside an IF/ELSE branch)
        # must NOT be touched -- otherwise we break already-passing
        # tests.  Use uppercased copy for case-insensitive matching.
        upper_div = toupper(line)
        if (upper_div ~ /^[[:space:]]+(WORKING-STORAGE|FILE|LINKAGE|LOCAL-STORAGE)[[:space:]]+SECTION\./) {
            in_data_division = 1
        }
        else if (upper_div ~ /^[[:space:]]+PROCEDURE[[:space:]]+DIVISION/) {
            in_data_division = 0
        }
        # Step 3 -- escape unescaped embedded quotes in MOCK CALL
        # VALUE literals (cobol-check 0.2.16 bug).
        # Token shape:  VALUE "CALL "<ID>""
        # Target shape: VALUE '\''CALL "<ID>"'\''
        # (outer delimiter switched from double to single; total length
        # is identical because two outer doubles become two outer singles)
        if (match(line, /VALUE "CALL "[A-Z0-9_-]+""/)) {
            tok = substr(line, RSTART, RLENGTH)
            # Position 7 in tok (1-based) is the leading double-quote.
            # The last char of tok is the trailing double-quote that
            # closes the outer literal.  The penultimate char is the
            # double-quote that closes the inner identifier.
            tlen = length(tok)
            new_tok = substr(tok, 1, 6) "\x27" substr(tok, 8, tlen - 8) "\x27"
            # Verification: substr(tok,1,6)="VALUE "; substr(tok,8,n-8)
            # is everything between the leading and trailing outer
            # quotes (i.e. CALL "<ID>" with the id-closing double-quote
            # preserved); we then append a closing single-quote.
            line = substr(line, 1, RSTART - 1) new_tok substr(line, RSTART + RLENGTH)
        }
        # Detect "<something>    <digits><trailing-ws>" where the
        # interior whitespace is 4+ spaces.  Replace the digits with
        # the same number of spaces so column positions of preceding
        # tokens are preserved.
        if (match(line, /[[:space:]]{4,}[0-9]+[[:space:]]*$/)) {
            head = substr(line, 1, RSTART - 1)
            tail = substr(line, RSTART)
            # Build a replacement that is the same length as `tail`
            # but contains only spaces (one space per char).
            n = length(tail)
            spaces = ""
            for (i = 0; i < n; i++) spaces = spaces " "
            line = head spaces
        }
        # Step 4 -- repair orphan clauses left by incomplete
        # READ/WRITE/REWRITE/DELETE stripping in cobol-check 0.2.16.
        # Detect lines whose first non-whitespace token (after col 6)
        # is one of the orphan tokens.  Use uppercased copy for
        # case-insensitive matching.  Skip lines that are already
        # comments (col 7 is "*" or "/").
        upper = toupper(line)
        is_comment_line = (length(line) >= 7 \
            && (substr(line, 7, 1) == "*" \
             || substr(line, 7, 1) == "/"))
        if (!is_comment_line) {
            # Case 1: orphan clause-opener WITHOUT a terminating
            # period (NOT INVALID KEY, INVALID KEY).  Comment out.
            if (upper ~ /^[[:space:]]+NOT[[:space:]]+INVALID[[:space:]]+KEY([[:space:]]|$)/ \
             || upper ~ /^[[:space:]]+INVALID[[:space:]]+KEY([[:space:]]|$)/) {
                if (length(line) > 6) {
                    line = substr(line, 1, 6) "*" substr(line, 8)
                } else {
                    line = substr(line, 1, 6) "*"
                }
            }
            # Case 2: orphan terminator (END-READ, END-WRITE, etc.)
            # WITH a trailing period.  Replace keyword with CONTINUE
            # in-place, preserving the period and total line length.
            # Detect by combining: line begins with whitespace then
            # END-<verb>, AND the line contains a period after the
            # keyword.  Use POSIX-portable awk match() (no array).
            else if (upper ~ /^[[:space:]]+END-READ\.[[:space:]]*$/ \
                  || upper ~ /^[[:space:]]+END-WRITE\.[[:space:]]*$/ \
                  || upper ~ /^[[:space:]]+END-REWRITE\.[[:space:]]*$/ \
                  || upper ~ /^[[:space:]]+END-DELETE\.[[:space:]]*$/ \
                  || upper ~ /^[[:space:]]+END-START\.[[:space:]]*$/) {
                # Locate the END- keyword position and length.
                kw_re = "(END-READ|END-WRITE|END-REWRITE|END-DELETE|END-START)"
                if (match(upper, kw_re)) {
                    kw_start = RSTART
                    kw_len = RLENGTH
                    pad_len = kw_len - 8  # CONTINUE is 8 chars
                    pad = ""
                    for (k = 0; k < pad_len; k++) pad = pad " "
                    line = substr(line, 1, kw_start - 1) "CONTINUE" pad substr(line, kw_start + kw_len)
                }
            }
            # Case 3: orphan terminator WITHOUT a trailing period
            # (rare; mid-sentence END-READ).  Comment out.
            else if (upper ~ /^[[:space:]]+END-READ([[:space:]]|$)/ \
                  || upper ~ /^[[:space:]]+END-WRITE([[:space:]]|$)/ \
                  || upper ~ /^[[:space:]]+END-REWRITE([[:space:]]|$)/ \
                  || upper ~ /^[[:space:]]+END-DELETE([[:space:]]|$)/ \
                  || upper ~ /^[[:space:]]+END-START([[:space:]]|$)/) {
                if (length(line) > 6) {
                    line = substr(line, 1, 6) "*" substr(line, 8)
                } else {
                    line = substr(line, 1, 6) "*"
                }
            }
            # Case 4: orphan single-character lines from the
            # cobol-check 0.2.16 column 73-80 wrapping bug.  When
            # production source has annotation chars in cols 73-80
            # (e.g., the DB2-FORMAT-TS REDEFINES block in CBTRN02C
            # and CBACT04C has trailing "E", "-", "M", "D", "U" hint
            # characters indicating the EEEE-MM-DD-UU.MM.SS format),
            # cobol-check wraps each char to a new line at col 16.
            # Inside DATA DIVISION (WORKING-STORAGE / FILE / LINKAGE
            # / LOCAL-STORAGE), the wrapped char is parsed as a data
            # declaration and triggers cascading "PROCEDURE DIVISION
            # header missing" / "unknown statement" errors.  In
            # PROCEDURE DIVISION, GnuCOBOL tolerates the orphan
            # (e.g. COCRDLIC.cbl has a legitimate stray "I" inside an
            # IF/ELSE branch that already-passing tests rely on), so
            # only comment the line when in_data_division == 1.
            #
            # Detection: line begins with whitespace, contains
            # exactly one alphanumeric or hyphen character, then
            # ends with whitespace.  This pattern never matches
            # legitimate COBOL data syntax (level numbers are 2-digit
            # 01-49, 66, 77, 88; all data-name identifiers are
            # multi-char).
            else if (in_data_division == 1 \
                  && line ~ /^[[:space:]]+[A-Za-z0-9-][[:space:]]*$/) {
                if (length(line) > 6) {
                    line = substr(line, 1, 6) "*" substr(line, 8)
                } else {
                    line = substr(line, 1, 6) "*"
                }
            }
        }
        print line
        if (ws_section_line == 1) {
            # Emit the COPY directive immediately after WORKING-
            # STORAGE SECTION.  Uses Area B starting at column 8
            # (7 leading spaces) so GnuCOBOL fixed-format parser
            # accepts it as a 01-level COPY directive.  STUB-
            # ABEND-FLAG.cpy declares 01 STUB-ABEND-STATE EXTERNAL
            # which is shared with the linked CEE3ABD / DFHEI1
            # stubs, exposing WS-ABEND-FLAG / WS-DFHEI1-UNMOCKED-
            # CALLED / WS-DFHEI1-EIBRESP-OVERRIDE for testsuite
            # EXPECT/VERIFY assertions.
            printf "       COPY STUB-ABEND-FLAG.\n"
            stub_abend_injected = 1
        }
    }
' "${merged_src}" > "${sanitised_src}"

# ---------------------------------------------------------------------
# Pre-compile each LE / CICS shim once per directory.  Using -m makes
# them dynamically loadable so cobc/cobcrun can find them via
# COB_LIBRARY_PATH at run time.  We pass -save-temps when the caller
# requested coverage instrumentation so the corresponding .c / .gcno
# files end up here named after the stub.
# ---------------------------------------------------------------------
case " ${COBC_OPTS:-} " in
    *fprofile-arcs*) save_temps_opt="-save-temps" ;;
    *)               save_temps_opt= ;;
esac

for stub in CEEDAYS CEE3ABD DFHEI1; do
    if [ -f "${repo_root}/tests/stubs/${stub}.cbl" ] \
       && [ ! -f "${merged_dir}/${stub}.so" ]; then
        cobc -m -fixed ${COBC_OPTS:-} ${save_temps_opt} \
            -I "${repo_root}/app/cpy" \
            -I "${repo_root}/app/cpy-bms" \
            -I "${repo_root}/tests/fixtures/cobol-snippets" \
            -I "${repo_root}/tests/stubs" \
            "${repo_root}/tests/stubs/${stub}.cbl" 2>&1 || true
    fi
done

# ---------------------------------------------------------------------
# Decide between executable mode (cobc -xj) and module mode (cobc -m
# + cobcrun).  Module mode is significantly faster on cobc 3.1.2 for
# large merged sources because the executable mode triggers a super-
# linear codegen pass that exceeds reasonable wall-clock limits when
# the merged source exceeds ~6500 lines (observed empirically with
# COACTUPC after expansion to 41+ testcases).
#
# The threshold (6000 lines) is conservative -- batch and small CICS
# programs stay well under it, so the existing `cobc -xj` path is
# preserved for them.  For large programs (e.g., COACTUPC), we skip
# the executable path and go directly to module mode.  This is the
# same compile path that the USING-clause fallback uses, just chosen
# proactively instead of reactively.
# ---------------------------------------------------------------------
merged_lines=$(wc -l < "${sanitised_src}" 2>/dev/null || echo 0)
LARGE_MERGE_THRESHOLD=${LARGE_MERGE_THRESHOLD:-6000}

if [ "${merged_lines}" -gt "${LARGE_MERGE_THRESHOLD}" ]; then
    echo "[runner] Merged source ${merged_lines} lines > ${LARGE_MERGE_THRESHOLD}; using module mode (cobc -m + cobcrun)."

    cobc -m -fixed ${COBC_OPTS:-} ${save_temps_opt} \
        -I "${repo_root}/app/cpy" \
        -I "${repo_root}/app/cpy-bms" \
        -I "${repo_root}/tests/fixtures/cobol-snippets" \
        -I "${repo_root}/tests/stubs" \
        -o "${merged_dir}/${program_id}.so" \
        "${sanitised_src}" || exit $?

    COB_LIBRARY_PATH="${merged_dir}:${repo_root}/tests/stubs:${COB_LIBRARY_PATH:-}" \
        cobcrun "${program_id}"
    exit $?
fi

# ---------------------------------------------------------------------
# Step 2 - try the standard compile-and-run path used for batch
# programs.  Capture stderr so we can fall back to the subprogram
# path if cobc rejects the merged program because of a USING clause.
# Use the sanitised filename so coverage output is named cleanly.
# ---------------------------------------------------------------------
COB_LIBRARY_PATH="${merged_dir}:${repo_root}/tests/stubs:${COB_LIBRARY_PATH:-}" \
    cobc -xj -fixed ${COBC_OPTS:-} ${save_temps_opt} \
        -o "${merged_dir}/${program_id}" \
        -I "${repo_root}/app/cpy" \
        -I "${repo_root}/app/cpy-bms" \
        -I "${repo_root}/tests/fixtures/cobol-snippets" \
        -I "${repo_root}/tests/stubs" \
        "${sanitised_src}" "$@" 2>"${merged_dir}/${program_id}.cobc.stderr"
rc=$?

if [ "$rc" -eq 0 ]; then
    cat "${merged_dir}/${program_id}.cobc.stderr"
    rm -f "${merged_dir}/${program_id}.cobc.stderr"
    exit 0
fi

# Always echo whatever cobc printed so reviewers can debug.
cat "${merged_dir}/${program_id}.cobc.stderr"

# ---------------------------------------------------------------------
# Step 3 - fallback for subprograms with PROCEDURE DIVISION USING.
# Build the merged program as a dynamically loadable module and
# invoke it via cobcrun.  cobol-check's injected test driver runs
# first (PERFORM UT-INITIALIZE), so the USING parameters arrive as
# the COBOL runtime's default: NULL pointers / spaces, which is fine
# because the test author is expected to MOVE values into LINKAGE
# fields inside BEFORE-EACH.
# ---------------------------------------------------------------------
if grep -q "executable program requested but PROCEDURE/ENTRY has USING clause" \
        "${merged_dir}/${program_id}.cobc.stderr" 2>/dev/null; then
    rm -f "${merged_dir}/${program_id}.cobc.stderr"
    echo "[runner] PROCEDURE DIVISION USING detected; switching to module mode."

    cobc -m -fixed ${COBC_OPTS:-} ${save_temps_opt} \
        -I "${repo_root}/app/cpy" \
        -I "${repo_root}/app/cpy-bms" \
        -I "${repo_root}/tests/fixtures/cobol-snippets" \
        -I "${repo_root}/tests/stubs" \
        -o "${merged_dir}/${program_id}.so" \
        "${sanitised_src}" || exit $?

    COB_LIBRARY_PATH="${merged_dir}:${repo_root}/tests/stubs:${COB_LIBRARY_PATH:-}" \
        cobcrun "${program_id}"
    exit $?
fi

rm -f "${merged_dir}/${program_id}.cobc.stderr"
exit "$rc"
