# =============================================================================
# CardDemo Backend - environment variable template
# =============================================================================
# Ochs Rule #3 ("no hardcoding secrets -> use environment variables"): every
# configurable value below is read from the environment, never hardcoded.
#
# Usage:
#   cp backend/.env.example backend/.env      # then edit backend/.env
#
# backend/.env is gitignored (see the root .gitignore) and MUST NEVER be
# committed. This .env.example template IS tracked and is the AUTHORITATIVE
# list of variable names read by app/core/config.py (pydantic-settings
# BaseSettings) and supplied by the root docker-compose.yml backend service.
# Keep these names stable.
#
# Format: dotenv KEY=value (no spaces around '='; quote values that contain
# spaces). All values below are non-production example/dev defaults.
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
# FastAPI application title, shown in the OpenAPI / Swagger docs.
PROJECT_NAME=CardDemo
# URL prefix that all version-1 routers (app/api/v1/*) are mounted under.
API_V1_PREFIX=/api/v1
# Deployment environment name: development | staging | production.
ENVIRONMENT=development
# Debug flag: enables verbose application-level logging only. It NEVER changes
# the HTTP error surface -- unhandled errors are always sanitized to a generic
# 500 (see app/main.py create_application), so a traceback, SQL statement, or
# bound parameter is never returned to a client regardless of this flag.
# Secure-by-default: leave false; set true only for local log verbosity.
DEBUG=false

# API documentation exposure: gates the interactive docs (/docs, /redoc) and
# the raw OpenAPI schema (/openapi.json). Leave UNSET to derive from ENVIRONMENT
# -- served for a local profile (development/test), 404 in staging/production to
# reduce API-surface disclosure (QA finding #10). Set an explicit true/false
# only to override that derivation (e.g. expose docs in a locked-down
# environment, or suppress them locally). Unset by default:
# ENABLE_API_DOCS=

# --- Database (PostgreSQL 17; VSAM replacement) ------------------------------
# Two URLs point at the same host/port/database but use different drivers:
#   * DATABASE_URL      - async driver (asyncpg), used by the app runtime
#                         engine in app/db/session.py.
#   * SYNC_DATABASE_URL - sync driver (psycopg2), used by Alembic migrations
#                         and the batch CLI / loaders (batch/*).
# NOTE: under docker-compose the database host is the service name `db`
# (e.g. ...@db:5432/carddemo), NOT `localhost`. Use `localhost` only when
# running the backend directly on the host against a locally exposed DB.
#
# BATCH NOTE: the batch package (batch/cli.py and the loaders) has its OWN
# settings model (batch/config.py) that reads THIS file by absolute path, so
# `python -m batch.cli` works from the repository root. Batch consumes ONLY
# `SYNC_DATABASE_URL` from here; it does NOT require `SECRET_KEY` or any other
# backend-only variable below (QA finding #60). The one exception is the
# user-seed loader (`load init-users`), which reuses the backend password
# hashing and therefore loads the backend security module when it actually
# hashes rows.
DATABASE_URL=postgresql+asyncpg://carddemo:carddemo@localhost:5432/carddemo
SYNC_DATABASE_URL=postgresql+psycopg2://carddemo:carddemo@localhost:5432/carddemo
# Optional convenience parts - only needed if config.py composes the URLs from
# individual pieces. Keep them consistent with the two URLs above; these also
# match the root docker-compose.yml `db` service defaults.
POSTGRES_USER=carddemo
POSTGRES_PASSWORD=carddemo
POSTGRES_DB=carddemo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Database / readiness timeouts (QA finding #7) ---------------------------
# Bounded, tunable timeouts (in seconds) that keep the async engine and the
# /health/ready probe from blocking indefinitely against a slow or frozen
# PostgreSQL ("grey failure"). Each must be strictly positive (>= 0.1) or the
# app fails fast at startup. Defaults below are safe production baselines; they
# are read by app/db/session.py (asyncpg connect/command timeouts) and
# app/main.py (readiness wall-clock bound).
#   * DB_CONNECT_TIMEOUT_SECONDS  - bounds asyncpg connection establishment.
#   * DB_COMMAND_TIMEOUT_SECONDS  - bounds every asyncpg statement (generous so
#                                   a legitimately slow query is not severed).
#   * HEALTH_READY_TIMEOUT_SECONDS- wall-clock bound the /health/ready handler
#                                   applies so it returns a prompt 503 under a
#                                   frozen DB instead of hanging.
DB_CONNECT_TIMEOUT_SECONDS=10.0
DB_COMMAND_TIMEOUT_SECONDS=30.0
HEALTH_READY_TIMEOUT_SECONDS=5.0

# --- Security / authentication (Ochs Rule #3) --------------------------------
# These variables are BACKEND-ONLY: they are read by app/core/config.py and are
# NOT required to run the batch CLI or loaders (batch/config.py ignores them).
# The single signing key for BOTH auth modes: it signs the session cookie under
# the `session` baseline and the bearer token under `jwt` (app/core/security.py
# uses SECRET_KEY for both -- there is intentionally no separate session key).
# PLACEHOLDER ONLY - never commit a real key; the app refuses to start unless
# this is set to a strong value of at least 32 characters.
# Generate a strong value with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_dev_only_generate_with_openssl_rand_hex_32
# Authentication mode: `session` is the confirmed baseline (AAP 0.8.4);
# `jwt` is an accepted equivalent alternative.
AUTH_MODE=session
# JWT signing algorithm (used when AUTH_MODE=jwt).
ALGORITHM=HS256
# Access token / session lifetime, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Name of the session cookie (used with the session baseline).
SESSION_COOKIE_NAME=carddemo_session

# --- Login throttling (QA finding M-01) --------------------------------------
# Brute-force protection for POST /auth/login (app/core/rate_limiter.py). After
# LOGIN_MAX_ATTEMPTS consecutive failed sign-ons for the same (user id, client
# IP) pair, further attempts are rejected with HTTP 429 for
# LOGIN_LOCKOUT_SECONDS; the window then resets, and any successful sign-on
# clears the counter immediately. LOGIN_MAX_ATTEMPTS must be >= 1 and
# LOGIN_LOCKOUT_SECONDS >= 1 (an out-of-range value fails fast at startup).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Password hashing (Ochs Rule #3; AAP 0.7.7 plaintext -> hash) ------------
# bcrypt cost factor used to hash the legacy plaintext SEC-USR-PWD into
# password_hash. Higher values are more expensive/secure; 12 is a reasonable
# default. (If argon2 is chosen in core/security.py, supply the equivalent
# argon2 parameters instead - bcrypt is the documented baseline.)
BCRYPT_ROUNDS=12

# --- CORS --------------------------------------------------------------------
# Comma-separated list of browser origins allowed by the FastAPI CORS
# middleware. The Next.js frontend runs on port 3000.
BACKEND_CORS_ORIGINS=http://localhost:3000
