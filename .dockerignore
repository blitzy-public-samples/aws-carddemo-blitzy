# ============================================================================
*.egg
*.egg-info
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.manifest
*.spec
MANIFEST
htmlcov/
.tox/
.nox/
.hypothesis/
.pybuilder/
target/

