# Paths a build excludes from the card-platform root context. Each
# services/*/Dockerfile builds from its own module directory, and a module
# context carries no ignore file, so this file governs a root-context build.

# Build output. A root-context build reads no archive. Each service image copies
# its own archive from its module context, where this file does not apply.
**/target/

# Local environment values. .env.example travels with the repository; the .env a
# developer copies from it carries their own credentials.
.env
.env.*
!.env.example

# Documentation, the executive presentation and the Kubernetes manifests. No
# stage of any image build reads them.
docs/
presentation/
deploy/

# A Maven repository checked into a context belongs in no image. No image build
# resolves a dependency.
.m2/

# Editor and operating-system artifacts.
**/*.swp
**/*~
**/.DS_Store
